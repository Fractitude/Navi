@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

@* The secure layer: Navi's permission prompts, like Windows' secure desktop. NaviDesktop creates it on its own panel, *@
@* in front of the screen, so it draws above everything and gets clicks first. While a prompt is open it covers the *@
@* whole screen, so apps can't be clicked. Apps can't reach it through their panel's ancestors, and every control *@
@* in it only reacts to a real mouse press made after the prompt has been up for a moment. See the Security section *@
@* of AGENTS.md for what this does and doesn't protect against. The lock screen is here for the same reason: it *@
@* covers the whole screen. Without a password only a real press from the player who locked it unlocks it. With one, *@
@* the password or pattern is typed or drawn here (NaviLockEntry), made into a proof on this client and only that is sent: *@
@* see NaviLockCrypto. The dialog that sets or changes the lock is here for the same reason, so no app sees either. *@

<root class="@(Locked ? "active locked" : Request is null && setup == SetupStep.None ? "" : "active") @(Computer?.ThemeClasses)"
	@onmousedown=@(( PanelEvent e ) => PressSit( e ))
	@onclick=@(( PanelEvent e ) => ReleaseSit( e ))>
	@if ( Locked )
	{
		var now = System.DateTime.Now;
		var credential = Computer.HasLockCredential;

		<div class="lock-screen @(credential ? "entering" : Armed && Computer.IsLockOwner ? "" : "arming")"
			@onmousedown=@(( PanelEvent e ) => Press( e ))
			@onclick=@(( PanelEvent e ) => Release( e, () => Unlock() ))>
			<div class="time">@now.ToString( "HH:mm" )</div>
			<div class="date">@now.ToString( "dddd, d MMMM" )</div>

			<div class="status">
				<i>lock</i>
				@if ( credential )
				{
					@(Computer.IsSeated ? "Locked" : "Locked. Click to sit down.")
				}
				else if ( !Computer.IsLockOwner )
				{
					@($"Locked by {Computer.Locker?.DisplayName ?? "another player"}")
				}
				else if ( !Computer.IsSeated )
				{
					@("Locked. Click to sit down.")
				}
				else
				{
					@("Locked. Click to unlock.")
				}
			</div>

			@* Only the player at the screen gets the entry. Everyone else sees that it is locked, and nothing of what is entered:
			   it isn't sent to anyone, see NaviLockEntry. *@
			@if ( credential && Computer.IsSeated )
			{
				<NaviLockEntry @ref="UnlockEntry" class="unlock-entry" Kind=@Computer.LockKind Enabled=@(Armed && !Computer.IsLockedOut)
					Message=@UnlockMessage OnSubmit=@SubmitUnlock></NaviLockEntry>
			}
		</div>
	}
	else if ( setup != SetupStep.None )
	{
		<div class="dialog @(Armed ? "" : "arming")">
			<div class="dialog-title">
				<div class="heading">Lock screen</div>
				<i class="lock" tooltip="Navi is asking this, not an app">lock</i>
			</div>

			@switch ( setup )
			{
				case SetupStep.Current:
					<div class="dialog-text">Enter the current @KindName( Computer.LockKind ) to change the lock.</div>
					<NaviLockEntry @ref="SetupEntry" Kind=@Computer.LockKind Enabled=@(Armed && !Computer.IsLockedOut)
						Message=@SetupMessage OnSubmit=@SubmitCurrent></NaviLockEntry>
					break;

				case SetupStep.Choose:
					<div class="dialog-text">What should unlock the screen? It is checked on this computer's host without ever being sent: only a hash of it is.</div>

					<div class="permission ticked"
						@onmousedown=@(( PanelEvent e ) => Press( e ))
						@onclick=@(( PanelEvent e ) => Release( e, () => ChooseKind( NaviLockKind.Password ) ))>
						<i class="glyph">password</i>
						<div class="perm-text">
							<div class="perm-title">Password or PIN</div>
							<div class="perm-description">@NaviLockCrypto.MinPasswordLength to @NaviLockCrypto.MaxPasswordLength letters and digits. Digits only is a PIN.</div>
						</div>
					</div>

					<div class="permission ticked"
						@onmousedown=@(( PanelEvent e ) => Press( e ))
						@onclick=@(( PanelEvent e ) => Release( e, () => ChooseKind( NaviLockKind.Pattern ) ))>
						<i class="glyph">pattern</i>
						<div class="perm-text">
							<div class="perm-title">Pattern</div>
							<div class="perm-description">Drag the mouse across at least @NaviLockCrypto.MinPatternNodes dots.</div>
						</div>
					</div>

					@if ( Computer.HasLockCredential )
					{
						<div class="permission ticked"
							@onmousedown=@(( PanelEvent e ) => Press( e ))
							@onclick=@(( PanelEvent e ) => Release( e, () => RemoveLock() ))>
							<i class="glyph">lock_open</i>
							<div class="perm-text">
								<div class="perm-title">No password</div>
								<div class="perm-description">Only the player who locked the screen can unlock it, with a click.</div>
							</div>
						</div>
					}
					break;

				case SetupStep.New:
					<div class="dialog-text">Choose a @KindName( newKind ).</div>
					<NaviLockEntry @ref="SetupEntry" Kind=@newKind Enabled=@Armed Message=@SetupMessage OnSubmit=@SubmitNew></NaviLockEntry>
					break;

				case SetupStep.Confirm:
					<div class="dialog-text">Enter the @KindName( newKind ) again to confirm it.</div>
					<NaviLockEntry @ref="SetupEntry" Kind=@newKind Enabled=@Armed Message=@SetupMessage OnSubmit=@SubmitConfirm></NaviLockEntry>
					break;

				case SetupStep.Saving:
					<div class="dialog-text">@SavingStatus</div>
					break;
			}

			<div class="dialog-buttons">
				@if ( setup is SetupStep.New or SetupStep.Confirm )
				{
					<div class="button"
						@onmousedown=@(( PanelEvent e ) => Press( e ))
						@onclick=@(( PanelEvent e ) => Release( e, () => BackToChoose() ))>
						Back
					</div>
				}

				<div class="button @(saveDone ? "primary" : "")"
					@onmousedown=@(( PanelEvent e ) => Press( e ))
					@onclick=@(( PanelEvent e ) => Release( e, () => EndSetup() ))>
					@(saveDone ? "Done" : "Cancel")
				</div>
			</div>
		</div>
	}
	else if ( Request is { } request )
	{
		var heading = request.IsRoot
			? (request.Launch ? $"{request.App.Name} wants full system access" : $"Install {request.App.Name} with full system access?")
			: request.IsReview
				? (request.Launch ? $"Open {request.App.Name} with permissions" : $"{request.App.Name}'s permissions")
				: $"{request.App.Name} asks for permissions";

		<div class="dialog @(Armed ? "" : "arming")">
			<div class="dialog-title">
				<div class="icon" style="background-color: @request.App.Color;"><i>@request.App.Icon</i></div>
				<div class="heading">@heading</div>
				<i class="lock" tooltip="Navi is asking this, not an app">lock</i>
			</div>

			@if ( request.IsRoot )
			{
				<div class="root-warning">
					<i>shield</i>
					<div class="perm-text">
						<div class="perm-title">This is a system app</div>
						<div class="perm-description">With root access it can do anything on this computer: install and remove apps, close other apps, and everything else apps can be allowed. Only accept if you trust who made it.</div>
					</div>
				</div>
			}
			else
			{
				<div class="dialog-text">Tick what @request.App.Name may do. It keeps them, and you can change them from its taskbar menu.</div>
			}

			@foreach ( var permission in request.Permissions )
			{
				var info = NaviPermissions.Describe( permission );
				var ticked = !Unticked.Contains( permission );

				<div class="permission @(ticked ? "ticked" : "")"
					@onmousedown=@(( PanelEvent e ) => Press( e ))
					@onclick=@(( PanelEvent e ) => Release( e, () => TogglePermission( permission ) ))>
					<i class="check">@(ticked ? "check_box" : "check_box_outline_blank")</i>
					<i class="glyph">@info.Icon</i>
					<div class="perm-text">
						<div class="perm-title">@info.Title</div>
						<div class="perm-description">@info.Description</div>
					</div>
				</div>
			}

			@if ( !Computer.CanUse )
			{
				<div class="dialog-text">Only @( Computer.User?.DisplayName ?? "the player using this computer" ) can answer this.</div>
			}
			else if ( !Computer.IsSeated )
			{
				<div class="dialog-text">Click to sit down at the computer, then answer this.</div>
			}

			<div class="dialog-buttons">
				<div class="button"
					@onmousedown=@(( PanelEvent e ) => Press( e ))
					@onclick=@(( PanelEvent e ) => Release( e, () => Computer.UserDismissPermissionRequest( request.Id ) ))>
					@(request.IsReview || request.IsRoot ? "Cancel" : "Deny all")
				</div>
				<div class="button primary"
					@onmousedown=@(( PanelEvent e ) => Press( e ))
					@onclick=@(( PanelEvent e ) => Release( e, () => Computer.UserAnswerPermissionRequest( request.Id, request.Permissions.Except( Unticked ).ToArray() ) ))>
					@(request.IsRoot ? (request.Launch ? "Allow and open" : "Install") : request.IsReview ? (request.Launch ? "Open" : "Save") : "Allow ticked")
				</div>
			</div>
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The computer whose prompts this shows. Set by <see cref="NaviDesktop"/>, which creates this layer.
	/// </summary>
	public NaviComputer Computer { get; set; }

	/// <summary>
	/// Seconds a prompt is shown before its controls react, so a click meant for something else can't land on it.
	/// </summary>
	[Property] public float ArmTime { get; set; } = 0.75f;

	NaviPermissionRequest Request => Computer.IsValid() ? Computer.PermissionRequests.FirstOrDefault() : null;

	/// <summary>
	/// The screen is locked (<see cref="NaviComputer.IsLocked"/>). The lock screen shows instead of any prompt, which waits.
	/// </summary>
	bool Locked => Computer.IsValid() && Computer.IsLocked;

	void Unlock()
	{
		if ( !Computer.HasLockCredential && Computer.IsLockOwner )
			Computer.UserUnlock();
	}

	enum SetupStep { None, Current, Choose, New, Confirm, Saving }

	// Setting the lock: the steps, and what has been entered. Secrets only live here, on this client, until they are made
	// into proofs and sent; the password and the pattern themselves are never sent.
	SetupStep setup;
	NaviLockKind newKind;
	string currentProof = "";
	string newSecret;
	string pendingSalt;
	int pendingKind;
	int failedBefore;
	bool saveDone;
	string SetupMessage;
	string SavingStatus;
	RealTimeSince sinceSent;

	// Unlocking: a proof was sent and the host hasn't answered yet.
	bool unlockPending;
	int unlockFailedBefore;
	string unlockMessage;
	RealTimeSince sinceUnlockSent;

	NaviLockEntry UnlockEntry;
	NaviLockEntry SetupEntry;

	string UnlockMessage => Computer.IsLockedOut ? $"Too many tries. Wait {WaitSeconds}s." : unlockMessage;

	int WaitSeconds => (int)System.Math.Ceiling( (Computer.RetryAt - System.DateTime.UtcNow).TotalSeconds );

	static string KindName( NaviLockKind kind ) => kind == NaviLockKind.Pattern ? "pattern" : "password";

	void BeginSetup()
	{
		setup = Computer.HasLockCredential ? SetupStep.Current : SetupStep.Choose;
		ClearSetup();
		sinceShown = 0;
	}

	void EndSetup()
	{
		setup = SetupStep.None;
		Computer.LockSetupRequested = false;
		ClearSetup();
	}

	void ClearSetup()
	{
		currentProof = "";
		newSecret = null;
		pendingSalt = null;
		SetupMessage = null;
		saveDone = false;
	}

	void BackToChoose()
	{
		newSecret = null;
		SetupMessage = null;
		setup = SetupStep.Choose;
	}

	/// <summary>
	/// The player entered the password or pattern for the lock screen. Only its proof goes to the host.
	/// </summary>
	void SubmitUnlock( string secret )
	{
		if ( !Armed || !Computer.HasLockCredential || !NaviLockCrypto.IsAcceptable( Computer.LockKind, secret ) )
			return;

		unlockFailedBefore = Computer.FailedAttempts;
		unlockPending = true;
		unlockMessage = null;
		sinceUnlockSent = 0;
		Computer.UserUnlockWith( NaviLockCrypto.Proof( Computer.LockKind, secret, Computer.LockSalt ) );
	}

	/// <summary>
	/// The current password or pattern, before changing the lock. The host is the one that finds out if it is right, when it
	/// is sent along with the new one.
	/// </summary>
	void SubmitCurrent( string secret )
	{
		if ( !Armed || !NaviLockCrypto.IsAcceptable( Computer.LockKind, secret ) )
			return;

		currentProof = NaviLockCrypto.Proof( Computer.LockKind, secret, Computer.LockSalt );
		SetupMessage = null;
		setup = SetupStep.Choose;
	}

	void ChooseKind( NaviLockKind kind )
	{
		newKind = kind;
		SetupMessage = null;
		setup = SetupStep.New;
	}

	void SubmitNew( string secret )
	{
		if ( !Armed )
			return;

		newSecret = secret;
		SetupMessage = null;
		setup = SetupStep.Confirm;
	}

	void SubmitConfirm( string secret )
	{
		if ( !Armed )
			return;

		if ( secret != newSecret )
		{
			newSecret = null;
			SetupMessage = $"Those didn't match. Choose the {KindName( newKind )} again.";
			setup = SetupStep.New;
			return;
		}

		var salt = NaviLockCrypto.NewSalt();
		SendLock( (int)newKind, salt, NaviLockCrypto.Proof( newKind, secret, salt ), "Saving the lock..." );
	}

	void RemoveLock()
	{
		SendLock( (int)NaviLockKind.None, "", "", "Removing the lock..." );
	}

	void SendLock( int kind, string salt, string proof, string status )
	{
		pendingKind = kind;
		pendingSalt = salt;
		failedBefore = Computer.FailedAttempts;
		SavingStatus = status;
		saveDone = false;
		sinceSent = 0;
		setup = SetupStep.Saving;

		Computer.UserSetLock( currentProof, kind, salt, proof );
		newSecret = null;
	}

	/// <summary>
	/// Follow the lock: open or close the setup dialog, keep the player's keys from any app while a secret is typed, and
	/// see what the host made of what was sent.
	/// </summary>
	void UpdateLock()
	{
		var seated = Computer.IsSeated;
		var wanted = Computer.LockSetupRequested && seated && !Locked;

		if ( Computer.LockSetupRequested && !wanted )
			EndSetup();
		else if ( wanted && setup == SetupStep.None )
			BeginSetup();

		// The player standing up, or the screen locking, drops a half-made lock.
		if ( setup != SetupStep.None && !wanted )
			EndSetup();

		Computer.SecureEntryActive = seated && ((Locked && Computer.HasLockCredential) || setup != SetupStep.None);

		if ( unlockPending )
		{
			if ( !Locked )
			{
				unlockPending = false;
				unlockMessage = null;
			}
			else if ( Computer.FailedAttempts > unlockFailedBefore )
			{
				unlockPending = false;
				unlockMessage = $"Wrong {KindName( Computer.LockKind )}.";
			}
			else if ( sinceUnlockSent > 3f )
			{
				unlockPending = false;
				unlockMessage = "The computer didn't answer.";
			}
		}

		if ( setup == SetupStep.Saving && !saveDone )
		{
			if ( pendingKind == (int)NaviLockKind.None ? !Computer.HasLockCredential : Computer.LockSalt == pendingSalt )
			{
				saveDone = true;
				SavingStatus = pendingKind == (int)NaviLockKind.None ? "The lock is removed." : "The lock is set. It guards the screen from now on.";
			}
			else if ( Computer.FailedAttempts > failedBefore )
			{
				SetupMessage = $"That wasn't the current {KindName( Computer.LockKind )}.";
				currentProof = "";
				setup = SetupStep.Current;
			}
			else if ( sinceSent > 3f )
			{
				saveDone = true;
				SavingStatus = "The computer didn't change the lock.";
			}
		}
	}

	protected override void OnDisabled()
	{
		base.OnDisabled();

		if ( Computer.IsValid() )
			Computer.SecureEntryActive = false;
	}

	/// <summary>
	/// The controls react: the prompt has been up for <see cref="ArmTime"/> since the local player sat at the computer.
	/// Everyone else at the screen sees the prompt but can't answer it.
	/// </summary>
	bool Armed => sinceShown > ArmTime && Computer.IsValid() && Computer.IsSeated;

	NaviPermissionRequest shownRequest;
	bool shownSeated;
	RealTimeSince sinceShown;

	// A real press started on the layer while the player wasn't seated. Letting go sits them down.
	bool sitPressed;

	// Permissions unticked in the prompt. Reset for each new request, from what it starts with ticked.
	readonly HashSet<string> Unticked = new();

	// The control a real mouse press started on. A click only counts on the control it started on.
	Panel pressed;

	protected override void OnUpdate()
	{
		UpdateLock();

		var request = Request;
		var seated = Computer.IsValid() && Computer.IsSeated;

		// Sitting down arms the prompt afresh, so the click that sat the player can't answer it.
		if ( seated != shownSeated )
		{
			shownSeated = seated;
			sinceShown = 0;
			pressed = null;
		}

		if ( request == shownRequest )
			return;

		shownRequest = request;
		sinceShown = 0;
		pressed = null;
		Unticked.Clear();

		if ( request is not null )
			Unticked.UnionWith( request.Permissions.Except( request.Ticked ) );
	}

	/// <summary>
	/// A mouse press on a control. It only counts if the player is really holding the mouse button: apps can raise panel
	/// events, but can't fake the hardware state behind <see cref="Input.Keyboard"/>.
	/// </summary>
	void Press( PanelEvent e )
	{
		pressed = Armed && Input.Keyboard.Down( "MOUSE1" ) ? e.This : null;
	}

	/// <summary>
	/// A click on a control. Runs <paramref name="action"/> only if a real press started on this control, the prompt was
	/// armed, and the pointer is still over it.
	/// </summary>
	void Release( PanelEvent e, System.Action action )
	{
		var real = Armed && pressed is not null && pressed == e.This && e.This.HasHovered;
		pressed = null;

		if ( real )
			action();
	}

	/// <summary>
	/// A press anywhere on the open prompt, before the player sits. Only a real left press counts, as in <see cref="Press"/>.
	/// </summary>
	void PressSit( PanelEvent e )
	{
		sitPressed = (Request is not null || Locked) && Computer.IsValid() && !Computer.IsSeated && Computer.CanUse
			&& e is MousePanelEvent { MouseButton: MouseButtons.Left } && Input.Keyboard.Down( "MOUSE1" );
	}

	/// <summary>
	/// Letting go sits the player down, as a click on the desktop would. It doesn't answer the prompt.
	/// </summary>
	void ReleaseSit( PanelEvent e )
	{
		var real = sitPressed && Computer.IsValid() && !Computer.IsSeated && e.This.HasHovered;
		sitPressed = false;

		if ( real )
			Computer.UserSit();
	}

	void TogglePermission( string permission )
	{
		if ( !Unticked.Remove( permission ) )
			Unticked.Add( permission );
	}

	protected override int BuildHash() =>
		System.HashCode.Combine( (Request, Armed, Computer?.CanUse, Computer?.IsSeated), Unticked.Count, string.Join( ",", Unticked ),
			Computer?.ThemeClasses, (Locked, Computer?.LockOwner, System.DateTime.Now.Minute),
			(setup, newKind, SetupMessage, SavingStatus, saveDone), (UnlockMessage, Computer?.HasLockCredential, Computer?.LockKind) );
}
