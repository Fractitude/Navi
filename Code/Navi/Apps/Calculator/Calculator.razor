@using Sandbox.UI
@inherits NaviApp
@namespace Sandbox
@attribute [NaviApp( "calculator", "Calculator", Description = "Add, subtract, multiply and divide.", Icon = "calculate", Color = "#e0b060", CanMaximize = false, CanResize = false )]

<root>
	<div class="display">
		<div class="expression">@Expression</div>
		<div class="entry">@Entry</div>
	</div>

	<div class="keys">
		@foreach ( var row in Keys )
		{
			<div class="row">
				@foreach ( var label in row )
				{
					<div class="key @KeyClass( label )" @onclick=@(() => Press( label ))>@label</div>
				}
			</div>
		}
	</div>
</root>

@code
{
	static readonly string[][] Keys =
	{
		new[] { "C", "←" },
		new[] { "7", "8", "9", "÷" },
		new[] { "4", "5", "6", "×" },
		new[] { "1", "2", "3", "−" },
		new[] { "0", ".", "=", "+" },
	};

	const int MaxDigits = 12;

	/// <summary>
	/// The number being typed, or the last result.
	/// </summary>
	string Entry = "0";

	/// <summary>
	/// Left-hand side of the pending operation.
	/// </summary>
	double? Accumulator;

	string PendingOperator;

	/// <summary>
	/// True when the next digit starts a new number instead of extending <see cref="Entry"/>.
	/// </summary>
	bool StartNewEntry = true;

	bool HasError;

	string Expression => PendingOperator is null ? "" : $"{Format( Accumulator ?? 0 )} {PendingOperator}";

	static string KeyClass( string key ) => key switch
	{
		"C" or "←" => "function",
		"=" => "equals",
		"+" or "−" or "×" or "÷" => "operator",
		_ => "",
	};

	void Press( string key )
	{
		if ( HasError && key != "←" )
			Clear();

		switch ( key )
		{
			case "C": Clear(); break;
			case "←": Backspace(); break;
			case ".": Decimal(); break;
			case "=": Calculate(); break;
			case "+" or "−" or "×" or "÷": Operator( key ); break;
			default: Digit( key ); break;
		}

		StateHasChanged();
	}

	void Digit( string digit )
	{
		if ( StartNewEntry )
		{
			Entry = digit;
			StartNewEntry = false;
		}
		else if ( Entry.Count( char.IsDigit ) < MaxDigits )
		{
			Entry = Entry == "0" ? digit : Entry + digit;
		}
	}

	void Decimal()
	{
		if ( StartNewEntry )
		{
			Entry = "0.";
			StartNewEntry = false;
		}
		else if ( !Entry.Contains( '.' ) )
		{
			Entry += ".";
		}
	}

	void Backspace()
	{
		if ( StartNewEntry || HasError )
			return;

		Entry = Entry[..^1];
		if ( Entry is "" or "-" )
			Entry = "0";
	}

	void Operator( string op )
	{
		// Chained operations evaluate as they go: 2 + 3 × shows 5.
		// Pressing an operator right after another one just swaps it.
		if ( PendingOperator is null )
		{
			Accumulator = Parse( Entry );
		}
		else if ( !StartNewEntry && !Evaluate() )
		{
			return;
		}

		PendingOperator = op;
		StartNewEntry = true;
	}

	void Calculate()
	{
		if ( PendingOperator is null )
			return;

		if ( !Evaluate() )
			return;

		PendingOperator = null;
		StartNewEntry = true;
	}

	/// <summary>
	/// Apply the pending operator to the accumulator and the entry. Shows the result.
	/// </summary>
	bool Evaluate()
	{
		var lhs = Accumulator ?? 0;
		var rhs = Parse( Entry );

		double result = PendingOperator switch
		{
			"+" => lhs + rhs,
			"−" => lhs - rhs,
			"×" => lhs * rhs,
			"÷" => lhs / rhs,
			_ => rhs,
		};

		if ( double.IsNaN( result ) || double.IsInfinity( result ) )
		{
			Clear();
			Entry = "ERROR";
			HasError = true;
			return false;
		}

		Accumulator = result;
		Entry = Format( result );
		return true;
	}

	void Clear()
	{
		Entry = "0";
		Accumulator = null;
		PendingOperator = null;
		StartNewEntry = true;
		HasError = false;
	}

	static double Parse( string text ) => double.Parse( text, System.Globalization.CultureInfo.InvariantCulture );

	static string Format( double value ) => value.ToString( $"G{MaxDigits}", System.Globalization.CultureInfo.InvariantCulture );
}
