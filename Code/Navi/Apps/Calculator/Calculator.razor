@using Sandbox.UI
@inherits Panel
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/calculator.napp. It is shared, so the panel *@
@* only draws CalculatorUiState, and its keys are actions (Navi.Act) that the host's copy runs. *@

<root>
	<div class="display">
		<div class="expression">@UiState.Expression</div>
		<div class="entry">@UiState.Entry</div>
	</div>

	<div class="keys">
		@foreach ( var row in CalculatorUiState.Keys )
		{
			<div class="row">
				@foreach ( var key in row )
				{
					<div class="key @key.Class" @onclick=@( () => Navi.Act( this, CalculatorViewModel.PressAction, key.Label ) )>@key.Label</div>
				}
			</div>
		}
	</div>
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only.
	/// </summary>
	CalculatorViewModel ViewModel => field ??= new();

	/// <summary>
	/// What is drawn above. Read only: the view model's, or on a viewer what the host's copy published.
	/// </summary>
	CalculatorUiState UiState => Navi.IsViewer( this ) ? Navi.GetState<CalculatorUiState>( this ) ?? CalculatorUiState.Empty : ViewModel.UiState;

	public override void Tick()
	{
		base.Tick();

		if ( !Navi.IsViewer( this ) )
			Navi.Publish( this, ViewModel.UiState );
	}

	protected override void OnEvent( PanelEvent e )
	{
		if ( Navi.IsAction( e, out var action, out var args ) )
		{
			ViewModel.Act( action, args );
			e.StopPropagation();
			return;
		}

		base.OnEvent( e );
	}

	protected override int BuildHash() => UiState.Revision;
}
