@using Sandbox.UI
@using System.Threading.Tasks
@inherits Panel
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/packages.napp, that talks to the computer *@
@* through the Navi client. It is a system app there, so it starts with the permissions it lists. *@
@* *@
@* The panel is a view and nothing more: every value below is read from the view model's PackagesUiState, and every *@
@* control calls a method on the view model, which replaces the state. It keeps no app state of its own. *@

<root>
	<div class="tabs">
		<div class="tab @(State.ShowStore ? "" : "active")" @onclick=@(() => Model.OpenApps())>Apps</div>
		<div class="tab @(State.ShowStore ? "active" : "")" @onclick=@(() => Model.OpenStore())>Store</div>
		<div class="spacer"></div>

		@if ( State.ShowStore )
		{
			<div class="button @(State.Refreshing ? "disabled" : "")" @onclick=@(() => Model.SubmitSearch())><i>refresh</i></div>
		}
		else
		{
			@* Which apps the list shows. Only the Apps tab filters, so the Store tab has its refresh button here instead. *@
			<div class="filter" tooltip="Show: @State.FilterName" @onclick=@(() => Model.ToggleFilterMenu())><i>filter_list</i></div>
		}
	</div>

	@* Store search. Enter runs it; the refresh button re-runs the text that is in the field. *@
	@if ( State.ShowStore )
	{
		<div class="search">
			<TextEntry Icon="search" Value:bind=@SearchText Placeholder="Search apps, then press Enter" HasClearButton=@true MaxLength=@( 80 ) onsubmit=@(() => Model.SubmitSearch()) />
		</div>
	}

	<div class="list">
		@if ( State.Notice is not null )
		{
			<div class="notice" @onclick=@(() => Model.DismissNotice())>@State.Notice</div>
		}

		@if ( State.ShowStore )
		{
			@if ( State.Refreshing || State.StoreStatus is not null )
			{
				<div class="status">@( State.Refreshing ? "Connecting to the Wired..." : State.StoreStatus )</div>
			}

			@* While a page loads the status takes the list's place, so a slow search reads as work rather than as the same list. *@
			@if ( !State.Refreshing )
			{
				@foreach ( var entry in State.StoreRows )
				{
					<div class="entry">
						<div class="row">
							<img class="thumb" src=@entry.Thumb />
							<div class="info">
								<div class="title-row">
									<div class="name">@entry.Title</div>
									@if ( entry.Official )
									{
										<div class="official" tooltip="Official"><i>verified</i></div>
									}
								</div>
								<div class="description">@entry.Summary</div>
							</div>

							@if ( entry.Action == PackageAction.Installing )
							{
								<div class="button disabled">Installing...</div>
							}
							else if ( entry.Action == PackageAction.Installed )
							{
								<div class="button disabled">Installed</div>
							}
							else
							{
								<div class="button install" @onclick=@(() => Model.InstallPackage( entry.Ident ))>Install</div>
							}

							<div class="expand" tooltip=@(entry.Expanded ? "Less" : "More") @onclick=@(() => Model.ToggleDetails( entry.Ident ))>
								<i>@(entry.Expanded ? "expand_less" : "expand_more")</i>
							</div>
						</div>

						@if ( entry.Expanded )
						{
							<div class="details">
								<div class="about">@entry.About</div>

								<div class="facts">
									@foreach ( var fact in entry.Facts )
									{
										<div class="fact"><i>@fact.Icon</i><div class="key">@fact.Key</div><div class="value">@fact.Value</div></div>
									}
								</div>
							</div>
						}
					</div>
				}
			}
		}
		else
		{
			@if ( State.AppListEmpty )
			{
				<div class="status">@State.EmptyText</div>
			}

			@foreach ( var app in State.AppRows )
			{
				<div class="row">
					<div class="icon" style="background-color: @app.Color;"><i>@app.Icon</i></div>
					<div class="info">
						<div class="title-row">
							<div class="name">@app.Name</div>
							@if ( app.Shield )
							{
								<div class="root" tooltip=@app.ShieldTooltip><i>shield</i></div>
							}
						</div>
						<div class="description">@app.Description</div>
					</div>

					@if ( app.Action == AppAction.Uninstall )
					{
						<div class="button" @onclick=@(() => Model.UninstallApp( app.Id ))>Uninstall</div>
					}
					else if ( app.Action == AppAction.Install )
					{
						<div class="button install" @onclick=@(() => Model.InstallApp( app.Id ))>Install</div>
					}
				</div>
			}
		}
	</div>

	@* Which apps the list shows. Drawn after the list, so it paints over it, with a backdrop that closes it. The *@
	@* backdrop starts under the tabs row, so the tabs and this button stay clickable while the menu is up. *@
	@if ( State.FilterOpen && !State.ShowStore )
	{
		<div class="filter-backdrop" @onmousedown=@(() => Model.CloseFilterMenu())></div>

		<div class="filter-menu">
			@foreach ( var kind in State.Filters )
			{
				<div class="item @(kind.Selected ? "active" : "")" @onclick=@(() => Model.ChooseFilter( kind.Key ))>
					<i>@(kind.Selected ? "check" : "")</i>
					<div class="label">@kind.Label</div>
				</div>
			}
		</div>
	}

	@* How much of the Store the list holds, and the way to the next page of it. *@
	@if ( State.ShowStore && !State.Refreshing && State.StoreTotal > 0 )
	{
		<div class="footer">
			<div class="count">Showing @State.StoreShown of @State.StoreTotal apps</div>

			@if ( State.HasMore )
			{
				<div class="button" @onclick=@(() => Model.LoadMore())>More</div>
			}
		</div>
	}
</root>

@code
{
	PackagesViewModel model;

	/// <summary>
	/// The app's logic and its state. Made on first use, because every call it makes to the computer is made with the
	/// app's own panel, which is this.
	/// </summary>
	PackagesViewModel Model => model ??= new( this );

	/// <summary>
	/// What is drawn below. Read only: the view model replaces it, and its revision is what makes this panel redraw.
	/// </summary>
	PackagesUiState State => Model.State;

	/// <summary>
	/// The Store search field binds to this. Typing isn't a reason to redraw the list: Enter, or the refresh button,
	/// is what searches for what it holds.
	/// </summary>
	string SearchText
	{
		get => Model.SearchText;
		set => Model.SearchText = value;
	}

	public override void Tick()
	{
		base.Tick();

		FitScrollbarGutter();

		Model.Tick();
	}

	/// <summary>
	/// The engine draws the scrollbar over the list instead of taking room from it, and scrollbar-gutter keeps room
	/// whether or not the list scrolls. So the room is made here, only while the bar is there: the engine adds the bar
	/// to the end of the scrolling panel's children.
	/// </summary>
	/// <remarks>
	/// This is the panel doing to its own tree what CSS can't, and it does the same thing every frame: it isn't app
	/// state, so it stays out of the view model.
	/// </remarks>
	void FitScrollbarGutter()
	{
		foreach ( var child in Children )
		{
			if ( !child.HasClass( "list" ) ) continue;

			var scrolling = false;
			foreach ( var bar in child.Children )
				scrolling |= bar is Sandbox.UI.ScrollBar;

			child.SetClass( "scrolling", scrolling );
		}
	}

	protected override int BuildHash() => Model.Revision;
}
