@using Sandbox.UI
@inherits Panel
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/packages.napp, that talks to the computer *@
@* through the Navi client. It is a system app there, so it starts with the permissions it lists. *@
@* *@
@* The panel is a view and nothing more: every value below is read from the view model's PackagesUiState, and every *@
@* control calls a method on the view model, which replaces the state. It keeps no app state of its own. *@

<root>
	<div class="tabs">
		<div class="tab @( UiState.ShowStore ? "" : "active" )" @onclick=@( () => ViewModel.OpenApps() )>
			Apps
		</div>
		<div class="tab @( UiState.ShowStore ? "active" : "" )" @onclick=@( () => ViewModel.OpenStore() )>
			Store
		</div>
		<div class="spacer"></div>

		@if ( UiState.ShowStore )
		{
			<div class="button @( UiState.Refreshing ? "disabled" : "" )" @onclick=@( () => ViewModel.SubmitSearch() )>
				<i>refresh</i>
			</div>
		}
		else
		{
			@* Which apps the list shows. Only the Apps tab filters, so the Store tab has its refresh button *@
			@* here instead. *@
			<div class="filter" tooltip="Show: @UiState.FilterName"
			     @onclick=@( () => ViewModel.ToggleFilterMenu() )>
				<i>filter_list</i>
			</div>
		}
	</div>

	@* Store search. Enter runs it; the refresh button re-runs the text that is in the field. *@
	@if ( UiState.ShowStore )
	{
		<div class="search">
			<TextEntry Icon="search" Value=@( UiState.SearchText ) Placeholder="Search apps, then press Enter"
			           HasClearButton=@true MaxLength=@( 80 )
			           OnTextEdited=@SearchEdited
			           onsubmit=@( () => ViewModel.SubmitSearch() )/>
		</div>
	}

	<div class="list">
		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => ViewModel.DismissNotice() )>
				@UiState.Notice
			</div>
		}

		@if ( UiState.ShowStore )
		{
			@if ( UiState.Refreshing || UiState.StoreStatus is not null )
			{
				<div class="status">@( UiState.Refreshing ? "Connecting to the Wired..." : UiState.StoreStatus )</div>
			}

			@* While a page loads the status takes the list's place, so a slow search reads as work rather than *@
			@* as the same list. *@
			@if ( !UiState.Refreshing )
			{
				@foreach ( var entry in UiState.StoreRows )
				{
					<div class="entry">
						<div class="row">
							<img class="thumb" src=@entry.Thumb/>
							<div class="info">
								<div class="title-row">
									<div class="name">@entry.Title</div>
									@if ( entry.Official )
									{
										<div class="official" tooltip="Official"><i>verified</i></div>
									}
								</div>
								<div class="description">@entry.Summary</div>
							</div>

							@if ( entry.Action == PackageAction.Installing )
							{
								<div class="button disabled">Installing...</div>
							}
							else if ( entry.Action == PackageAction.Installed )
							{
								<div class="button disabled">Installed</div>
							}
							else
							{
								<div class="button install" @onclick=@( () => ViewModel.InstallPackage( entry.Ident ) )>
									Install
								</div>
							}

							<div class="expand" tooltip=@( entry.Expanded ? "Less" : "More" )
							     @onclick=@( () => ViewModel.ToggleDetails( entry.Ident ) )>
								<i>@( entry.Expanded ? "expand_less" : "expand_more" )</i>
							</div>
						</div>

						@if ( entry.Expanded )
						{
							<div class="details">
								<div class="about">@entry.About</div>

								<div class="facts">
									@foreach ( var fact in entry.Facts )
									{
										<div class="fact">
											<i>@fact.Icon</i>
											<div class="key">@fact.Key</div>
											<div class="value">@fact.Value</div>
										</div>
									}
								</div>
							</div>
						}
					</div>
				}
			}
		}
		else
		{
			@if ( UiState.AppListEmpty )
			{
				<div class="status">@UiState.EmptyText</div>
			}

			@foreach ( var app in UiState.AppRows )
			{
				<div class="row">
					<div class="icon" style="background-color: @app.Color;"><i>@app.Icon</i></div>
					<div class="info">
						<div class="title-row">
							<div class="name">@app.Name</div>
							@if ( app.Shield )
							{
								<div class="root" tooltip=@app.ShieldTooltip><i>shield</i></div>
							}
						</div>
						<div class="description">@app.Description</div>
					</div>

					@if ( app.Action == AppAction.Uninstall )
					{
						<div class="button" @onclick=@( () => ViewModel.UninstallApp( app.Id ) )>
							Uninstall
						</div>
					}
					else if ( app.Action == AppAction.Install )
					{
						<div class="button install" @onclick=@( () => ViewModel.InstallApp( app.Id ) )>
							Install
						</div>
					}
				</div>
			}
		}
	</div>

	@* Which apps the list shows. Drawn after the list, so it paints over it, with a backdrop that closes it. The *@
	@* backdrop starts under the tabs row, so the tabs and this button stay clickable while the menu is up. *@
	@if ( UiState.FilterOpen && !UiState.ShowStore )
	{
		<div class="filter-backdrop" @onmousedown=@( () => ViewModel.CloseFilterMenu() )></div>

		<div class="filter-menu">
			@foreach ( var kind in UiState.Filters )
			{
				<div class="item @( kind.Selected ? "active" : "" )"
				     @onclick=@( () => ViewModel.ChooseFilter( kind.Key ) )>
					<i>@( kind.Selected ? "check" : "" )</i>
					<div class="label">@kind.Label</div>
				</div>
			}
		</div>
	}

	@* How much of the Store the list holds, and the way to the next page of it. *@
	@if ( UiState.ShowStore && !UiState.Refreshing && UiState.StoreTotal > 0 )
	{
		<div class="footer">
			<div class="count">Showing @UiState.StoreShown of @UiState.StoreTotal apps</div>

			@if ( UiState.HasMore )
			{
				<div class="button" @onclick=@( () => ViewModel.LoadMore() )>
					More
				</div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state. Made on first use, because every call it makes to the computer is made with the
	/// app's own panel, which is this.
	/// </summary>
	PackagesViewModel ViewModel => field ??= new(this);

	/// <summary>
	/// What is drawn below. Read only: the view model replaces it, and its revision is what makes this panel redraw.
	/// </summary>
	PackagesUiState UiState => ViewModel.UiState;

	public override void Tick()
	{
		base.Tick();

		FitScrollbarGutter();

		ViewModel.Tick();
	}

	/// <summary>
	/// The Store search field reports every edit here. Typing doesn't redraw the list; Enter does.
	/// </summary>
	void SearchEdited( string text ) => ViewModel.SetSearchText( text );

	/// <summary>
	/// The engine draws the scrollbar over the list instead of taking room from it, and scrollbar-gutter keeps room
	/// whether or not the list scrolls. So the room is made here, only while the bar is there: the engine adds the bar
	/// to the end of the scrolling panel's children.
	/// </summary>
	/// <remarks>
	/// This is the panel doing to its own tree what CSS can't, and it does the same thing every frame: it isn't app
	/// state, so it stays out of the view model.
	/// </remarks>
	void FitScrollbarGutter()
	{
		foreach ( var child in Children )
		{
			if ( !child.HasClass( "list" ) ) continue;

			var scrolling = false;
			foreach ( var bar in child.Children )
				scrolling |= bar is ScrollBar;

			child.SetClass( "scrolling", scrolling );
		}
	}

	protected override int BuildHash() => ViewModel.Revision;
}
