@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/packages.napp, that talks to the computer *@
@* through the Navi client. It is a system app there, so it starts with the permissions it lists. *@
@* *@
@* The panel is a view and nothing more: every value below is read from the view model's PackagesUiState, and every *@
@* control calls a method on the view model, which replaces the state. It keeps no app state of its own. *@

<root>
	<div class="tabs">
		<div class="tab @( UiState.ShowStore ? "" : "active" )" @onclick=@( () => Navi.Act( PackagesViewModel.OpenAppsAction ) )>
			Apps
		</div>
		<div class="tab @( UiState.ShowStore ? "active" : "" )" @onclick=@( () => Navi.Act( PackagesViewModel.OpenStoreAction ) )>
			Store
		</div>
		<div class="spacer"></div>

		@if ( UiState.ShowStore )
		{
			<div class="button @( UiState.Refreshing ? "disabled" : "" )" @onclick=@( () => Navi.Act( PackagesViewModel.SubmitSearchAction ) )>
				<i>refresh</i>
			</div>
		}
		else
		{
			@* Which apps the list shows. Only the Apps tab filters, so the Store tab has its refresh button *@
			@* here instead. *@
			<div class="filter" tooltip="Show: @UiState.FilterName"
			     @onclick=@( () => Navi.Act( PackagesViewModel.ToggleFilterMenuAction ) )>
				<i>filter_list</i>
			</div>
		}
	</div>

	@* Store search. Enter runs it; the refresh button re-runs the text that is in the field. *@
	@if ( UiState.ShowStore )
	{
		<div class="search">
			<TextEntry @ref="SearchEntry" Icon="search" Value=@( UiState.SearchText ) Placeholder="Search apps, then press Enter"
			           HasClearButton=@true MaxLength=@( 80 )
			           OnTextEdited=@SearchEdited
			           onsubmit=@( () => Navi.Act( PackagesViewModel.SubmitSearchAction ) )/>
		</div>
	}

	<div class="list">
		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => Navi.Act( PackagesViewModel.DismissNoticeAction ) )>
				@UiState.Notice
			</div>
		}

		@if ( UiState.ShowStore )
		{
			@if ( UiState.Refreshing || UiState.StoreStatus is not null )
			{
				<div class="status">@( UiState.Refreshing ? "Connecting to the Wired..." : UiState.StoreStatus )</div>
			}

			@* While a page loads the status takes the list's place, so a slow search reads as work rather than *@
			@* as the same list. *@
			@if ( !UiState.Refreshing )
			{
				@foreach ( var entry in UiState.StoreRows )
				{
					<div class="entry">
						<div class="row">
							<img class="thumb" src=@entry.Thumb/>
							<div class="info">
								<div class="title-row">
									<div class="name">@entry.Title</div>
									@if ( entry.Official )
									{
										<div class="official" tooltip="Official"><i>verified</i></div>
									}
								</div>
								<div class="description">@entry.Summary</div>
							</div>

							@if ( entry.Action == PackageAction.Installing )
							{
								<div class="button disabled">Installing...</div>
							}
							else if ( entry.Action == PackageAction.Installed )
							{
								<div class="button disabled">Installed</div>
							}
							else if ( entry.Action == PackageAction.Blacklisted )
							{
								<div class="button disabled" tooltip="This game blocks this app">Blacklisted</div>
							}
							else
							{
								<div class="button install" @onclick=@( () => Navi.Act( PackagesViewModel.InstallPackageAction, entry.Ident ) )>
									Install
								</div>
							}

							<div class="expand" tooltip=@( entry.Expanded ? "Less" : "More" )
							     @onclick=@( () => Navi.Act( PackagesViewModel.ToggleDetailsAction, entry.Ident ) )>
								<i>@( entry.Expanded ? "expand_less" : "expand_more" )</i>
							</div>
						</div>

						@if ( entry.Expanded )
						{
							<div class="details">
								<div class="about">@entry.About</div>

								<div class="facts">
									@foreach ( var fact in entry.Facts )
									{
										<div class="fact">
											<i>@fact.Icon</i>
											<div class="key">@fact.Key</div>
											<div class="value">@fact.Value</div>
										</div>
									}
								</div>
							</div>
						}
					</div>
				}
			}
		}
		else
		{
			@if ( UiState.AppListEmpty )
			{
				<div class="status">@UiState.EmptyText</div>
			}

			@foreach ( var app in UiState.AppRows )
			{
				<div class="row">
					<div class="icon" style="background-color: @app.Color;"><i>@app.Icon</i></div>
					<div class="info">
						<div class="title-row">
							<div class="name">@app.Name</div>
							@if ( app.Shield )
							{
								<div class="root" tooltip=@app.ShieldTooltip><i>shield</i></div>
							}
						</div>
						<div class="description">@app.Description</div>
					</div>

					@if ( app.Action == AppAction.Uninstall )
					{
						<div class="button" @onclick=@( () => Navi.Act( PackagesViewModel.UninstallAppAction, app.Id ) )>
							Uninstall
						</div>
					}
					else if ( app.Action == AppAction.Install )
					{
						<div class="button install" @onclick=@( () => Navi.Act( PackagesViewModel.InstallAppAction, app.Id ) )>
							Install
						</div>
					}
				</div>
			}
		}
	</div>

	@* Which apps the list shows. Drawn after the list, so it paints over it, with a backdrop that closes it. The *@
	@* backdrop starts under the tabs row, so the tabs and this button stay clickable while the menu is up. *@
	@if ( UiState.FilterOpen && !UiState.ShowStore )
	{
		<div class="filter-backdrop" @onmousedown=@( () => Navi.Act( PackagesViewModel.CloseFilterMenuAction ) )></div>

		<div class="filter-menu">
			@foreach ( var kind in UiState.Filters )
			{
				<div class="item @( kind.Selected ? "active" : "" )"
				     @onclick=@( () => Navi.Act( PackagesViewModel.ChooseFilterAction, kind.Key ) )>
					<i>@( kind.Selected ? "check" : "" )</i>
					<div class="label">@kind.Label</div>
				</div>
			}
		</div>
	}

	@* How much of the Store the list holds, and the way to the next page of it. *@
	@if ( UiState.ShowStore && !UiState.Refreshing && UiState.StoreTotal > 0 )
	{
		<div class="footer">
			<div class="count">Showing @UiState.StoreShown of @UiState.StoreTotal apps</div>

			@if ( UiState.HasMore )
			{
				<div class="button" @onclick=@( () => Navi.Act( PackagesViewModel.LoadMoreAction ) )>
					More
				</div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state. Made on first use, because every call it makes to the computer is made with the
	/// app's own panel, which is this.
	/// </summary>
	PackagesViewModel ViewModel => field ??= new(Navi);

	/// <summary>
	/// What is drawn below. Read only: the view model replaces it, and its revision is what makes this panel redraw. On
	/// a viewer (the app is shared) it is what the host's copy published, and the host's copy alone has a view model.
	/// </summary>
	PackagesUiState UiState => Navi.IsViewer ? Navi.GetState<PackagesUiState>() ?? PackagesUiState.Empty : ViewModel.UiState;

	public override void Tick()
	{
		base.Tick();

		FitScrollbarGutter();
		ScrollToTopOnNewSearch();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	/// <summary>
	/// The host's copy runs what the player did, from whichever client they're on.
	/// </summary>
	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	/// <summary>
	/// The Store search field reports every edit here. Typing doesn't redraw the list; Enter does.
	/// </summary>
	void SearchEdited( string text ) => Navi.Act( PackagesViewModel.SetSearchTextAction, text );

	/// <summary>
	/// The engine draws the scrollbar over the list instead of taking room from it, and scrollbar-gutter keeps room
	/// whether or not the list scrolls. So the room is made here, only while the bar is there: the engine adds the bar
	/// to the end of the scrolling panel's children.
	/// </summary>
	/// <remarks>
	/// This is the panel doing to its own tree what CSS can't, and it does the same thing every frame: it isn't app
	/// state, so it stays out of the view model.
	/// </remarks>
	void FitScrollbarGutter()
	{
		foreach ( var child in Children )
		{
			if ( !child.HasClass( "list" ) ) continue;

			var scrolling = false;
			foreach ( var bar in child.Children )
				scrolling |= bar is ScrollBar;

			child.SetClass( "scrolling", scrolling );
		}
	}

	/// <summary>The <see cref="PackagesUiState.StoreSearch"/> the list was last scrolled to the top for.</summary>
	int scrolledForSearch;

	/// <summary>
	/// A search that starts the Store list over shows it from the top. Where the list is scrolled is the panel's own,
	/// like the scrollbar gutter, so it is done here when the state says a new list came in.
	/// </summary>
	void ScrollToTopOnNewSearch()
	{
		if ( UiState.StoreSearch == scrolledForSearch )
			return;

		scrolledForSearch = UiState.StoreSearch;

		foreach ( var list in Children.Where( x => x.HasClass( "list" ) ) )
		{
			list.ScrollVelocity = Vector2.Zero;
			list.ScrollOffset = Vector2.Zero;
		}
	}

	TextEntry SearchEntry;

	/// <summary>
	/// Typing doesn't bump the revision, so the list isn't redrawn on every key. The search field still follows the
	/// text as the host has it, so other players see it being typed, except where it has focus: that is where the player
	/// is typing, and the host's text is a keystroke or so behind it.
	/// </summary>
	protected override int BuildHash() =>
		System.HashCode.Combine( UiState.Revision, SearchEntry is { HasFocus: true } ? null : UiState.SearchText );
}
