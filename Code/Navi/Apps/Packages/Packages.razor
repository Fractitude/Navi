@using Sandbox.UI
@using System.Threading.Tasks
@inherits Panel
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/packages.napp, that talks to the computer *@
@* through the Navi client. It is a system app there, so it starts with the permissions it lists. *@

<root>
	<div class="tabs">
		<div class="tab @(ShowStore ? "" : "active")" @onclick=@(() => ShowStore = false)>Apps</div>
		<div class="tab @(ShowStore ? "active" : "")" @onclick=@OpenStore>Store</div>
		<div class="spacer"></div>

		@if ( ShowStore )
		{
			<div class="button @(Refreshing ? "disabled" : "")" @onclick=@(() => _ = FetchStoreAsync( false ))><i>refresh</i></div>
		}
	</div>

	@* Store search. Enter runs it; the refresh button re-runs the text that is in the field. *@
	@if ( ShowStore )
	{
		<div class="search">
			<TextEntry Icon="search" Value:bind=@SearchText Placeholder="Search apps, then press Enter" HasClearButton=@true MaxLength=@( 80 ) onsubmit=@(() => _ = FetchStoreAsync( false )) />
		</div>
	}

	<div class="list">
		@if ( Notice is not null )
		{
			<div class="notice" @onclick=@(() => Notice = null)>@Notice</div>
		}

		@if ( ShowStore )
		{
			@if ( Refreshing || StoreStatus is not null )
			{
				<div class="status">@( Refreshing ? "Connecting to the Wired..." : StoreStatus )</div>
			}

			@foreach ( var (package, official) in StorePackages )
			{
				var ident = package.FullIdent;
				var isExpanded = Expanded.Contains( ident );

				<div class="entry">
				<div class="row">
					<img class="thumb" src=@package.Thumb />
					<div class="info">
						<div class="title-row">
							<div class="name">@package.Title</div>
							@if ( official )
							{
								<div class="official" tooltip="Official"><i>verified</i></div>
							}
						</div>
						<div class="description">@package.Summary</div>
					</div>

					@if ( InstallingPackages.Contains( ident ) )
					{
						<div class="button disabled">Installing...</div>
					}
					else if ( InstalledPackages.Contains( ident ) )
					{
						<div class="button disabled">Installed</div>
					}
					else
					{
						<div class="button install" @onclick=@(() => Run( "install this app", () => Navi.InstallPackage( this, ident ) ))>Install</div>
					}

					<div class="expand" tooltip=@(isExpanded ? "Less" : "More") @onclick=@(() => ToggleDetails( package ))>
						<i>@(isExpanded ? "expand_less" : "expand_more")</i>
					</div>
				</div>

				@if ( isExpanded )
				{
					var full = Details.GetValueOrDefault( ident ) ?? package;

					<div class="details">
						<div class="about">@About( full )</div>

						<div class="facts">
							<div class="fact"><i>person</i><div class="key">Author</div><div class="value">@(full.Org?.Title ?? "Unknown")</div></div>
							<div class="fact"><i>thumb_up</i><div class="key">Rating</div><div class="value">@Rating( full )</div></div>
							<div class="fact"><i>group</i><div class="key">Players</div><div class="value">@full.Usage.Total.Users.ToString( "N0" )</div></div>
							<div class="fact"><i>update</i><div class="key">Updated</div><div class="value">@full.Updated.ToLocalTime().ToString( "d MMM yyyy" )</div></div>
							<div class="fact"><i>sell</i><div class="key">Version</div><div class="value">@(full.Revision?.VersionId.ToString() ?? "...")</div></div>
							<div class="fact"><i>save</i><div class="key">Size</div><div class="value">@Size( full )</div></div>
						</div>
					</div>
				}
				</div>
			}
		}
		else
		{
			@foreach ( var app in Apps.Where( x => x.Type != "core" ) )
			{
				var id = app.Id;

				<div class="row">
					<div class="icon" style="background-color: @app.Color;"><i>@app.Icon</i></div>
					<div class="info">
						<div class="title-row">
							<div class="name">@app.Name</div>
							@if ( app.Type == "system" )
							{
								<div class="root" tooltip="System app: asks for full system access"><i>shield</i></div>
							}
						</div>
						<div class="description">@app.Description</div>
					</div>

					@if ( app.Installed )
					{
						<div class="button" @onclick=@(() => Run( "uninstall apps", () => Navi.Uninstall( this, id ) ))>Uninstall</div>
					}
					else
					{
						<div class="button install" @onclick=@(() => Run( "install apps", () => Navi.Install( this, id ) ))>Install</div>
					}
				</div>
			}
		}
	</div>

	@* How much of the Store the list holds, and the way to the next page of it. *@
	@if ( ShowStore && StoreTotal > 0 )
	{
		<div class="footer">
			<div class="count">Showing @StorePackages.Length of @StoreTotal apps</div>

			@if ( StorePackages.Length < StoreTotal )
			{
				<div class="button @(Refreshing ? "disabled" : "")" @onclick=@(() => _ = FetchStoreAsync( true ))>More</div>
			}
		</div>
	}
</root>

@code
{
	bool ShowStore;

	(string Id, string Name, string Description, string Icon, string Color, bool Installed, string Type)[] Apps = [];

	/// <summary>
	/// The Store entries fetched so far, and how many match the current search in all. The backend pages them, so
	/// the list grows with "More" instead of downloading every app up front.
	/// </summary>
	(Package Package, bool Official)[] StorePackages = [];
	int StoreTotal;

	/// <summary>
	/// What the search field holds. Enter runs it; the refresh button runs it again.
	/// </summary>
	string SearchText = "";

	HashSet<string> InstalledPackages = new();
	HashSet<string> InstallingPackages = new();

	/// <summary>
	/// Message shown above the list, e.g. when the player denied a permission. Click to dismiss.
	/// </summary>
	string Notice;

	/// <summary>
	/// The computer's version when the lists were last fetched. They are fetched again when it changes.
	/// </summary>
	int? knownVersion;
	bool polling;
	RealTimeSince sincePoll;

	public override void Tick()
	{
		base.Tick();

		if ( !polling && sincePoll > 0.25f )
			_ = PollAsync();
	}

	async Task PollAsync()
	{
		polling = true;
		sincePoll = 0;

		try
		{
			var version = await Navi.GetVersion( this );
			if ( version == knownVersion )
				return;

			knownVersion = version;
			Apps = await Navi.GetApps( this );

			var (installed, installing) = await Navi.GetStoreStatus( this );
			InstalledPackages = installed.ToHashSet();
			InstallingPackages = installing.ToHashSet();
			storeVersion++;
		}
		finally
		{
			polling = false;
		}
	}

	/// <summary>
	/// Make a call that needs a permission, asking the player for it if this app doesn't have it.
	/// </summary>
	async void Run( string what, System.Func<Task<bool>> call )
	{
		Notice = null;

		try
		{
			await Navi.WithPermission( this, call );
		}
		catch ( System.UnauthorizedAccessException )
		{
			Notice = $"Packages isn't allowed to {what}.";
		}
		catch ( System.Exception e )
		{
			Log.Warning( e, $"Packages: couldn't {what}: {e.Message}" );
			Notice = $"Couldn't {what}.";
		}

		storeVersion++;
	}

	/// <summary>
	/// The result message shown above the Store list, or null. While a refresh runs the view shows its own message
	/// instead, so this one can't cut it short.
	/// </summary>
	string StoreStatus;

	bool StoreLoaded;
	int storeVersion;

	/// <summary>
	/// True while a Store page is being fetched. <see cref="FetchStoreAsync"/> ignores calls made while it is on, so
	/// only one search runs at a time; the button is disabled too, but the guard is what makes that a rule.
	/// </summary>
	bool Refreshing;

	/// <summary>
	/// How long a refresh shows as running at least. A Store search usually answers within a frame or two, and a
	/// refresh that finishes before it is drawn looks like a click that did nothing, so the status and the disabled
	/// button stay up this long even when the search is instant.
	/// </summary>
	const float RefreshVisibleTime = 0.5f;

	/// <summary>
	/// Store apps fetched per request. The backend pages them, so this is how many a refresh or a "More" adds.
	/// </summary>
	const int StorePageSize = 20;

	/// <summary>
	/// Idents of the Store entries showing their details.
	/// </summary>
	HashSet<string> Expanded = new();

	/// <summary>
	/// Full package info by ident. Search results leave some of it out, like the revision, so it's fetched when an entry is expanded.
	/// </summary>
	Dictionary<string, Package> Details = new();

	void ToggleDetails( Package package )
	{
		var ident = package.FullIdent;
		storeVersion++;

		if ( !Expanded.Add( ident ) )
		{
			Expanded.Remove( ident );
			return;
		}

		if ( !Details.ContainsKey( ident ) )
			_ = FetchDetailsAsync( ident );
	}

	async Task FetchDetailsAsync( string ident )
	{
		try
		{
			if ( await Package.FetchAsync( ident, false ) is { } full )
				Details[ident] = full;
		}
		catch ( System.Exception e )
		{
			Log.Warning( e, $"Packages: couldn't fetch {ident}: {e.Message}" );
		}

		storeVersion++;
	}

	static string About( Package package )
	{
		if ( !string.IsNullOrWhiteSpace( package.Description ) ) return package.Description;
		if ( !string.IsNullOrWhiteSpace( package.Summary ) ) return package.Summary;
		return "No description yet.";
	}

	static string Rating( Package package )
	{
		if ( package.Reviews.Total > 0 )
			return $"{package.Reviews.Score * 100:0}% positive ({package.Reviews.Total})";

		if ( package.VotesUp + package.VotesDown > 0 )
			return $"{package.VotesUp} up, {package.VotesDown} down";

		return "No ratings yet";
	}

	static string Size( Package package )
	{
		if ( package.Revision is not { } revision )
			return "...";

		return $"{System.Math.Max( 1, revision.TotalSize / 1024 )} KB";
	}

	void OpenStore()
	{
		ShowStore = true;

		if ( !StoreLoaded )
			_ = FetchStoreAsync( false );
	}

	/// <summary>
	/// Fetch one page of the Store. A refresh (<paramref name="append"/> false) starts over from the first entry; loading
	/// more adds the page after the entries already shown. Ignores a call made while a page is being fetched.
	/// </summary>
	async Task FetchStoreAsync( bool append )
	{
		// One page at a time, whatever asked for it: two at once would race to fill the same list.
		if ( Refreshing )
			return;

		Refreshing = true;
		StoreLoaded = true;
		storeVersion++;

		RealTimeSince elapsed = 0;

		var text = SearchText.Trim();
		var skip = append ? StorePackages.Length : 0;

		try
		{
			// The old entries stay on screen while the page loads: the status above says it's a refresh.
			var (packages, total) = await Navi.SearchStore( this, text, skip, StorePageSize );

			StorePackages = append ? [.. StorePackages, .. packages] : packages;
			StoreTotal = total;
			StoreStatus = total > 0 ? null
				: text.Length > 0 ? $"No apps match \"{text}\"."
				: "No apps have been published yet.";
		}
		catch ( System.Exception e )
		{
			Log.Warning( e, $"Packages: Store search failed: {e.Message}" );
			StoreStatus = "Couldn't reach the Store.";
		}

		// Hold the running state, and with it the "Connecting" status, for a moment: the search often answers within
		// a frame or two, and a refresh drawn only after it already finished looks like a click that did nothing.
		var remaining = RefreshVisibleTime - elapsed;
		if ( remaining > 0 )
			await Task.Delay( (int)( remaining * 1000 ) );

		Refreshing = false;
		storeVersion++;
	}

	protected override int BuildHash() => System.HashCode.Combine( knownVersion, ShowStore, storeVersion, Notice );
}
