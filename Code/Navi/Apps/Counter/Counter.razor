@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A built-in Navi app, like any other: a plain panel, described by Assets/navi/apps/counter.napp. It talks to the computer *@
@* through the Navi client. *@
@* It is shared: in multiplayer the host's copy counts, and every player sees its count. *@

<root>
	<div class="count">@UiState.Count</div>

	<div class="buttons">
		<div class="button" @onclick=@( () => Navi.Act( CounterViewModel.DecrementAction ) )>−</div>
		<div class="button" @onclick=@( () => Navi.Act( CounterViewModel.IncrementAction ) )>+</div>
	</div>
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only.
	/// </summary>
	CounterViewModel ViewModel => field ??= new();

	CounterUiState UiState => Navi.IsViewer ? Navi.GetState<CounterUiState>() ?? CounterUiState.Empty : ViewModel.UiState;

	public override void Tick()
	{
		base.Tick();

		if ( !Navi.IsViewer )
			Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
