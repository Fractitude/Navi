@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* The file explorer: places and drives on the left, the open folder on the right. A core app *@
@* (Assets/navi/apps/files.napp), so it reaches every file. It is shared, because only the host has the files: the *@
@* panel draws FilesUiState, and its controls are actions (Navi.Act) that the host's copy runs. *@

<root>
	<div class="sidebar">
		<div class="section">Places</div>
		@foreach ( var place in UiState.Places )
		{
			<div class="place @( place.Selected ? "active" : "" )"
			     @onclick=@( () => Navi.Act( FilesViewModel.OpenPathAction, place.Path ) )>
				<i>@place.Icon</i>
				<div class="place-name">@place.Label</div>
			</div>
		}

		<div class="section">Drives</div>
		@foreach ( var drive in UiState.Drives )
		{
			<div class="place @( drive.Selected ? "active" : "" )"
			     @onclick=@( () => Navi.Act( FilesViewModel.OpenPathAction, drive.Path ) )>
				<i>@drive.Icon</i>
				<div class="place-name">@drive.Label</div>
				@if ( drive.Ejectable )
				{
					<i class="eject" tooltip="Eject"
					   @onclick=@( ( PanelEvent e ) => Eject( drive.Path, e ) )>eject</i>
				}
			</div>
		}
	</div>

	<div class="main">
		<div class="toolbar">
			<div class="tool @( UiState.CanBack ? "" : "disabled" )" tooltip="Back"
			     @onclick=@( () => Navi.Act( FilesViewModel.BackAction ) )>
				<i>arrow_back</i>
			</div>
			<div class="tool @( UiState.CanForward ? "" : "disabled" )" tooltip="Forward"
			     @onclick=@( () => Navi.Act( FilesViewModel.ForwardAction ) )>
				<i>arrow_forward</i>
			</div>
			<div class="tool @( UiState.CanUp ? "" : "disabled" )" tooltip="Enclosing folder"
			     @onclick=@( () => Navi.Act( FilesViewModel.UpAction ) )>
				<i>arrow_upward</i>
			</div>

			@* A path too long to fit loses its start, not its end: the trail moves to the right of a box that *@
			@* clips it, and an ellipsis shows something was cut. *@
			<div class="crumbs">
				@if ( crumbsClipped )
				{
					<div class="clipped">…</div>
				}
				<div class="trail-box @( crumbsClipped ? "clipping" : "" )" @ref="TrailBox">
					<div class="trail" @ref="Trail">
						@foreach ( var crumb in UiState.Crumbs )
						{
							@if ( crumb.Path != "/" )
							{
								<div class="separator @( crumb.Ahead ? "ahead" : "" )">/</div>
							}
							<div class="crumb @( crumb.Ahead ? "ahead" : "" )"
							     @onclick=@( () => Navi.Act( FilesViewModel.OpenPathAction, crumb.Path ) )>@crumb.Label</div>
						}
					</div>
				</div>
			</div>
		</div>

		<div class="toolbar actions">
			@if ( UiState.InTrash )
			{
				<div class="tool @( UiState.CanChange ? "" : "disabled" )" tooltip="Put back"
				     @onclick=@( () => Navi.Act( FilesViewModel.RestoreAction ) )>
					<i>restore_from_trash</i>
				</div>
				<div class="tool @( UiState.CanChange ? "" : "disabled" )" tooltip="Delete for good (Delete)"
				     @onclick=@( () => Navi.Act( FilesViewModel.TrashAction ) )>
					<i>delete_forever</i>
				</div>
				<div class="tool wide @( UiState.ListEmpty ? "disabled" : "" )"
				     @onclick=@( () => Navi.Act( FilesViewModel.EmptyTrashAction ) )>
					Empty trash
				</div>
			}
			else
			{
				<div class="tool" tooltip="New folder (Ctrl+Shift+N)" @onclick=@( () => Navi.Act( FilesViewModel.NewFolderAction ) )>
					<i>create_new_folder</i>
				</div>
				<div class="tool" tooltip="New text file" @onclick=@( () => Navi.Act( FilesViewModel.NewFileAction ) )>
					<i>note_add</i>
				</div>
				<div class="divider"></div>
				<div class="tool @( UiState.CanRename ? "" : "disabled" )" tooltip="Rename (F2)"
				     @onclick=@( () => Navi.Act( FilesViewModel.StartRenameAction ) )>
					<i>edit</i>
				</div>
				<div class="tool @( UiState.HasSelection ? "" : "disabled" )" tooltip="Make alias"
				     @onclick=@( () => Navi.Act( FilesViewModel.MakeAliasAction ) )>
					<i>shortcut</i>
				</div>
				<div class="tool @( UiState.HasSelection ? "" : "disabled" )" tooltip="Make symlink"
				     @onclick=@( () => Navi.Act( FilesViewModel.MakeSymlinkAction ) )>
					<i>link</i>
				</div>
				<div class="divider"></div>
				<div class="tool @( UiState.HasSelection ? "" : "disabled" )" tooltip="Copy (Ctrl+C)"
				     @onclick=@( () => Navi.Act( FilesViewModel.CopyAction ) )>
					<i>content_copy</i>
				</div>
				<div class="tool @( UiState.CanChange ? "" : "disabled" )" tooltip="Cut (Ctrl+X)"
				     @onclick=@( () => Navi.Act( FilesViewModel.CutAction ) )>
					<i>content_cut</i>
				</div>
				<div class="tool @( UiState.CanPaste ? "" : "disabled" )" tooltip="Paste (Ctrl+V)"
				     @onclick=@( () => Navi.Act( FilesViewModel.PasteAction ) )>
					<i>content_paste</i>
				</div>
				<div class="divider"></div>
				<div class="tool @( UiState.CanChange ? "" : "disabled" )" tooltip="Move to trash (Delete)"
				     @onclick=@( () => Navi.Act( FilesViewModel.TrashAction ) )>
					<i>delete</i>
				</div>
			}

			<div class="spacer"></div>

			@* The engine's tooltip attribute doesn't show on a computer's screen, so these draw their own. *@
			<div class="tool has-tip"
			     @onclick=@( () => Navi.Act( FilesViewModel.ToggleGridAction ) )>
				<i>@( UiState.GridView ? "view_list" : "grid_view" )</i>
				<div class="tip">@( UiState.GridView ? "List view" : "Grid view" )</div>
			</div>
			<div class="tool has-tip @( UiState.ShowHidden ? "active" : "" )"
			     @onclick=@( () => Navi.Act( FilesViewModel.ToggleHiddenAction ) )>
				<i>@( UiState.ShowHidden ? "visibility" : "visibility_off" )</i>
				<div class="tip">@( UiState.ShowHidden ? "Hide hidden files (Ctrl+H)" : "Show hidden files (Ctrl+H)" )</div>
			</div>
		</div>

		@if ( UiState.Renaming )
		{
			<div class="rename">
				<i>edit</i>
				<TextEntry @ref="RenameEntry" Value=@( UiState.RenameText ) MaxLength=@( 255 )
				           OnTextEdited=@RenameEdited
				           onsubmit=@( () => Navi.Act( FilesViewModel.SubmitRenameAction ) )/>
				<div class="tool" tooltip="Rename" @onclick=@( () => Navi.Act( FilesViewModel.SubmitRenameAction ) )>
					<i>check</i>
				</div>
				<div class="tool" tooltip="Cancel" @onclick=@( () => Navi.Act( FilesViewModel.CancelRenameAction ) )>
					<i>close</i>
				</div>
			</div>
		}

		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => Navi.Act( FilesViewModel.DismissNoticeAction ) )>
				@UiState.Notice
			</div>
		}

		<div class="list-area">
			@* A click on the list itself, not on an entry, clears the selection; a right-click there opens the folder's menu. *@
			<div class="list @( UiState.GridView ? "grid" : "" )" @ref="List"
			     @onmousedown=@( ( PanelEvent e ) => StartBand( e ) )
			     @onclick=@( () => ClickList() )
			     @onrightclick=@( ( PanelEvent e ) => RightClick( null, e ) )>
				@if ( UiState.ListEmpty )
				{
					<div class="empty">@UiState.EmptyText</div>
				}

				@foreach ( var row in UiState.Rows )
				{
					<div class="row @( UiState.GridView ? "tile" : "" ) @( row.Selected ? "selected" : "" ) @( row.Faded ? "faded" : "" )
					     @( row.Cursor ? "cursor" : "" )"
					     @onclick=@( ( PanelEvent e ) => ClickRow( row.Path, e ) )
					     @onrightclick=@( ( PanelEvent e ) => RightClick( row.Path, e ) )
					     @ondoubleclick=@( () => Navi.Act( FilesViewModel.OpenAction, row.Path ) )>
						@if ( UiState.GridView && !Navi.IsViewer && ViewModel.ThumbnailOf( row.Path ) is { } thumbnail )
						{
							<Image class="thumbnail" Texture=@thumbnail/>
						}
						else
						{
							<i class="icon">@row.Icon</i>
						}
						<div class="name">@row.Name</div>
						@if ( row.Badge != "" )
						{
							<div class="badge">@row.Badge</div>
						}
						@if ( !UiState.GridView )
						{
							<div class="detail">@row.Detail</div>
							<div class="modified">@row.Modified</div>
						}
					</div>
				}
			</div>

			@if ( bandMoved )
			{
				<div class="band" style="left: @( BandRect.x )px; top: @( BandRect.y )px; width: @( BandRect.z )px; height: @( BandRect.w )px;"></div>
			}
		</div>

		<div class="status">@UiState.Status</div>
	</div>

	@* The right-click menu, last so it draws over everything, with a backdrop that closes it. *@
	@if ( UiState.MenuOpen )
	{
		<div class="menu-backdrop" @onmousedown=@( () => Navi.Act( FilesViewModel.CloseMenuAction ) )></div>

		<NaviMenu Heading=@UiState.MenuHeading Items=@UiState.Menu OnChoose=@( id => Navi.Act( FilesViewModel.ChooseMenuAction, id ) )
		          style="left: @( MenuLeft )px; top: @( MenuTop )px; width: @( MenuWidth )px;"/>
	}

	@* A question before something that can't be undone, over the whole window so nothing else can be clicked. *@
	@if ( UiState.Confirm is { } confirm )
	{
		<div class="confirm-backdrop">
			<div class="confirm">
				<div class="confirm-title">@confirm.Title</div>
				<div class="confirm-text">@confirm.Text</div>
				<div class="confirm-buttons">
					<div class="tool wide" @onclick=@( () => Navi.Act( FilesViewModel.CancelConfirmAction ) )>Cancel</div>
					<div class="tool wide danger" @onclick=@( () => Navi.Act( FilesViewModel.ConfirmAction ) )>
						@confirm.Button
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only.
	/// </summary>
	FilesViewModel ViewModel => field ??= new( Navi );

	/// <summary>
	/// What is drawn above. Read only: the view model's, or on a viewer what the host's copy published.
	/// </summary>
	FilesUiState UiState => Navi.IsViewer ? Navi.GetState<FilesUiState>() ?? FilesUiState.Empty : ViewModel.UiState;

	TextEntry RenameEntry;

	Panel List;

	// Drag selection: pressing on the empty list and dragging draws a band and selects the entries it touches. The points
	// are in the list's content, in screen pixels, so the band stays on its entries while the list scrolls.
	bool bandActive;
	bool bandMoved;

	/// <summary>The drag just ended: the click that follows its release is ignored.</summary>
	bool bandEnded;
	Vector2 bandStart;
	Vector2 bandEnd;
	HashSet<string> bandBase = new();
	string bandSent;

	/// <summary>Where the pointer is in the list's content (screen pixels).</summary>
	Vector2 ListPoint => List.MousePosition + List.ScrollOffset;

	/// <summary>
	/// The band as left, top, width, height in the panel's pixels, from the top left of the visible list and cut off at its
	/// edges. It is drawn over the list, not inside it, so scrolling and the list's padding don't move it.
	/// </summary>
	Vector4 BandRect
	{
		get
		{
			if ( List is null )
				return default;

			var from = Vector2.Max( Vector2.Min( bandStart, bandEnd ) - List.ScrollOffset, Vector2.Zero );
			var to = Vector2.Min( Vector2.Max( bandStart, bandEnd ) - List.ScrollOffset, List.Box.Rect.Size );
			var size = Vector2.Max( to - from, Vector2.Zero );
			from *= ScaleFromScreen;
			size *= ScaleFromScreen;
			return new Vector4( from.x, from.y, size.x, size.y );
		}
	}

	/// <summary>The <see cref="FilesUiState.RenameSession"/> the rename field was last focused for.</summary>
	int focusedRename;

	Panel TrailBox;
	Panel Trail;

	/// <summary>The breadcrumb trail is wider than its box, so its start is cut off.</summary>
	bool crumbsClipped;

	/// <summary>
	/// The left button went down on the list itself, not on an entry: a drag from here selects. With Ctrl held, what was
	/// selected stays selected.
	/// </summary>
	void StartBand( PanelEvent e )
	{
		if ( List is null || e is not MousePanelEvent { MouseButton: MouseButtons.Left } || e.Target != List )
			return;

		var ctrl = e is MousePanelEvent { HasCtrl: true } || Input.Keyboard.Down( "CTRL" ) || Input.Keyboard.Down( "RCTRL" );
		bandActive = true;
		bandMoved = false;
		bandEnded = false;
		bandStart = bandEnd = ListPoint;
		bandSent = null;
		bandBase = ctrl ? UiState.Rows.Where( x => x.Selected ).Select( x => x.Path ).ToHashSet() : new();
	}

	/// <summary>
	/// The click that ends a drag lands on the list too, and mustn't clear what the band selected.
	/// </summary>
	void ClickList()
	{
		if ( bandEnded )
		{
			bandEnded = false;
			return;
		}

		Navi.Act( FilesViewModel.SelectAction );
	}

	/// <summary>
	/// While the button is held, follow the pointer and select the entries the band touches. Only a change is sent.
	/// </summary>
	void UpdateBand()
	{
		if ( !bandActive )
			return;

		if ( List is null || !List.IsValid || !List.HasActive )
		{
			bandActive = false;
			bandEnded = bandMoved;
			bandMoved = false;
			return;
		}

		bandEnd = ListPoint;
		if ( !bandMoved && (bandEnd - bandStart).Length < 4f )
			return;

		bandMoved = true;

		var min = Vector2.Min( bandStart, bandEnd );
		var max = Vector2.Max( bandStart, bandEnd );
		var offset = List.Box.Rect.Position - List.ScrollOffset;
		var rows = List.Children.Where( x => x.HasClass( "row" ) ).ToList();
		var hit = new List<string>( bandBase );

		for ( var i = 0; i < rows.Count && i < UiState.Rows.Count; i++ )
		{
			var rect = rows[i].Box.Rect;
			var left = rect.Left - offset.x;
			var top = rect.Top - offset.y;
			if ( left < max.x && left + rect.Width > min.x && top < max.y && top + rect.Height > min.y )
				hit.Add( UiState.Rows[i].Path );
		}

		hit = hit.Distinct().ToList();
		var key = string.Join( "|", hit );
		if ( key == bandSent )
			return;

		bandSent = key;
		Navi.Act( FilesViewModel.SelectManyAction, hit.ToArray() );
	}

	public override void Tick()
	{
		base.Tick();

		FocusRename();
		UpdateBand();
		crumbsClipped = TrailBox is not null && Trail is not null && Trail.Box.Rect.Width > TrailBox.Box.Rect.Width + 0.5f;

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	/// <summary>
	/// The host's copy gets the player's keyboard shortcuts, from whichever client they're on.
	/// </summary>
	protected override void OnShortcut( string keys ) => ViewModel.Shortcut( keys );

	/// <summary>
	/// A click on an entry selects it, Ctrl+click adds it to the selection or takes it away, Shift+click selects the
	/// range to it. The keys are read here, on the clicking player's client, and go with the action. The click stops
	/// here, so the list behind it doesn't clear the selection.
	/// </summary>
	void ClickRow( string path, PanelEvent e )
	{
		e.StopPropagation();
		bandEnded = false;

		// A click on a world panel (WorldInput) comes without the modifier keys (HasCtrl and HasShift are always false
		// there), so the keyboard is asked too.
		var ctrl = e is MousePanelEvent { HasCtrl: true } || Input.Keyboard.Down( "CTRL" ) || Input.Keyboard.Down( "RCTRL" );
		var shift = e is MousePanelEvent { HasShift: true } || Input.Keyboard.Down( "SHIFT" ) || Input.Keyboard.Down( "RSHIFT" );
		var mode = ctrl ? FilesViewModel.ToggleMode : shift ? FilesViewModel.RangeMode : "";

		Navi.Act( FilesViewModel.SelectAction, path, mode );
	}

	/// <summary>
	/// A right-click on an entry, or on the empty list (null): the menu opens where the mouse is, in this panel's pixels.
	/// </summary>
	void RightClick( string path, PanelEvent e )
	{
		e.StopPropagation();

		var at = MousePosition * ScaleFromScreen;
		var culture = System.Globalization.CultureInfo.InvariantCulture;
		Navi.Act( FilesViewModel.OpenMenuAction, path ?? "", at.x.ToString( culture ), at.y.ToString( culture ) );
	}

	const float MenuWidth = 190f, MenuItemHeight = 26f, MenuHeadingHeight = 22f, MenuSeparatorHeight = 5f, MenuPadding = 8f;

	/// <summary>
	/// Where the menu is drawn: where it was opened, moved left or up as far as it takes to stay inside the panel. Every
	/// player's copy works it out from its own size, the same as the host's.
	/// </summary>
	float MenuLeft => System.Math.Max( 0f, System.Math.Min( UiState.MenuX, PanelSize.x - MenuWidth ) );

	float MenuTop
	{
		get
		{
			var height = MenuPadding + UiState.Menu.Count * MenuItemHeight + UiState.Menu.Count( x => x.Separator ) * MenuSeparatorHeight
				+ (UiState.MenuHeading is null ? 0f : MenuHeadingHeight);

			return System.Math.Max( 0f, System.Math.Min( UiState.MenuY, PanelSize.y - height ) );
		}
	}

	Vector2 PanelSize => Box.Rect.Size * ScaleFromScreen;

	/// <summary>
	/// The eject button sits on the drive's row: it ejects, and the row's own click doesn't open the drive.
	/// </summary>
	void Eject( string path, PanelEvent e )
	{
		e.StopPropagation();
		Navi.Act( FilesViewModel.EjectAction, path );
	}

	/// <summary>
	/// The rename field reports every edit here, as an action, so other players see the name being typed.
	/// </summary>
	void RenameEdited( string text ) => Navi.Act( FilesViewModel.SetRenameTextAction, text );

	/// <summary>
	/// Put the caret in the rename field once each time it opens. Only where the app runs for the player at the computer
	/// (offline, or the host's own seat): on a viewer it would take the keys of whoever is watching, so a player on a
	/// client clicks the field.
	/// </summary>
	void FocusRename()
	{
		if ( UiState.RenameSession == focusedRename || RenameEntry is null || !Navi.HasInput || Navi.IsViewer )
			return;

		focusedRename = UiState.RenameSession;
		RenameEntry.Focus();
	}

	/// <summary>
	/// Typing doesn't bump the revision. The field still follows the host's text, except where it has focus: the player
	/// is typing there, and the host is a keystroke behind.
	/// </summary>
	protected override int BuildHash() =>
		System.HashCode.Combine( UiState.Revision, RenameEntry is { HasFocus: true } ? null : UiState.RenameText,
			crumbsClipped, bandMoved ? BandRect : default );
}
