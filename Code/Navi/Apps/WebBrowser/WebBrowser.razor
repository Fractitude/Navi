@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A built-in Navi app like any other: a plain panel, described by Assets/navi/apps/webbrowser.napp. The page itself is *@
@* the engine's WebPanel. Offline it shows Dino Run instead (DinoRunGame), as Chrome does. *@
@* It is shared, but only for Dino Run: the host's copy runs the game and says whether the computer is online *@
@* (WebBrowserSharedViewModel), and every player near the screen sees it. Browsing is the seated player's own: their *@
@* copy has the address, the history and the page, everyone else sees a private screen, and nothing about it is *@
@* published, so no other player can make their real browser open a site (see the remarks on WebBrowserViewModel). *@

<root>
	@if ( SharedState.Online is false && Navi.IsWatching )
	{
		<div class="offline">
			<div class="offline-text">
				<i>wifi_off</i>
				<label>No internet. This computer needs a network card to reach the web.</label>
			</div>
			<div class="dino-area" @ref="DinoArea">
				<DinoRunBoard @ref="Board"></DinoRunBoard>
			</div>
		</div>
	}
	else if ( Navi.IsWatching )
	{
		<div class="private">
			<i>visibility_off</i>
			<label>This player is browsing the internet privately.</label>
		</div>
	}
	else
	{
		<div class="toolbar">
			<div class="button @( UiState.CanGoBack ? "" : "disabled" )" tooltip="Back" @onclick=@( () => ViewModel.GoBack() )>
				<i>arrow_back</i>
			</div>
			<div class="button @( UiState.CanGoForward ? "" : "disabled" )" tooltip="Forward" @onclick=@( () => ViewModel.GoForward() )>
				<i>arrow_forward</i>
			</div>
			<div class="button" tooltip="Reload" @onclick=@( () => ViewModel.Reload() )>
				<i>refresh</i>
			</div>
			<div class="button" tooltip="Home" @onclick=@( () => ViewModel.GoHome() )>
				<i>home</i>
			</div>

			<div class="address">
				<TextEntry Value=@( UiState.AddressText ) Placeholder="Search or enter an address"
				           OnTextEdited=@AddressEdited
				           onsubmit=@( () => ViewModel.SubmitAddress() )/>
			</div>
		</div>

		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => ViewModel.DismissNotice() )>
				@UiState.Notice
			</div>
		}

		@if ( SharedState.Online is false )
		{
			<div class="offline">
				<div class="offline-text">
					<i>wifi_off</i>
					<label>No internet. This computer needs a network card to reach the web.</label>
				</div>
				<div class="dino-area" @ref="DinoArea">
					<DinoRunBoard @ref="Board" Clicked=@( () => Navi.Act( WebBrowserSharedViewModel.ClickAction ) )></DinoRunBoard>
				</div>
			</div>
		}
		else if ( SharedState.Online is true )
		{
			<WebPanel @ref="Web" class="page"/>
		}
	}
</root>

@code
{
	/// <summary>
	/// Browsing, which is the seated player's own. Made on first use, on any copy, but only the seated player's copy uses
	/// it: everyone else's draws the private screen. It makes no calls but the local title, so a viewer's copy may have it.
	/// </summary>
	WebBrowserViewModel ViewModel => field ??= new(Navi);

	/// <summary>
	/// The browsing toolbar's state. Read only: the view model replaces it, and its revision is what makes this panel redraw.
	/// </summary>
	WebBrowserUiState UiState => ViewModel.UiState;

	/// <summary>
	/// Dino Run and whether the computer is online. Only the host's copy has it; never made on a viewer's copy.
	/// </summary>
	WebBrowserSharedViewModel Shared => field ??= new(Navi);

	/// <summary>
	/// What every player near the screen sees: the host's copy's own, or what it published.
	/// </summary>
	WebBrowserSharedState SharedState =>
		Navi.IsViewer ? Navi.GetState<WebBrowserSharedState>() ?? WebBrowserSharedState.Empty : Shared.UiState;

	WebPanel Web;

	/// <summary>The room below the offline message, which the game is scaled to fill.</summary>
	Panel DinoArea;
	DinoRunBoard Board;
	float boardScale;

	/// <summary>
	/// The board <see cref="boardScale"/> was applied to. The markup makes a new board when the page is drawn again (the
	/// player stood up and sat down, say), and a new one starts unscaled.
	/// </summary>
	DinoRunBoard scaledBoard;

	/// <summary>What <c>Navi.Input.KeepLocalAsync</c> was last told. Null before the first tick.</summary>
	bool? keptInputLocal;

	/// <summary>The <see cref="WebBrowserUiState.LoadId"/> the page was last told to load.</summary>
	int loadedId = -1;

	/// <summary>
	/// The page is a panel of the engine, so loading into it and reading which address it is on are done here, between it
	/// and the view model. Neither is app state.
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		if ( !Navi.IsViewer )
		{
			Shared.Tick( Time.Delta, Navi.HasInput );
			Navi.Publish( Shared.UiState );
		}

		var shared = SharedState;
		if ( shared.Online is false && Board.IsValid() )
		{
			Board.DrawFrame( shared.Dino );
			ScaleBoard();
		}

		if ( !Navi.IsWatching && shared.Online is { } online )
			ViewModel.NetworkChanged( online );

		// Only Dino Run takes the player's keys to the host's copy. While browsing they stay here: what the player types
		// into a page is theirs alone. Every copy says so, so a player who sits down is covered from their first frame.
		var keepLocal = shared.Online is not false;
		if ( keepLocal != keptInputLocal )
		{
			keptInputLocal = keepLocal;
			_ = Navi.Input.KeepLocalAsync( keepLocal );
		}

		if ( Navi.IsWatching || !Web.IsValid() )
		{
			// The page is made again when the player is back, and loads the address again.
			loadedId = -1;
			return;
		}

		if ( loadedId != UiState.LoadId )
		{
			loadedId = UiState.LoadId;
			Load( UiState.Url );
		}

		ViewModel.PageChanged( Web.Surface?.Url, Web.Surface?.PageTitle );
	}

	/// <summary>
	/// Scale the game to the biggest it fits in its area. Layout boxes ignore transforms, so the board keeps its own size to
	/// measure, and the area centers it; scaled to fit the area, it never reaches the message above. What the panel does to
	/// its own tree, like Pac-Man's frame.
	/// </summary>
	void ScaleBoard()
	{
		if ( !DinoArea.IsValid() || DinoArea.Box.Rect.Width <= 0f || DinoArea.Box.Rect.Height <= 0f || Board.Box.Rect.Width <= 0f )
			return;

		var scale = System.MathF.Min( DinoArea.Box.Rect.Width * 0.95f / Board.Box.Rect.Width,
			DinoArea.Box.Rect.Height * 0.95f / Board.Box.Rect.Height );

		if ( !float.IsFinite( scale ) || scale <= 0f )
			return;

		if ( Board == scaledBoard && Board.Style.Transform is not null && System.MathF.Abs( scale - boardScale ) < 0.001f )
			return;

		boardScale = scale;
		scaledBoard = Board;
		var transform = new PanelTransform();
		transform.AddScale( scale );
		Board.Style.Transform = transform;
	}

	/// <summary>
	/// The engine refuses addresses it doesn't allow, and says so by throwing.
	/// </summary>
	void Load( string url )
	{
		try
		{
			Web.Url = url;
		}
		catch ( System.Exception e )
		{
			ViewModel.LoadFailed( e.Message );
		}
	}

	/// <summary>
	/// The address field reports every edit here. Typing doesn't redraw; Enter loads.
	/// </summary>
	void AddressEdited( string text ) => ViewModel.SetAddressText( text );

	/// <summary>
	/// Only the host's copy hears these.
	/// </summary>
	protected override void OnNetworkChanged( bool online )
	{
		if ( !Navi.IsViewer )
			Shared.NetworkChanged( online );
	}

	protected override void OnAction( string action, string[] args )
	{
		if ( !Navi.IsViewer )
			Shared.Act( action, args );
	}

	protected override int BuildHash() => System.HashCode.Combine( ViewModel.Revision, Navi.IsWatching, SharedState.Online );
}
