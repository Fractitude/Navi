@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A built-in Navi app like any other: a plain panel, described by Assets/navi/apps/webbrowser.napp. The page itself is *@
@* the engine's WebPanel. Offline it shows Dino Run instead (DinoRunGame), as Chrome does. A local address *@
@* (browser://, see WebBrowserViewModel.LocalScheme) is drawn here and never loaded: browser://dino is the game. So *@
@* is a file address (file:///Pictures/angel.jpg): a text file, a picture or a folder of the computer's own files. *@
@* It is shared, but only for Dino Run: the host's copy runs the game and says whether the computer is online *@
@* (WebBrowserSharedViewModel), and every player near the screen sees it. Browsing is the seated player's own: their *@
@* copy has the address, the history and the page, everyone else sees a private screen, and nothing about it is *@
@* published, so no other player can make their real browser open a site (see the remarks on WebBrowserViewModel). *@
@* That goes for the tabs too (WebBrowserTabs): only the seated player sees the tab bar, and each tab is a browser of *@
@* its own, with a WebPanel (WebBrowserTabPage) that stays loaded while another tab is shown. *@

<root>
	@if ( !Navi.IsWatching )
	{
		<div class="tabs" @ref="TabBar">
			@foreach ( var tab in Tabs.All )
			{
				<div @key=@tab.Id class="tab @( tab == Tabs.Active ? "active" : "" )"
				     @onmousedown=@( ( PanelEvent e ) => PressTab( e, tab ) )>
					<label class="tab-title">@TabTitle( tab )</label>
					@if ( Tabs.CanClose )
					{
						<div class="close" tooltip="Close tab" @onclick=@( () => Tabs.Close( tab ) )>
							<i>close</i>
						</div>
					}
				</div>
			}
			<div class="button @( Tabs.CanAdd ? "" : "disabled" )" tooltip="New tab" @onclick=@( () => Tabs.NewTab() )>
				<i>add</i>
			</div>

			@* The arrow between tabs where a file dropped on the tab bar would open (ShowInsert). *@
			<div class="insert" @ref="InsertMarker">
				<i>arrow_drop_down</i>
			</div>
		</div>

		<div class="toolbar">
			<div class="button @( UiState.CanGoBack ? "" : "disabled" )" tooltip="Back" @onclick=@( () => ViewModel.GoBack() )>
				<i>arrow_back</i>
			</div>
			<div class="button @( UiState.CanGoForward ? "" : "disabled" )" tooltip="Forward" @onclick=@( () => ViewModel.GoForward() )>
				<i>arrow_forward</i>
			</div>
			<div class="button" tooltip="Reload" @onclick=@( () => ViewModel.Reload() )>
				<i>refresh</i>
			</div>
			<div class="button" tooltip="Home" @onclick=@( () => ViewModel.GoHome() )>
				<i>home</i>
			</div>

			<div class="address">
				<TextEntry Value=@( UiState.AddressText ) Placeholder="Search or enter an address"
				           OnTextEdited=@AddressEdited
				           onsubmit=@( () => ViewModel.SubmitAddress() )/>
			</div>
		</div>

		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => ViewModel.DismissNotice() )>
				@UiState.Notice
			</div>
		}

	}

	<div class="content" @ref="Content">
		@if ( Dino != DinoView.None )
		{
			<div class="offline">
				@if ( Dino == DinoView.Offline )
				{
					<div class="offline-text">
						<i>wifi_off</i>
						<label>No internet. @( SharedState.OfflineHint ?? "This computer needs a network connection to reach the web." )</label>
					</div>
				}
				<div class="dino-area" @ref="DinoArea">
					<DinoRunBoard @ref="Board" Clicked=@( () => Navi.Act( WebBrowserSharedViewModel.ClickAction ) )></DinoRunBoard>
				</div>
			</div>
		}
		else if ( Navi.IsWatching )
		{
			<div class="private">
				<i>visibility_off</i>
				<label>This player is browsing the internet privately.</label>
			</div>
		}
		else if ( UiState.LocalPage is { } localPage )
		{
			<div class="private">
				<i>link_off</i>
				<label>@localPage isn't a page of this browser. Try @WebBrowserViewModel.DinoPage.</label>
			</div>
		}
		else if ( UiState.File is { } file )
		{
			@if ( file.Kind == WebBrowserFileKind.Text )
			{
				@* A label holds a selection but doesn't make one: a drag is handled by an ancestor with AllowChildSelection, *@
				@* as in the Calculator. *@
				<div class="file-page file-text" AllowChildSelection=@true AcceptsFocus=@true>
					<label class="text" @ref="FileText">@file.Text</label>
				</div>
			}
			else if ( file.Kind == WebBrowserFileKind.Image )
			{
				<div class="file-page file-image">
					<Image class="picture" Texture=@ViewModel.Picture/>
					<label class="size">@file.Message</label>
				</div>
			}
			else if ( file.Kind == WebBrowserFileKind.Folder )
			{
				<div class="file-page file-folder">
					<label class="heading">Index of @file.Path</label>
					@foreach ( var entry in file.Entries )
					{
						<div class="entry" @onclick=@( () => ViewModel.OpenFile( entry.Url ) )>
							<i>@( entry.IsFolder ? "folder" : "description" )</i>
							<label class="name">@entry.Name</label>
							<label class="size">@entry.SizeText</label>
						</div>
					}
				</div>
			}
			else
			{
				<div class="private">
					<i>@( file.Kind == WebBrowserFileKind.Loading ? "hourglass_empty" : "draft" )</i>
					<label>@( file.Kind == WebBrowserFileKind.Loading ? $"Opening {file.Path}..." : file.Message )</label>
				</div>
			}
		}

		@* Every tab on a web page keeps its page, shown or not: one that is hidden stays loaded in the background. *@
		@if ( !Navi.IsWatching && SharedState.Online is true )
		{
			@foreach ( var tab in Tabs.All.Where( x => x.UiState.LocalPage is null && x.UiState.File is null ) )
			{
				<WebBrowserTabPage @key=@tab.Id Tab=@tab class="page @( tab == Tabs.Active ? "" : "background" )"/>
			}
		}
	</div>
</root>

@code
{
	/// <summary>
	/// The tabs, and the browsing in them, which are the seated player's own. Made on first use, on any copy, but only the
	/// seated player's copy uses them: everyone else's draws the private screen. They make no calls but the local title and
	/// reading files, so a viewer's copy may have them.
	/// </summary>
	WebBrowserTabs Tabs => field ??= new(Navi);

	/// <summary>The tab shown, whose toolbar and page are drawn.</summary>
	WebBrowserViewModel ViewModel => Tabs.Active;

	/// <summary>
	/// The browsing toolbar's state. Read only: the view model replaces it, and its revision is what makes this panel redraw.
	/// </summary>
	WebBrowserUiState UiState => ViewModel.UiState;

	/// <summary>
	/// Dino Run and whether the computer is online. Only the host's copy has it; never made on a viewer's copy.
	/// </summary>
	WebBrowserSharedViewModel Shared => field ??= new(Navi);

	/// <summary>
	/// What every player near the screen sees: the host's copy's own, or what it published.
	/// </summary>
	WebBrowserSharedState SharedState =>
		Navi.IsViewer ? Navi.GetState<WebBrowserSharedState>() ?? WebBrowserSharedState.Empty : Shared.UiState;

	/// <summary>A text file's text, which the player can select and copy (<see cref="TickFileText"/>).</summary>
	Label FileText;

	enum DinoView
	{
		None,

		/// <summary>The computer is offline, which the game sits under a notice for.</summary>
		Offline,

		/// <summary>The player opened <c>browser://dino</c>.</summary>
		Opened,
	}

	/// <summary>
	/// Whether this copy draws Dino Run, and how. The seated player's copy goes by their own page; everyone else's by what
	/// the host's copy published.
	/// </summary>
	DinoView Dino => Navi.IsWatching ? (SharedState.DinoShown ? DinoView.Opened : OfflineView) : OwnDino;

	/// <summary>Dino Run as this client's own browsing has it, whether or not this player is in the seat.</summary>
	DinoView OwnDino => UiState.LocalPage == WebBrowserViewModel.DinoPage ? DinoView.Opened
		: UiState.LocalPage is null && UiState.File is null ? OfflineView : DinoView.None;

	DinoView OfflineView => SharedState.Online is false ? DinoView.Offline : DinoView.None;

	/// <summary>What was last told the host's copy with <see cref="WebBrowserSharedViewModel.ShowAction"/>. Null while
	/// watching, so it is told again on sitting down.</summary>
	bool? sentShown;

	/// <summary>The room below the offline message, which the game is scaled to fill.</summary>
	Panel DinoArea;
	DinoRunBoard Board;
	float boardScale;

	/// <summary>
	/// The board <see cref="boardScale"/> was applied to. The markup makes a new board when the page is drawn again (the
	/// player stood up and sat down, say), and a new one starts unscaled.
	/// </summary>
	DinoRunBoard scaledBoard;

	/// <summary>What <c>Navi.Input.KeepLocalAsync</c> was last told. Null before the first tick.</summary>
	bool? keptInputLocal;

	/// <summary>
	/// Each tab's web page loads itself and reports its address (<see cref="WebBrowserTabPage"/>).
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		// Files dragged out of Files (Navi.Drag): the page area opens one in the tab shown, the tab bar opens each in a new tab
		// where it is dropped. Only the seated player's own copy takes them: browsing is theirs alone. They are links: the
		// browser shows a file where it is, and never moves or copies it.
		var accepts = Navi.IsWatching ? Navi.DragEffects.None : Navi.DragEffects.Link;
		Navi.Drag.AcceptDrops( Content, accepts, Navi.DragCalls.FilesKind );
		Navi.Drag.AcceptDrops( TabBar, accepts, Navi.DragCalls.FilesKind );

		if ( !Navi.IsViewer )
		{
			Shared.Tick( Time.Delta, Navi.HasInput );
			Navi.Publish( Shared.UiState );
		}

		var shared = SharedState;
		if ( Dino != DinoView.None && Board.IsValid() )
		{
			Board.DrawFrame( shared.Dino );
			ScaleBoard();
		}

		if ( !Navi.IsWatching && shared.Online is { } online )
			Tabs.NetworkChanged( online );

		if ( !Navi.IsWatching )
			Tabs.ShowTitle();

		UpdateTabDrag();

		TickFileText();

		// The host's copy runs the game, so it hears when the seated player opens or leaves browser://dino. Only the
		// seated player may tell it.
		if ( Navi.IsWatching )
			sentShown = null;
		else if ( (OwnDino == DinoView.Opened) != sentShown )
		{
			sentShown = OwnDino == DinoView.Opened;
			Navi.Act( WebBrowserSharedViewModel.ShowAction, sentShown.Value ? "1" : "0" );
		}

		// Only Dino Run takes the player's keys to the host's copy. While browsing they stay here: what the player types
		// into a page is theirs alone. Every copy goes by its own browsing, so a player who sits down is covered from
		// their first frame.
		var keepLocal = OwnDino == DinoView.None;
		if ( keepLocal != keptInputLocal )
		{
			keptInputLocal = keepLocal;
			_ = Navi.Input.KeepLocalAsync( keepLocal );
		}
	}

	/// <summary>The tab bar, along which a tab is dragged to a new place.</summary>
	Panel TabBar;

	// The tab being dragged to a new place. The drag lasts while the mouse button is held on dragHandle, its panel, and
	// only starts once the mouse has moved TabDragThreshold; until then it is a press that picked the tab. Where the
	// tabs are while it lasts is the panel's own, like Pac-Man's frame: the tabs move only when it is dropped.
	Panel dragHandle;
	WebBrowserViewModel dragTab;
	int dragFrom;
	float dragSlot; // From one tab's left edge to the next's, in panel pixels.
	float dragStartMouse;
	bool dragMoved;

	/// <summary>How far the mouse moves, in panel pixels, before pressing a tab becomes dragging it.</summary>
	const float TabDragThreshold = 6f;

	List<Panel> TabPanels => TabBar.IsValid() ? TabBar.Children.Where( x => x.HasClass( "tab" ) ).ToList() : [];

	float TabBarMouse => TabBar.MousePosition.x * TabBar.ScaleFromScreen;

	/// <summary>
	/// The mouse went down on a tab: it is shown, and moving the mouse far enough drags it (<see cref="UpdateTabDrag"/>).
	/// Its close button is left to close it.
	/// </summary>
	void PressTab( PanelEvent e, WebBrowserViewModel tab )
	{
		if ( e is not MousePanelEvent { MouseButton: MouseButtons.Left } )
			return;

		for ( var panel = e.Target; panel is not null && panel != e.This; panel = panel.Parent )
		{
			if ( panel.HasClass( "close" ) )
				return;
		}

		Tabs.Select( tab );

		var panels = TabPanels;
		var from = panels.IndexOf( e.This );
		if ( from < 0 || panels.Count < 2 || panels.Count != Tabs.All.Count || Tabs.All[from] != tab )
			return;

		dragHandle = e.This;
		dragTab = tab;
		dragFrom = from;
		dragSlot = (panels[1].Box.Rect.Left - panels[0].Box.Rect.Left) * TabBar.ScaleFromScreen;
		dragStartMouse = TabBarMouse;
		dragMoved = false;
	}

	/// <summary>
	/// Move the dragged tab with the mouse, along the tab bar, and the tabs it passes out of its way. Letting go drops it
	/// there. The drag is called off if the tabs change under it.
	/// </summary>
	void UpdateTabDrag()
	{
		if ( dragHandle is null )
			return;

		var panels = TabPanels;
		var unchanged = !Navi.IsWatching && dragHandle.IsValid && panels.Count == Tabs.All.Count
			&& panels.IndexOf( dragHandle ) == dragFrom && Tabs.All[dragFrom] == dragTab;

		if ( !unchanged )
		{
			EndTabDrag( panels, dragFrom );
			return;
		}

		var delta = TabBarMouse - dragStartMouse;
		var released = !dragHandle.HasActive;

		if ( !dragMoved )
		{
			if ( released )
			{
				EndTabDrag( panels, dragFrom );
				return;
			}

			if ( System.MathF.Abs( delta ) < TabDragThreshold )
				return;

			dragMoved = true;
		}

		var offset = System.Math.Clamp( delta, -dragFrom * dragSlot, (panels.Count - 1 - dragFrom) * dragSlot );
		var to = dragSlot > 0f ? dragFrom + (int)System.MathF.Round( offset / dragSlot ) : dragFrom;

		if ( released )
		{
			EndTabDrag( panels, to );
			return;
		}

		TabBar.SetClass( "reordering", true );

		for ( var i = 0; i < panels.Count; i++ )
		{
			var shift = i == dragFrom ? offset
				: i > dragFrom && i <= to ? -dragSlot
				: i < dragFrom && i >= to ? dragSlot
				: 0f;

			panels[i].Style.Left = Length.Pixels( shift );
			panels[i].SetClass( "dragging", i == dragFrom );
		}
	}

	/// <summary>
	/// Put the tabs back in their places and, if the dragged one was dropped somewhere new, move it there. The tab bar is
	/// drawn again in the new order.
	/// </summary>
	void EndTabDrag( List<Panel> panels, int to )
	{
		foreach ( var panel in panels )
		{
			panel.Style.Left = null;
			panel.SetClass( "dragging", false );
		}

		if ( TabBar.IsValid() )
			TabBar.SetClass( "reordering", false );

		if ( dragMoved && to != dragFrom )
			Tabs.Move( dragTab, to );

		dragHandle = null;
		dragTab = null;
		dragMoved = false;
	}

	/// <summary>A tab shows its page's title, and "New tab" while the page has none.</summary>
	static string TabTitle( WebBrowserViewModel tab ) => tab.UiState.Title is { Length: > 0 } title ? title : "New tab";

	/// <summary>
	/// A text file's text is selected with the mouse (its page allows child selection), and Ctrl+C copies the selection to
	/// this player's clipboard. The keys are read here: the browser keeps them on this client
	/// (<c>Navi.Input.KeepLocalAsync</c>), so no shortcut reaches the app, and the clipboard is this client's anyway.
	/// </summary>
	void TickFileText()
	{
		if ( !FileText.IsValid() )
			return;

		var ctrl = Input.Keyboard.Down( "CTRL" ) || Input.Keyboard.Down( "RCTRL" );
		if ( Navi.HasInput && ctrl && Input.Keyboard.Pressed( "c" ) && FileText.GetSelectedText() is { Length: > 0 } selected )
			Clipboard.SetText( selected );
	}

	/// <summary>
	/// Scale the game to the biggest it fits in its area. Layout boxes ignore transforms, so the board keeps its own size to
	/// measure, and the area centers it; scaled to fit the area, it never reaches the message above. What the panel does to
	/// its own tree, like Pac-Man's frame.
	/// </summary>
	void ScaleBoard()
	{
		if ( !DinoArea.IsValid() || DinoArea.Box.Rect.Width <= 0f || DinoArea.Box.Rect.Height <= 0f || Board.Box.Rect.Width <= 0f )
			return;

		var scale = System.MathF.Min( DinoArea.Box.Rect.Width * 0.95f / Board.Box.Rect.Width,
			DinoArea.Box.Rect.Height * 0.95f / Board.Box.Rect.Height );

		if ( !float.IsFinite( scale ) || scale <= 0f )
			return;

		if ( Board == scaledBoard && Board.Style.Transform is not null && System.MathF.Abs( scale - boardScale ) < 0.001f )
			return;

		boardScale = scale;
		scaledBoard = Board;
		var transform = new PanelTransform();
		transform.AddScale( scale );
		Board.Style.Transform = transform;
	}

	/// <summary>
	/// The address field reports every edit here. Typing doesn't redraw; Enter loads.
	/// </summary>
	void AddressEdited( string text ) => ViewModel.SetAddressText( text );

	/// <summary>
	/// Only the host's copy hears these.
	/// </summary>
	protected override void OnNetworkChanged( bool online )
	{
		if ( !Navi.IsViewer )
			Shared.NetworkChanged( online );
	}

	/// <summary>The page area, a drop zone: a file dropped on it opens in the tab shown.</summary>
	Panel Content;

	/// <summary>The arrow shown between tabs while a file is dragged over the tab bar.</summary>
	Panel InsertMarker;

	/// <summary>The width of the arrow, in panel pixels, which is centered on the gap between tabs.</summary>
	const float InsertWidth = 16f;

	protected override void OnDragEnter( Navi.DragEvent e ) => ShowInsert( e );

	protected override void OnDragOver( Navi.DragEvent e ) => ShowInsert( e );

	protected override void OnDragLeave( Navi.DragEvent e ) => HideInsert();

	protected override void OnDrop( Navi.DragEvent e )
	{
		HideInsert();

		if ( Navi.IsWatching || e.Payload.Files is not { Count: > 0 } paths )
			return;

		if ( e.Zone == TabBar && Tabs.CanAdd )
			Tabs.OpenDroppedAt( paths, SlotAt( e.Position.x ) );
		else
			Tabs.OpenDropped( paths );
	}

	/// <summary>
	/// Where a tab dropped at <paramref name="x"/> (in the tab bar's panel pixels) would go: after each tab whose middle is left
	/// of it. 0 is before the first.
	/// </summary>
	int SlotAt( float x )
	{
		var slot = 0;
		foreach ( var panel in TabPanels )
		{
			var middle = ((panel.Box.Rect.Left + panel.Box.Rect.Right) * 0.5f - TabBar.Box.Rect.Left) * TabBar.ScaleFromScreen;
			if ( x > middle )
				slot++;
		}

		return slot;
	}

	/// <summary>
	/// Show the arrow where a file dragged over the tab bar would open its tab, like a tab strip does: between the tabs the
	/// mouse is nearest.
	/// </summary>
	void ShowInsert( Navi.DragEvent e )
	{
		var panels = TabPanels;
		if ( e.Zone != TabBar || !Tabs.CanAdd || panels.Count == 0 || !InsertMarker.IsValid() )
		{
			HideInsert();
			return;
		}

		var slot = SlotAt( e.Position.x );
		var edge = slot == 0 ? panels[0].Box.Rect.Left : panels[slot - 1].Box.Rect.Right;
		var left = (edge - TabBar.Box.Rect.Left) * TabBar.ScaleFromScreen - InsertWidth * 0.5f;

		InsertMarker.Style.Left = Length.Pixels( left );
		InsertMarker.SetClass( "shown", true );
	}

	void HideInsert()
	{
		if ( InsertMarker.IsValid() )
			InsertMarker.SetClass( "shown", false );
	}

	protected override void OnAction( string action, string[] args )
	{
		if ( !Navi.IsViewer )
			Shared.Act( action, args );
	}

	protected override int BuildHash() => System.HashCode.Combine( Tabs.Revision, Navi.IsWatching, SharedState.Online, SharedState.OfflineHint, SharedState.DinoShown );
}
