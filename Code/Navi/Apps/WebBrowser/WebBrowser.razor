@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A built-in Navi app like any other: a plain panel, described by Assets/navi/apps/webbrowser.napp. It asks the computer *@
@* only whether it is online, and sets the window title. The page itself is the engine's WebPanel. Offline it shows Dino *@
@* Run instead (DinoRunGame), as Chrome does. *@
@* It isn't shared: a web page is drawn from the client's own pixels, so each player browses on their own copy. *@

<root>
	@if ( Navi.IsWatching )
	{
		<div class="private">
			<i>visibility_off</i>
			<label>This player is browsing the internet privately.</label>
		</div>
	}
	else
	{
		<div class="toolbar">
			<div class="button @( UiState.CanGoBack ? "" : "disabled" )" tooltip="Back" @onclick=@( () => ViewModel.GoBack() )>
				<i>arrow_back</i>
			</div>
			<div class="button @( UiState.CanGoForward ? "" : "disabled" )" tooltip="Forward" @onclick=@( () => ViewModel.GoForward() )>
				<i>arrow_forward</i>
			</div>
			<div class="button" tooltip="Reload" @onclick=@( () => ViewModel.Reload() )>
				<i>refresh</i>
			</div>
			<div class="button" tooltip="Home" @onclick=@( () => ViewModel.GoHome() )>
				<i>home</i>
			</div>

			<div class="address">
				<TextEntry Value=@( UiState.AddressText ) Placeholder="Search or enter an address"
				           OnTextEdited=@AddressEdited
				           onsubmit=@( () => ViewModel.SubmitAddress() )/>
			</div>
		</div>

		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => ViewModel.DismissNotice() )>
				@UiState.Notice
			</div>
		}

		@if ( UiState.Online is false )
		{
			<div class="offline">
				<div class="offline-text">
					<i>wifi_off</i>
					<label>No internet. This computer needs a network card to reach the web.</label>
				</div>
				<div class="dino-area" @ref="DinoArea">
					<DinoRunBoard @ref="Board" Clicked=@( () => Dino.Click() )></DinoRunBoard>
				</div>
			</div>
		}
		else if ( UiState.Online is true )
		{
			<WebPanel @ref="Web" class="page"/>
		}
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state. Made on first use: its calls to the computer are made with the app's own panel, which
	/// is this.
	/// </summary>
	WebBrowserViewModel ViewModel => field ??= new(Navi);

	/// <summary>
	/// What is drawn above. Read only: the view model replaces it, and its revision is what makes this panel redraw.
	/// </summary>
	WebBrowserUiState UiState => ViewModel.UiState;

	WebPanel Web;

	/// <summary>The room below the offline message, which the game is scaled to fill.</summary>
	Panel DinoArea;
	DinoRunBoard Board;
	float boardScale;

	/// <summary>
	/// The offline game. Made the first time the computer is offline, and kept, so a best score lasts while the window does.
	/// </summary>
	DinoRunGame Dino => field ??= new(Navi);

	/// <summary>The <see cref="WebBrowserUiState.LoadId"/> the page was last told to load.</summary>
	int loadedId = -1;

	/// <summary>
	/// The page is a panel of the engine, so loading into it and reading which address it is on are done here, between it
	/// and the view model. Neither is app state.
	/// </summary>
	public override void Tick()
	{
		base.Tick();

		if ( UiState.Online is false && !Navi.IsWatching && Board.IsValid() )
		{
			Dino.Tick( Time.Delta, Navi.HasInput );
			Board.DrawFrame( Dino.Frame );
			ScaleBoard();
		}

		if ( Navi.IsWatching || !Web.IsValid() )
		{
			// The page is made again when the player is back, and loads the address again.
			loadedId = -1;
			return;
		}

		if ( loadedId != UiState.LoadId )
		{
			loadedId = UiState.LoadId;
			Load( UiState.Url );
		}

		ViewModel.PageChanged( Web.Surface?.Url, Web.Surface?.PageTitle );
	}

	/// <summary>
	/// Scale the game to the biggest it fits in its area. Layout boxes ignore transforms, so the board keeps its own size to
	/// measure, and the area centers it; scaled to fit the area, it never reaches the message above. What the panel does to
	/// its own tree, like Pac-Man's frame.
	/// </summary>
	void ScaleBoard()
	{
		if ( !DinoArea.IsValid() || DinoArea.Box.Rect.Width <= 0f || DinoArea.Box.Rect.Height <= 0f || Board.Box.Rect.Width <= 0f )
			return;

		var scale = System.MathF.Min( DinoArea.Box.Rect.Width * 0.95f / Board.Box.Rect.Width,
			DinoArea.Box.Rect.Height * 0.95f / Board.Box.Rect.Height );

		if ( !float.IsFinite( scale ) || scale <= 0f || System.MathF.Abs( scale - boardScale ) < 0.001f )
			return;

		boardScale = scale;
		var transform = new PanelTransform();
		transform.AddScale( scale );
		Board.Style.Transform = transform;
	}

	/// <summary>
	/// The engine refuses addresses it doesn't allow, and says so by throwing.
	/// </summary>
	void Load( string url )
	{
		try
		{
			Web.Url = url;
		}
		catch ( System.Exception e )
		{
			ViewModel.LoadFailed( e.Message );
		}
	}

	/// <summary>
	/// The address field reports every edit here. Typing doesn't redraw; Enter loads.
	/// </summary>
	void AddressEdited( string text ) => ViewModel.SetAddressText( text );

	protected override void OnNetworkChanged( bool online ) => ViewModel.NetworkChanged( online );

	protected override int BuildHash() => System.HashCode.Combine( ViewModel.Revision, Navi.IsWatching );
}
