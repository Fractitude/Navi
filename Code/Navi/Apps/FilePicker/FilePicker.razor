@using Sandbox.UI
@inherits Panel
@namespace NaviApps

@* A file picker dialog an app puts inside its own panel (see FilePickerViewModel). It covers the app while open. It only *@
@* lists and chooses: the app gets the path and reads the file with its own permissions. *@

@if ( Model is { UiState.IsOpen: true } )
{
	<root>
		<div class="dialog">
			<div class="header">
				<div class="tool @( UiState.Path == "/" ? "disabled" : "" )" @onclick=@( () => Model.Up() )>
					<i>arrow_upward</i>
				</div>
				<div class="path">@UiState.Path</div>
			</div>

			@if ( UiState.Notice != "" )
			{
				<div class="notice">@UiState.Notice</div>
			}

			<div class="list">
				@foreach ( var row in UiState.Rows )
				{
					<div class="row @( row.Path == UiState.Selected ? "selected" : "" )"
					     @onclick=@( () => Model.Select( row.Path ) )
					     @ondoubleclick=@( () => Model.Activate( row.Path ) )>
						<i class="icon">@row.Icon</i>
						<div class="name">@row.Name</div>
					</div>
				}
			</div>

			<div class="footer">
				<div class="button" @onclick=@( () => Model.Cancel() )>Cancel</div>
				<div class="button" @onclick=@( () => Model.Confirm() )>Open</div>
			</div>
		</div>
	</root>
}

@code
{
	/// <summary>
	/// The app's picker. The app must also fold <see cref="FilePickerViewModel.Revision"/> into its own BuildHash.
	/// </summary>
	public FilePickerViewModel Model { get; set; }

	FilePickerUiState UiState => Model.UiState;

	protected override int BuildHash() => Model?.Revision ?? 0;
}
