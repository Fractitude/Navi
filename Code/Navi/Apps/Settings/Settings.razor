@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* The computer's settings: a sidebar of pages, and the page that is open. A core app (Assets/navi/apps/settings.napp), *@
@* so it has root and can change them. Like Packages, the panel only draws SettingsUiState, and its controls are *@
@* actions (Navi.Act) the view model runs: it is shared, so in multiplayer only the host's copy has a view model. *@

<root>
	<div class="sidebar">
		@foreach ( var category in UiState.Categories )
		{
			<div class="category @( category.Selected ? "active" : "" )"
			     @onclick=@( () => Navi.Act( SettingsViewModel.OpenCategoryAction, category.Key.ToString() ) )>
				<i>@category.Icon</i>
				<div class="label">@category.Label</div>
			</div>
		}
	</div>

	<div class="page">
		@if ( UiState.Notice is not null )
		{
			<div class="notice" @onclick=@( () => Navi.Act( SettingsViewModel.DismissNoticeAction ) )>
				@UiState.Notice
			</div>
		}

		@switch ( UiState.Category )
		{
			case SettingsCategory.Display:
				<div class="heading">Display</div>

				<div class="setting">
					<div class="name">Scale</div>
					<div class="description">Make text, windows and the taskbar bigger or smaller.</div>

					<div class="options">
						@foreach ( var option in UiState.ScaleOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseScaleAction, option.Scale.ToString( System.Globalization.CultureInfo.InvariantCulture ) ) )>
								@option.Label
							</div>
						}
					</div>
				</div>
				break;

			case SettingsCategory.Windows:
				<div class="heading">Windows</div>

				<div class="setting">
					<div class="name">Snap to screen edges</div>
					<div class="description">Windows you move or resize stick to the edges of the screen.</div>
					<div class="options">
						@foreach ( var option in UiState.SnapScreenOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseSnapScreenAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting">
					<div class="name">Snap to windows</div>
					<div class="description">Windows you move or resize stick to the edges of other windows.</div>
					<div class="options">
						@foreach ( var option in UiState.SnapWindowsOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseSnapWindowsAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting @( UiState.SnapsToAnything ? "" : "unavailable" )">
					<div class="name">Snap distance</div>
					<div class="description">How close an edge has to get before it snaps. Applies to both.</div>
					<div class="options">
						@foreach ( var option in UiState.SnapDistanceOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseSnapDistanceAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>
				break;

			case SettingsCategory.Notifications:
				<div class="heading">Notifications</div>

				<div class="setting">
					<div class="name">Apps</div>
					<div class="description">A muted app's notifications go to the list quietly.</div>
				</div>

				@foreach ( var row in UiState.NotificationApps )
				{
					<div class="app-row">
						<div class="icon" style="background-color: @row.Color;"><i>@row.Icon</i></div>
						<div class="name">@row.Name</div>
						<div class="options">
							@foreach ( var option in row.Options )
							{
								<div class="option @( option.Selected ? "active" : "" )"
								     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseMutedAction, row.AppId, option.Value.ToString() ) )>
									@option.Label
								</div>
							}
						</div>
					</div>
				}

				@if ( UiState.NotificationApps.Count == 0 )
				{
					<div class="empty">No apps are installed.</div>
				}
				break;

			case SettingsCategory.Security:
				<div class="heading">Security</div>

				<div class="big-item" @onclick=@( () => Navi.Settings.OpenLockSetup() )>
					<i>password</i>
					<div class="text">
						<div class="name">Lock-screen password</div>
						<div class="description">Change how you unlock the screen.</div>
					</div>
					<i class="chevron">chevron_right</i>
				</div>
				break;

			case SettingsCategory.Hardware:
				<div class="heading">Hardware</div>

				<div class="setting">
					<div class="name">Network</div>
					<div class="description">@UiState.NetworkText</div>
				</div>

				<div class="setting">
					<div class="name">Installed</div>
					<div class="description">The game installs and removes hardware. Apps can't.</div>
				</div>

				@foreach ( var row in UiState.HardwareRows )
				{
					<div class="app-row" tooltip=@row.Description>
						<div class="icon"><i>@row.Icon</i></div>
						<div class="name">@row.Name</div>
					</div>
				}

				@if ( UiState.HardwareRows.Count == 0 )
				{
					<div class="empty">No hardware is installed.</div>
				}
				break;

			case SettingsCategory.Theming:
				<div class="heading">Theming</div>

				<div class="setting">
					<div class="name">Wallpaper</div>
					<div class="description">The picture behind the windows.</div>
					<div class="options">
						@foreach ( var option in UiState.WallpaperOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseWallpaperAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting">
					<div class="name">Theme</div>
					<div class="description">How the desktop, windows and apps look.</div>
					<div class="options">
						@foreach ( var option in UiState.ThemeOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseThemeAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting">
					<div class="name">Color scheme</div>
					<div class="description">Light or dark, in every theme.</div>
					<div class="options">
						@foreach ( var option in UiState.SchemeOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseSchemeAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting @( UiState.IsGlass ? "" : "unavailable" )">
					<div class="name">Blur</div>
					<div class="description">How much windows and menus blur what is behind them. Glass only.</div>
					<div class="options">
						@foreach ( var option in UiState.BlurOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseBlurAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>

				<div class="setting @( UiState.IsGlass ? "" : "unavailable" )">
					<div class="name">Transparency</div>
					<div class="description">How much shows through windows and menus. None is solid. Glass only.</div>
					<div class="options">
						@foreach ( var option in UiState.TransparencyOptions )
						{
							<div class="option @( option.Selected ? "active" : "" )"
							     @onclick=@( () => Navi.Act( SettingsViewModel.ChooseTransparencyAction, option.Value.ToString() ) )>
								@option.Label
							</div>
						}
					</div>
				</div>
				break;
		}
	</div>
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only. Made on first use: calls need the panel, which is this.
	/// </summary>
	SettingsViewModel ViewModel => field ??= new(Navi);

	/// <summary>
	/// What is drawn above. Read only: the view model's, or on a viewer what the host's copy published.
	/// </summary>
	SettingsUiState UiState => Navi.IsViewer ? Navi.GetState<SettingsUiState>() ?? SettingsUiState.Empty : ViewModel.UiState;

	public override void Tick()
	{
		base.Tick();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
