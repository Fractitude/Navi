@using Sandbox.UI
@inherits NaviApp
@namespace Sandbox
@attribute [NaviApp( "pacman", "Pac-Man", Description = "Eat the dots, dodge the ghosts. WASD to move, hold Esc to quit.", Icon = "videogame_asset", Color = "#f2d64a", CanMaximize = false, CanResize = false, CapturesInput = true )]

<root>
	<div class="hud">
		<div class="score">@(Board?.Score ?? 0)</div>
		<div class="level">LEVEL @(Board?.Level ?? 1)</div>
		<div class="lives">
			@for ( var i = 0; i < (Board?.Lives ?? 0) - 1; i++ )
			{
				<div class="life"></div>
			}
		</div>
	</div>

	<div class="stage">
		<PacManBoard @ref="Board"></PacManBoard>

		@if ( Message is { } message )
		{
			<div class="message">@message</div>
		}
	</div>
</root>

@code
{
	PacManBoard Board;

	/// <summary>
	/// The game runs only while this window has the player's input.
	/// </summary>
	bool HasInput => Computer?.InputCapture is { } capture && capture.App.Id == Info?.Id;

	string Message => Board?.State switch
	{
		_ when !HasInput => "PAUSED",
		PacManBoard.GameState.Ready => "READY!",
		PacManBoard.GameState.GameOver => "GAME OVER - PRESS A KEY",
		_ => null,
	};

	public override void Tick()
	{
		base.Tick();

		if ( Board is not null )
			Board.HasInput = HasInput;
	}

	protected override int BuildHash() => System.HashCode.Combine( Board?.Score, Board?.Lives, Board?.Level, Board?.State, HasInput );
}
