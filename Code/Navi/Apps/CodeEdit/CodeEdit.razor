@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A code editor (a ScriptControl) for the computer's files. A prepackaged app (Assets/navi/apps/codeedit.napp) that asks for *@
@* Files access, and opens code files from the file explorer. It is shared, because only the host has the files: the *@
@* panel draws CodeEditUiState, and its controls are actions (Navi.Act) that the host's copy runs. *@

<root>
	<div class="toolbar">
		<div class="tool" tooltip="New (Ctrl+N)" @onclick=@( () => Navi.Act( CodeEditViewModel.NewAction ) )>
			<i>note_add</i>
		</div>
		<div class="tool" tooltip="Open (Ctrl+O)" @onclick=@( () => Navi.Act( CodeEditViewModel.OpenAction ) )>
			<i>folder_open</i>
		</div>
		<div class="tool" tooltip="Save (Ctrl+S)" @onclick=@( () => Navi.Act( CodeEditViewModel.SaveAction ) )>
			<i>save</i>
		</div>
		<div class="tool" tooltip="Save as (Ctrl+Shift+S)" @onclick=@( () => Navi.Act( CodeEditViewModel.SaveAsAction ) )>
			<i>save_as</i>
		</div>

		<div class="divider"></div>

		@* Not "disabled": that class takes the mouse, and the tooltip says why it can't be used. *@
		<div class="tool @( UiState.ScriptingEnabled ? "" : "unavailable" )"
		     tooltip="@( UiState.ScriptingEnabled ? "Run" : "Running scripts is disabled" )"
		     @onclick=@Run>
			<i>play_arrow</i>
		</div>

		<div class="divider"></div>

		<div class="tool @( Editor is { CanUndo: true } ? "" : "disabled" )" tooltip="Undo (Ctrl+Z)" @onclick=@Undo>
			<i>undo</i>
		</div>
		<div class="tool @( Editor is { CanRedo: true } ? "" : "disabled" )" tooltip="Redo (Ctrl+Y)" @onclick=@Redo>
			<i>redo</i>
		</div>

		<div class="divider"></div>

		<div class="tool" tooltip="Settings" @onclick=@( () => Navi.Act( CodeEditViewModel.OpenSettingsAction ) )>
			<i>settings</i>
		</div>
	</div>

	@if ( UiState.BarOpen )
	{
		<div class="bar">
			<i>save_as</i>
			<div class="bar-label">Save as</div>
			<TextEntry @ref="BarEntry" Value=@( UiState.BarText ) MaxLength=@( 1024 )
			           OnTextEdited=@BarEdited
			           onsubmit=@( () => Navi.Act( CodeEditViewModel.SubmitBarAction ) )/>
			<div class="tool" tooltip="Save"
			     @onclick=@( () => Navi.Act( CodeEditViewModel.SubmitBarAction ) )>
				<i>check</i>
			</div>
			<div class="tool" tooltip="Cancel" @onclick=@( () => Navi.Act( CodeEditViewModel.CancelBarAction ) )>
				<i>close</i>
			</div>
		</div>
	}

	@if ( UiState.Notice is not null )
	{
		<div class="notice" @onclick=@( () => Navi.Act( CodeEditViewModel.DismissNoticeAction ) )>
			@UiState.Notice
		</div>
	}

	<div class="page">
		<ScriptControl @ref="Editor" class="document @( IsCSharp ? "" : "plain" ) @( UiState.LightTheme ? "light" : "" )"
		               ShowStatusBar=@( UiState.ShowStatusBar ) TabSize=@( UiState.TabSize )
		               DiagnosticDelay=@( IsCSharp ? DiagnosticDelay : float.PositiveInfinity )
		               OnSourceChanged=@SourceEdited/>
	</div>

	<div class="status">@UiState.Status</div>

	@if ( UiState.SettingsOpen )
	{
		<div class="confirm-backdrop">
			<div class="confirm settings">
				<div class="settings-title">Settings</div>

				<div class="setting">
					<div class="setting-label">Theme</div>
					<div class="choices">
						@foreach ( var theme in System.Enum.GetValues<CodeEditTheme>() )
						{
							<div class="choice @( UiState.Theme == theme ? "selected" : "" )"
							     @onclick=@( () => Navi.Act( CodeEditViewModel.SetThemeAction, theme.ToString() ) )>
								@theme
							</div>
						}
					</div>
				</div>

				<div class="setting">
					<div class="setting-label">Tab size</div>
					<div class="choices">
						<div class="choice @( UiState.TabSize <= CodeEditViewModel.MinTabSize ? "disabled" : "" )"
						     @onclick=@( () => Navi.Act( CodeEditViewModel.SetTabSizeAction, ( UiState.TabSize - 1 ).ToString() ) )>
							-
						</div>
						<div class="tab-size">@UiState.TabSize</div>
						<div class="choice @( UiState.TabSize >= CodeEditViewModel.MaxTabSize ? "disabled" : "" )"
						     @onclick=@( () => Navi.Act( CodeEditViewModel.SetTabSizeAction, ( UiState.TabSize + 1 ).ToString() ) )>
							+
						</div>
					</div>
				</div>

				<div class="setting">
					<div class="setting-label">Show status bar</div>
					<div class="choices">
						<div class="choice @( UiState.ShowStatusBar ? "selected" : "" )"
						     @onclick=@( () => Navi.Act( CodeEditViewModel.ToggleStatusBarAction ) )>
							@( UiState.ShowStatusBar ? "On" : "Off" )
						</div>
					</div>
				</div>

				<div class="confirm-buttons">
					<div class="button" @onclick=@( () => Navi.Act( CodeEditViewModel.CloseSettingsAction ) )>Close</div>
				</div>
			</div>
		</div>
	}

	@if ( UiState.Confirming )
	{
		<div class="confirm-backdrop">
			<div class="confirm">
				<div class="confirm-text">@UiState.ConfirmText</div>
				<div class="confirm-buttons">
					<div class="button" @onclick=@( () => Navi.Act( CodeEditViewModel.CancelConfirmAction ) )>Cancel</div>
					@if ( UiState.ConfirmOtherLabel is not null )
					{
						<div class="button" @onclick=@( () => Navi.Act( CodeEditViewModel.ConfirmOtherAction ) )>
							@UiState.ConfirmOtherLabel
						</div>
					}
					<div class="button danger" @onclick=@( () => Navi.Act( CodeEditViewModel.ConfirmAction ) )>
						@UiState.ConfirmLabel
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only.
	/// </summary>
	CodeEditViewModel ViewModel => field ??= new( Navi );

	/// <summary>
	/// What is drawn above. Read only: the view model's, or on a viewer what the host's copy published.
	/// </summary>
	CodeEditUiState UiState => Navi.IsViewer ? Navi.GetState<CodeEditUiState>() ?? CodeEditUiState.Empty : ViewModel.UiState;

	ScriptControl Editor;
	TextEntry BarEntry;

	/// <summary>The editor's own wait before it shows diagnostics, in seconds.</summary>
	const float DiagnosticDelay = 0.75f;

	/// <summary>
	/// The document is C#, the only language the editor's analysis knows (Game.Scripting). An untitled document counts,
	/// since it is saved as .cs. Any other file keeps the colours, but gets no diagnostics, completion or popups.
	/// </summary>
	bool IsCSharp => UiState.Path is not { } path || path.EndsWith( ".cs", System.StringComparison.OrdinalIgnoreCase );

	/// <summary>The theme the editor was last given, so it is only set again when it changes.</summary>
	bool? appliedLight;

	static readonly ScriptControl.ThemeDefinition LightTheme = ScriptControl.ThemeDefinition.Default with
	{
		Foreground = new Color( 0.12f, 0.12f, 0.12f ),
		Keyword = new Color( 0f, 0f, 0.8f ),
		Number = new Color( 0.03f, 0.53f, 0.34f ),
		String = new Color( 0.64f, 0.08f, 0.08f ),
		Comment = new Color( 0f, 0.5f, 0f ),
		Identifier = new Color( 0.0f, 0.06f, 0.5f ),
		Type = new Color( 0.15f, 0.5f, 0.6f ),
		Member = new Color( 0.47f, 0.37f, 0.07f ),
		ControlFlow = new Color( 0.69f, 0.0f, 0.64f ),
		Selection = new Color( 0.68f, 0.84f, 1f ),
		CurrentLine = new Color( 0.93f, 0.93f, 0.93f ),
		LineNumber = new Color( 0.45f, 0.45f, 0.45f ),
		ActiveLineNumber = new Color( 0.1f, 0.1f, 0.1f ),
		ActiveParameter = new Color( 0f, 0f, 0f ),
		Background = new Color( 1f, 1f, 1f ),
		GutterBackground = new Color( 1f, 1f, 1f ),
		Caret = new Color( 0f, 0f, 0f ),
		PopupBackground = new Color( 0.95f, 0.95f, 0.95f ),
		PopupBorder = new Color( 0.78f, 0.78f, 0.78f ),
		PopupShadow = new Color( 0f, 0f, 0f, 0.2f ),
		CompletionSelectedBackground = new Color( 0.0f, 0.38f, 0.7f ),
		CompletionHoverBackground = new Color( 0.88f, 0.88f, 0.9f ),
		SymbolIcon = new Color( 0.45f, 0.2f, 0.7f ),
		PopupTitle = new Color( 0.15f, 0.5f, 0.6f ),
		PopupDescription = new Color( 0.12f, 0.12f, 0.12f ),
		MutedForeground = new Color( 0.4f, 0.4f, 0.4f ),
		SignatureForeground = new Color( 0.3f, 0.3f, 0.3f ),
	};

	/// <summary>
	/// Undo and redo are the editor's own, kept by the panel. The change they make comes back through
	/// <see cref="SourceEdited"/> like typing, so the host's document follows.
	/// </summary>
	void Undo() => Editor?.Undo();

	void Redo() => Editor?.Redo();

	/// <summary>
	/// Run the document as a script. The computer lets it only while the game has scripting on; the host's copy checks too.
	/// </summary>
	void Run()
	{
		if ( UiState.ScriptingEnabled )
			Navi.Act( CodeEditViewModel.RunAction );
	}

	/// <summary>
	/// Give the editor the saved theme, once it is known and whenever it changes. The preference is the app's, so every
	/// player at a shared computer sees the same one.
	/// </summary>
	void ApplyTheme()
	{
		if ( Editor is null || !UiState.ThemeKnown || appliedLight == UiState.LightTheme )
			return;

		appliedLight = UiState.LightTheme;
		Editor.Theme = UiState.LightTheme ? LightTheme : ScriptControl.ThemeDefinition.Default;
	}

	/// <summary>
	/// What the text field held when it last reported an edit, and the text session it was for. The edits sent are worked
	/// out from it, so it is view plumbing, not state: it follows <see cref="CodeEditUiState.Text"/> whenever the field
	/// doesn't have the caret, or the text is replaced (<see cref="SyncText"/>). While the player types, it is what the
	/// field shows; the host's text is a keystroke or so behind, and pushing it would move the caret back.
	/// </summary>
	string sentText;

	int sentSession = -1;

	/// <summary>The <see cref="CodeEditUiState.BarSession"/> the path field was last focused for.</summary>
	int focusedBar;

	/// <summary>The <see cref="CodeEditUiState.TextSession"/> the text field was last focused for.</summary>
	int focusedText = -1;

	/// <summary>The editor, or something inside it, has the caret. A script control wraps its own text field.</summary>
	bool EditorFocused => Editor is not null && InputFocus.Current is Panel focus && (focus == Editor || focus.IsAncestor( Editor ));

	public override void Tick()
	{
		base.Tick();

		SyncText();
		FocusFields();
		HideIntelliSense();
		FixPopups();
		ApplyTheme();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.Published );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	/// <summary>
	/// The host's copy gets the player's keyboard shortcuts, from whichever client they're on. Ctrl+S and the others come
	/// even while the text has the caret.
	/// </summary>
	protected override void OnShortcut( string keys ) => ViewModel.Shortcut( keys );

	/// <summary>
	/// Ctrl+S and Ctrl+Shift+S typed in the text field. The field has the keys then, and they may not reach the shortcut
	/// forwarding (<c>NaviInputCapture</c>), so they are caught here too, as actions that work from any client.
	/// </summary>
	public override void OnButtonTyped( ButtonEvent e )
	{
		if ( e.HasCtrl && !e.HasAlt && string.Equals( e.Button, "s", System.StringComparison.OrdinalIgnoreCase ) )
		{
			Navi.Act( e.HasShift ? CodeEditViewModel.SaveAsAction : CodeEditViewModel.SaveAction );
			e.StopPropagation = true;
			return;
		}

		base.OnButtonTyped( e );
	}

	/// <summary>
	/// The player is closing the window while there are unsaved changes: the host's copy asks them in the window.
	/// </summary>
	protected override void OnCloseRequested() => ViewModel.CloseRequested();

	/// <summary>
	/// The editor has no setting to turn off completion, hover text or parameter help, so for a file that isn't C# they
	/// are closed every frame. They open on a key or the mouse, before the frame's ticks, so none is ever drawn. Closing
	/// also forgets the hovered word, so the hover text's delay never runs out.
	/// </summary>
	void HideIntelliSense()
	{
		if ( Editor is not null && !IsCSharp )
			Editor.DismissIntelliSense();
	}

	/// <summary>
	/// The editor's completion, hover and signature popups are put where the caret is, but the engine works out where
	/// as if the root panel started at 0,0. A world panel's root starts at minus half its size, so they all land in the
	/// root's top left corner. This moves each by the difference, with a transform, which the engine leaves alone.
	/// </summary>
	void FixPopups()
	{
		if ( Editor is null || FindRootPanel() is not { } root )
			return;

		var origin = root.Box.Rect.Position;
		if ( origin.x == 0f && origin.y == 0f )
			return;

		// How far each popup was moved this frame, for the ones placed beside another.
		var moved = new Dictionary<Popup, Vector2>();

		foreach ( var popup in root.Children.OfType<Popup>() )
		{
			// The editor's popups: a completion list, its detail beside it, hover text and parameter help.
			if ( !popup.HasClass( "script-control-popup" ) || popup.AnchorRect is not { } anchor
				|| popup.PopupSource is not { } source )
				continue;

			var scale = source.ScaleFromScreen;

			// A popup beside another is anchored to where the engine laid that one out, not to where it was moved.
			if ( source is Popup beside && moved.TryGetValue( beside, out var by ) )
				anchor = new Rect( anchor.Position + by / scale, anchor.Size );

			var bounds = new Rect( Vector2.Zero, root.Box.Rect.Size * scale );
			var shifted = new Rect( anchor.Position - origin, anchor.Size ) * scale;
			var wanted = PlaceBeside( shifted, popup.Box.Rect.Size * scale, bounds,
				popup.HasClass( "right-top" ), popup.Position.ToString().StartsWith( "Above" ), popup.PopupSourceOffset );

			// Where the engine put it: its left and top.
			var left = popup.Style.Left is { } l ? l.Value : 0f;
			var top = popup.Style.Top is { } t ? t.Value : 0f;

			var move = new PanelTransform();
			move.AddTranslate( wanted.x - left, wanted.y - top );
			popup.Style.Transform = move;
			moved[popup] = new Vector2( wanted.x - left, wanted.y - top );
		}
	}

	/// <summary>
	/// Where a popup of this size goes next to the anchor, as the engine does it (it keeps that to itself): below it (or above, for hover text), or
	/// the other side if there's no room, or (<paramref name="beside"/>) to its right, or left if there's no room; kept inside
	/// <paramref name="bounds"/>.
	/// </summary>
	static Vector2 PlaceBeside( Rect anchor, Vector2 size, Rect bounds, bool beside, bool above, float offset )
	{
		float x, y;
		if ( beside )
		{
			x = anchor.Right + offset;
			if ( x + size.x > bounds.Right && anchor.Left - offset - size.x >= bounds.Left )
				x = anchor.Left - offset - size.x;

			y = anchor.Top;
		}
		else if ( above )
		{
			y = anchor.Top - offset - size.y;
			if ( y < bounds.Top && anchor.Bottom + offset + size.y <= bounds.Bottom )
				y = anchor.Bottom + offset;

			x = anchor.Left;
		}
		else
		{
			y = anchor.Bottom + offset;
			if ( y + size.y > bounds.Bottom && anchor.Top - offset - size.y >= bounds.Top )
				y = anchor.Top - offset - size.y;

			x = anchor.Left;
		}

		return new Vector2( System.Math.Clamp( x, bounds.Left, System.Math.Max( bounds.Left, bounds.Right - size.x ) ),
			System.Math.Clamp( y, bounds.Top, System.Math.Max( bounds.Top, bounds.Bottom - size.y ) ) );
	}

	void SyncText()
	{
		if ( Editor is null )
			return;

		var focused = EditorFocused;
		if ( UiState.TextSession == sentSession && focused )
			return;

		sentSession = UiState.TextSession;
		sentText = UiState.Text;

		// The editor keeps the player's typing while it has the caret, and takes the host's text otherwise. Setting the
		// source clears its undo history, so it is only set when it differs.
		if ( Editor.Source != sentText )
			Editor.Source = sentText;
	}

	/// <summary>
	/// The text field reports every edit here. Only what changed goes to the host, as one or more edit actions: the
	/// characters before and after that are the same are left out.
	/// </summary>
	void SourceEdited( string source )
	{
		var text = source ?? "";
		var before = sentText ?? UiState.Text;
		sentText = text;

		if ( text == before )
			return;

		var start = 0;
		var shortest = System.Math.Min( before.Length, text.Length );
		while ( start < shortest && before[start] == text[start] )
			start++;

		var end = 0;
		while ( end < shortest - start && before[before.Length - 1 - end] == text[text.Length - 1 - end] )
			end++;

		var removed = before.Length - start - end;
		var inserted = text.Substring( start, text.Length - start - end );
		var session = sentSession.ToString();

		// The first action replaces what went, the rest add the rest of a long paste after it.
		var at = start;
		var offset = 0;
		do
		{
			var chunk = inserted.Substring( offset, System.Math.Min( CodeEditViewModel.MaxEditInsert, inserted.Length - offset ) );
			Navi.Act( CodeEditViewModel.EditAction, session, at.ToString(), (offset == 0 ? removed : 0).ToString(), chunk );
			at += chunk.Length;
			offset += chunk.Length;
		} while ( offset < inserted.Length );
	}

	/// <summary>
	/// The path field reports every edit here, as an action, so other players see the path being typed.
	/// </summary>
	void BarEdited( string text ) => Navi.Act( CodeEditViewModel.SetBarTextAction, text );

	/// <summary>
	/// Put the caret in the path field each time it opens, and in the text each time a document opens. Only where the
	/// app runs for the player at the computer (offline, or the host's own seat): on a viewer it would take the keys of
	/// whoever is watching, so a player on a client clicks the field.
	/// </summary>
	void FocusFields()
	{
		if ( !Navi.HasInput || Navi.IsViewer || Navi.IsWatching || UiState.Confirming )
			return;

		if ( UiState.BarOpen && UiState.BarSession != focusedBar && BarEntry is not null )
		{
			focusedBar = UiState.BarSession;
			BarEntry.Focus();
		}
		else if ( !UiState.BarOpen && UiState.TextSession != focusedText && Editor is not null )
		{
			focusedText = UiState.TextSession;
			Editor.FocusEditor();
		}
	}

	/// <summary>
	/// Typing doesn't bump the revision. The fields still follow the host's text, except where they have focus: the
	/// player is typing there.
	/// </summary>
	protected override int BuildHash() =>
		System.HashCode.Combine( UiState.Revision, UiState.TextSession, EditorFocused ? null : UiState.Text,
			BarEntry is { HasFocus: true } ? null : UiState.BarText, Editor?.CanUndo, Editor?.CanRedo );
}
