@using Sandbox.UI
@inherits NaviApp
@namespace NaviApps

@* A Navi app like any other: a plain panel, described by Assets/navi/apps/imageviewer.napp. It opens the pictures the *@
@* player sends it from the file explorer, or a path typed in the field, and shows them scaled to the window. Not shared. *@

<root>
	<div class="bar">
		<TextEntry @ref="PathEntry" Value=@( UiState.PathText ) MaxLength=@( 1024 )
		           OnTextEdited=@PathEdited
		           onsubmit=@( () => ViewModel.SubmitPath() )/>
		<div class="button @( UiState.Loading ? "disabled" : "" )" @onclick=@( () => ViewModel.SubmitPath() )>
			<i>folder_open</i>
			Open
		</div>
	</div>

	@if ( UiState.Notice != "" )
	{
		<div class="notice">@UiState.Notice</div>
	}

	<div class="screen">
		@if ( UiState.HasImage )
		{
			<Image class="picture" Texture=@ViewModel.Picture/>
		}
		else
		{
			<div class="empty">
				<i>image</i>
				<div class="text">No image. Open a .jpg or .png from the Files app, or type its path above.</div>
			</div>
		}
	</div>

	@if ( UiState.HasImage )
	{
		<div class="info">
			<div class="name">@UiState.Name</div>
			<div class="size">@UiState.SizeText</div>
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state. Made on first use, with the panel's Navi (the panel is a NaviApp).
	/// </summary>
	ImageViewerViewModel ViewModel => field ??= new( Navi );

	/// <summary>
	/// What is drawn above. Read only.
	/// </summary>
	ImageViewerUiState UiState => ViewModel.UiState;

	TextEntry PathEntry;

	void PathEdited( string text ) => ViewModel.SetPathText( text );

	public override void Tick()
	{
		base.Tick();

		ViewModel.Tick();
	}

	/// <summary>
	/// Typing doesn't bump the revision. The path field follows the state again whenever a file is opened.
	/// </summary>
	protected override int BuildHash() =>
		System.HashCode.Combine( ViewModel.Revision, PathEntry is { HasFocus: true } ? null : UiState.PathText );
}
