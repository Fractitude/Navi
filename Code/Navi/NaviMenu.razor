@using Sandbox.UI
@inherits Panel
@namespace Sandbox

@* The one right-click menu of the whole OS: the taskbar, the tray, the start menu and the apps all use it, so they look the *@
@* same in every theme. The caller places it (position, and width if it wants one) and closes it when an item is chosen. *@
@* Its styles are in NaviDesktop.razor.scss. *@

<root @onmousedown=@( ( PanelEvent e ) => e.StopPropagation() ) @onclick=@( ( PanelEvent e ) => e.StopPropagation() )>
	@if ( Heading is not null )
	{
		<div class="heading">@Heading</div>
	}

	@foreach ( var item in Items )
	{
		var chosen = item;
		var hasChildren = item.Children is { Count: > 0 };

		@if ( item.Separator )
		{
			<div class="separator"></div>
		}

		<div class="menu-entry">
			<div class="item @( item.Enabled ? "" : "disabled" ) @( item.Danger ? "danger" : "" ) @( hasChildren && Open == item.Id ? "open" : "" )"
			     @onmouseover=@( () => Hover( chosen ) )
			     @onclick=@( () => Choose( chosen ) )>
				@if ( !string.IsNullOrEmpty( item.Icon ) )
				{
					<i>@item.Icon</i>
				}
				<div class="item-label">@item.Label</div>
				@if ( !string.IsNullOrEmpty( item.Keys ) )
				{
					<div class="keys">@item.Keys</div>
				}
				@if ( hasChildren )
				{
					<i class="chevron">chevron_right</i>
				}
			</div>

			@if ( hasChildren && Open == item.Id )
			{
				@* Drawn here, not as another NaviMenu: a component can't include itself. So a submenu has no submenus. *@
				<div class="navi-menu submenu @( SubmenuLeft ? "left" : "right" )">
					@foreach ( var child in item.Children )
					{
						var picked = child;

						<div class="item @( child.Enabled ? "" : "disabled" )" @onclick=@( () => Choose( picked ) )>
							@if ( !string.IsNullOrEmpty( child.Icon ) )
							{
								<i>@child.Icon</i>
							}
							<div class="item-label">@child.Label</div>
							@if ( !string.IsNullOrEmpty( child.Keys ) )
							{
								<div class="keys">@child.Keys</div>
							}
						</div>
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>The bar over the items, or null for none.</summary>
	public string Heading { get; set; }

	/// <summary>Open submenus to the menu's left, for a menu too near the right edge of what it may draw in.</summary>
	public bool SubmenuLeft { get; set; }

	public IReadOnlyList<NaviMenuItem> Items { get; set; } = [];

	/// <summary>Called with the item's id when the player picks an enabled item.</summary>
	public System.Action<string> OnChoose { get; set; }

	// Added here, not on <root>: the class a caller passes (its placement) would replace the root's own.
	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		AddClass( "navi-menu" );
	}

	/// <summary>The id of the item whose submenu is open, or null.</summary>
	string Open;

	void Hover( NaviMenuItem item )
	{
		Open = item.Children is { Count: > 0 } ? item.Id : null;
	}

	void Choose( NaviMenuItem item )
	{
		if ( item.Children is { Count: > 0 } )
			Open = Open == item.Id ? null : item.Id;
		else if ( item.Enabled )
			OnChoose?.Invoke( item.Id );
	}

	protected override int BuildHash() => System.HashCode.Combine( Heading, Open, SubmenuLeft, Items?.Count, Items is null ? 0 : string.Join( '|', Items.Select( x => $"{x.Id}{x.Label}{x.Enabled}" ) ).GetHashCode() );
}
