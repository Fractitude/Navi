@using Sandbox.UI
@inherits Panel
@namespace Sandbox

@* The one right-click menu of the whole OS: the taskbar, the tray, the start menu and the apps all use it, so they look the *@
@* same in every theme. The caller places it (position, and width if it wants one) and closes it when an item is chosen. *@
@* Its styles are in NaviDesktop.razor.scss. *@

<root @onmousedown=@( ( PanelEvent e ) => e.StopPropagation() ) @onclick=@( ( PanelEvent e ) => e.StopPropagation() )>
	@* The items scroll in here when the menu has a MaxHeight. The submenu is outside it, so the scrolling doesn't clip it. *@
	<div class="menu-items" style="@( MaxHeight > 0 ? $"max-height: {MaxHeight}px; overflow-y: scroll;" : "" )">
		@if ( Heading is not null )
		{
			<div class="heading">@Heading</div>
		}

		@foreach ( var item in Items )
		{
			var chosen = item;
			var hasChildren = item.Children is { Count: > 0 };

			@if ( item.Separator )
			{
				<div class="separator"></div>
			}

			<div class="item @( item.Enabled ? "" : "disabled" ) @( item.Danger ? "danger" : "" ) @( hasChildren && Open == item.Id ? "open" : "" )"
			     @onmouseover=@( ( PanelEvent e ) => Hover( chosen, e ) )
			     @onclick=@( ( PanelEvent e ) => Choose( chosen, e ) )>
				@if ( !string.IsNullOrEmpty( item.Icon ) )
				{
					<i>@item.Icon</i>
				}
				<div class="item-label">@item.Label</div>
				@if ( !string.IsNullOrEmpty( item.Keys ) )
				{
					<div class="keys">@item.Keys</div>
				}
				@if ( hasChildren )
				{
					<i class="chevron">chevron_right</i>
				}
			</div>
		}
	</div>

	@if ( OpenItem is { Children: { Count: > 0 } } open )
	{
		@* Drawn here, not as another NaviMenu: a component can't include itself. So a submenu has no submenus. *@
		<div class="navi-menu submenu @( SubmenuLeft ? "left" : "right" )" style="top: @( SubmenuTop )px;">
			@foreach ( var child in open.Children )
			{
				var picked = child;

				<div class="item @( child.Enabled ? "" : "disabled" )" @onclick=@( () => Choose( picked ) )>
					@if ( !string.IsNullOrEmpty( child.Icon ) )
					{
						<i>@child.Icon</i>
					}
					<div class="item-label">@child.Label</div>
					@if ( !string.IsNullOrEmpty( child.Keys ) )
					{
						<div class="keys">@child.Keys</div>
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>The bar over the items, or null for none.</summary>
	public string Heading { get; set; }

	/// <summary>Open submenus to the menu's left, for a menu too near the right edge of what it may draw in.</summary>
	public bool SubmenuLeft { get; set; }

	/// <summary>The height, in pixels, the items may take before they scroll. Zero for no limit.</summary>
	public float MaxHeight { get; set; }

	public IReadOnlyList<NaviMenuItem> Items { get; set; } = [];

	/// <summary>Called with the item's id when the player picks an enabled item.</summary>
	public System.Action<string> OnChoose { get; set; }

	// Added here, not on <root>: the class a caller passes (its placement) would replace the root's own.
	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		AddClass( "navi-menu" );
	}

	/// <summary>The id of the item whose submenu is open, or null.</summary>
	string Open;

	NaviMenuItem OpenItem => Open is null ? null : Items.FirstOrDefault( x => x.Id == Open );

	/// <summary>Where the open submenu starts, in the menu's pixels: level with its item, whatever the scrolling.</summary>
	float SubmenuTop;

	const float OpenDelay = 0.3f;

	// The submenu the pointer is waiting on, and for how long.
	NaviMenuItem pending;
	float pendingTop;
	RealTimeSince sincePending;

	void Hover( NaviMenuItem item, PanelEvent e )
	{
		if ( item.Children is not { Count: > 0 } )
		{
			pending = null;
			Open = null;
			return;
		}

		if ( Open == item.Id || pending == item )
			return;

		pending = item;
		pendingTop = Top( e.This );
		sincePending = 0;
	}

	/// <summary>Where a submenu opened from this item starts, in the menu's pixels: level with it, whatever the scrolling.</summary>
	float Top( Panel item )
	{
		// The menu's border (2) and the submenu's own border and padding (4) are between the two tops.
		return (item.Box.Rect.Top - Box.Rect.Top) * ScaleFromScreen - 6f;
	}

	public override void Tick()
	{
		base.Tick();

		if ( pending is null || sincePending < OpenDelay )
			return;

		Open = pending.Id;
		SubmenuTop = pendingTop;
		pending = null;
	}

	/// <summary>A click opens a submenu at once, without the wait a hover has.</summary>
	void Choose( NaviMenuItem item, PanelEvent e = null )
	{
		if ( item.Children is { Count: > 0 } )
		{
			pending = null;

			if ( e is not null )
				SubmenuTop = Top( e.This );

			Open = item.Id;
			return;
		}

		if ( item.Enabled )
			OnChoose?.Invoke( item.Id );
	}

	protected override int BuildHash() => System.HashCode.Combine( Heading, Open, SubmenuLeft, MaxHeight, Items?.Count, Items is null ? 0 : string.Join( '|', Items.Select( x => $"{x.Id}{x.Label}{x.Enabled}" ) ).GetHashCode() );
}
