@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="@Computer.ThemeClasses">
	<div class="screen">
		<div class="wallpaper">
			<div class="orb o1"></div>
			<div class="orb o2"></div>
			<div class="orb o3"></div>
		</div>
		<div class="title">COPLAND OS</div>

		@* Back to front: panels draw in child order, and s&box ignores z-index for that. *@
		@foreach ( var window in Computer.Windows.Where( x => !x.IsService ).OrderBy( x => x.ZIndex ) )
		{
			var app = window.App;
			var info = window.Info;
			var state = (window == Computer.FocusedWindow ? "focused " : "") + (window.IsMinimized ? "minimized " : "") + (window.IsMaximized ? "maximized " : "")
					+ (app.Id == NaviAppRegistry.FilePickerApp ? "opaque" : "");

			@* Position and size are set every frame in UpdateWindows, so dragging doesn't rebuild the tree. *@
			<div @key=@window.Key class="window @state" @onmousedown=@(() => Computer.UserFocus( app.Id, window.Id ))>
				@* The body comes before the title bar in markup, so the title bar draws after it and the shield's tooltip
				@* lands over the app's content instead of under it. Its order pulls it in front in the column, so it still
				@* sits on top on screen. *@
				<NaviAppHost class="body" Computer=@Computer Window=@window></NaviAppHost>

				<div class="titlebar"
					@onmousedown=@( ( PanelEvent e ) => StartMove( window, e ) )
					@ondoubleclick=@( ( PanelEvent e ) => OnTitleDoubleClick( window, e ) )>
					<i class="glyph">@app.Icon</i>
					<div class="name">@WindowTitle( window )</div>

					@if ( window.Process.IsRoot )
					{
						<div class="shield">
							<i class="glyph">shield</i>
							<div class="tooltip">System app</div>
						</div>
					}

					@if ( !app.Shared && Networking.IsActive )
					{
						<div class="shield">
							<i class="glyph">sync_disabled</i>
							<div class="tooltip">Client-side</div>
						</div>
					}

					@if ( info.CanMinimize )
					{
						<div class="button" @onclick=@(() => Computer.UserMinimize( app.Id, window.Id ))><i>remove</i></div>
					}

					@if ( info.CanMaximize )
					{
						<div class="button" @onclick=@(() => Computer.UserToggleMaximized( app.Id, window.Id ))><i>@(window.IsMaximized ? "filter_none" : "crop_square")</i></div>
					}

					<div class="button close" @onclick=@(() => Computer.UserCloseWindow( app.Id, window.Id ))><i>close</i></div>
				</div>

				@if ( info.CanResize && !window.IsMaximized )
				{
					foreach ( var corner in Corners )
					{
						<div class="corner @corner.Name" @onmousedown=@( ( PanelEvent e ) => StartResize( window, corner.Direction, e ) )></div>
					}

					@* Edges can't keep a fixed aspect ratio, so those windows resize from the corners only. *@
					if ( info.AspectRatio <= 0f )
					{
						foreach ( var edge in Edges )
						{
							<div class="edge @edge.Name" @onmousedown=@( ( PanelEvent e ) => StartResize( window, edge.Direction, e ) )></div>
						}
					}
				}
			</div>
		}
	</div>

	@if ( MenuApp is not null || TrayMenuApp is not null || StartOpen || NotificationsOpen || NotificationMenu != 0 )
	{
		@* Catches clicks outside the menu, to close it. *@
		<div class="menu-backdrop" @onmousedown=@(() => CloseMenus())></div>
	}

	@if ( StartOpen )
	{
		<NaviStartMenu class="start-menu" Computer=@Computer OnOpen=@OpenFromStart OnLock=@LockFromStart></NaviStartMenu>
	}

	@* New notifications, newest at the bottom, over the taskbar's right end. After the backdrop, so a banner's menu can be
	   used. *@
	@if ( toasts.Count > 0 )
	{
		<div class="toasts">
			@foreach ( var notification in toasts )
			{
				var id = notification.Id;

				<NaviNotificationCard @key=@id class="toast"
				                      Notification=@notification
				                      App=@( NaviAppRegistry.Find( notification.AppId ) )
				                      Muted=@( Computer.IsNotificationsMuted( notification.AppId ) )
				                      MenuOpen=@( NotificationMenu == id )
				                      OnOpen=@( () => OpenNotification( id ) )
				                      OnClose=@( () => HideToast( id ) )
				                      OnMenu=@( () => ToggleNotificationMenu( id ) )
				                      OnMute=@( () => ToggleMuted( notification.AppId ) )></NaviNotificationCard>
			}
		</div>
	}

	@* The notification list, above the bell. Every notification stays here until the player dismisses it. *@
	@if ( NotificationsOpen )
	{
		<div class="notification-center" @onmousedown=@( () => NotificationMenu = 0 )>
			<div class="header">
				<div class="heading">Notifications</div>
				@if ( Computer.Notifications.Count > 0 )
				{
					<div class="clear" @onclick=@( () => Computer.UserClearNotifications() )>Clear all</div>
				}
			</div>

			<div class="list">
				@foreach ( var notification in Computer.Notifications.OrderByDescending( x => x.Id ) )
				{
					var id = notification.Id;

					<NaviNotificationCard @key=@id
					                      Notification=@notification
					                      App=@( NaviAppRegistry.Find( notification.AppId ) )
					                      Muted=@( Computer.IsNotificationsMuted( notification.AppId ) )
					                      MenuOpen=@( NotificationMenu == id )
					                      OnOpen=@( () => OpenNotification( id ) )
					                      OnClose=@( () => Computer.UserDismissNotification( id ) )
					                      OnMenu=@( () => ToggleNotificationMenu( id ) )
					                      OnMute=@( () => ToggleMuted( notification.AppId ) )></NaviNotificationCard>
				}

				@if ( Computer.Notifications.Count == 0 )
				{
					<div class="empty"><i>notifications_none</i>No notifications</div>
				}
			</div>
		</div>
	}

	<div class="taskbar">
		<div class="start @(StartOpen ? "menu-open" : "")" @onclick=@(() => ToggleStart())>NAVI</div>

		@{
			var wasPinned = false;
		}

		@foreach ( var app in Computer.TaskbarApps )
		{
			var process = Computer.GetProcess( app.Id );
			var isPinned = Computer.IsTaskbarPinned( app.Id );

			// A divider between the pinned apps and the ones that are only open.
			if ( wasPinned && !isPinned )
			{
				<div class="divider"></div>
			}

			wasPinned = isPinned;

			<div class="app @(MenuApp == app.Id ? "menu-open" : "")"
				@onmousedown=@( ( PanelEvent e ) => StartTaskbarDrag( e ) )
				@onclick=@(() => OnTaskbarClick( app ))
				@onrightclick=@(() => MenuApp = app.Id)>
				<div class="tooltip">@app.Name</div>
				<div class="icon" style="background-color: @app.Color;"><i>@app.Icon</i></div>
				@if ( process is not null )
				{
					<div class="marker @(process.IsMinimized ? "minimized" : "")"></div>
				}

				@if ( MenuApp == app.Id )
				{
					<NaviMenu class="taskbar-menu" Items=@TaskbarMenu( app, process ) OnChoose=@( ( string id ) => TaskbarMenuChoose( app, id ) )/>
				}
			</div>
		}

		@* The system tray: one icon for each app that has one. The desktop draws all of it, so an app can't change what a
		   tooltip or the menu says besides its own words, and can't remove Quit. *@
		<div class="tray">
			@foreach ( var process in Computer.Running.Where( x => x.Tray is not null ) )
			{
				var tray = process.Tray;
				var id = process.App.Id;

				<div @key=@id class="tray-icon @(TrayMenuApp == id ? "menu-open" : "")"
					@onclick=@(() => OnTrayClick( process, "" ))
					@onrightclick=@(() => OpenTrayMenu( id ))>
					<div class="tooltip">@(string.IsNullOrEmpty( tray.Tooltip ) ? process.App.Name : $"{process.App.Name}: {tray.Tooltip}")</div>
					<i>@tray.Icon</i>

					@if ( TrayMenuApp == id )
					{
						<NaviMenu class="tray-menu" Heading=@process.App.Name Items=@TrayMenu( process ) OnChoose=@( ( string item ) => OnTrayClick( process, item ) )/>
					}
				</div>
			}

			@* The network and the clock are the computer's own, always there. The clock runs on each client from NaviClock, *@
			@* so nothing is sent for it. *@
			<div class="tray-icon network @( Computer.IsOnline ? "" : "offline" )">
				<div class="tooltip">@( Computer.IsOnline ? $"Connected to the internet: {Computer.IpAddress}" : "No internet: this computer has no network card" )</div>
				<i>@( Computer.IsOnline ? "wifi" : "wifi_off" )</i>
			</div>

			<div class="tray-clock">
				<div class="tooltip">@NaviClock.DateText</div>
				@* One box per character, each digit as wide as any other, so the clock never changes width as it ticks. *@
				@foreach ( var character in clockText )
				{
					<div class="@( char.IsDigit( character ) ? "digit" : "separator" )">@character</div>
				}
			</div>

			@* The notification list's button, always last. It counts what the player hasn't seen. *@
			@{
				var unread = Computer.UnreadNotifications;
			}
			<div class="tray-icon bell @( NotificationsOpen ? "menu-open" : "" )" @onclick=@( () => ToggleNotifications() )>
				<div class="tooltip">Notifications</div>
				<i>@( unread > 0 ? "notifications_active" : "notifications" )</i>
				@if ( unread > 0 )
				{
					<div class="badge">@( unread > 9 ? "9+" : unread.ToString() )</div>
				}
			</div>
		</div>
	</div>

	@* Headless apps' services. Their panels run here, and nothing of them is drawn. *@
	<div class="services">
		@foreach ( var window in Computer.Windows.Where( x => x.IsService ) )
		{
			<NaviAppHost @key=@window.Key Computer=@Computer Window=@window></NaviAppHost>
		}
	</div>

	@if ( !Computer.CanUse )
	{
		@* Another player has the seat. Catches every click, so watchers can't work the screen. *@
		<div class="in-use">
			<div class="badge"><i>person</i>In use by @( Computer.User?.DisplayName ?? "another player" )</div>
		</div>
	}
	else if ( Computer.RequireSeat && !Computer.IsSeated )
	{
		@* The seat is free. Catches every click, so nothing on the screen is used before the player sits. Pressing Use while pointing at it sits them
		   down (UpdateSit), so no click lands on the screen while the camera flies in. *@
		<div class="sit"></div>
	}

</root>

@code
{
	[RequireComponent] public NaviComputer Computer { get; set; }
	[RequireComponent] public NaviInputCapture InputCapture { get; set; }

	/// <summary>
	/// Minimum gap, in panel pixels, between a tooltip and the edge of the screen.
	/// </summary>
	[Property] public float TooltipEdgeMargin { get; set; } = 8f;

	/// <summary>
	/// Smallest size a window can be resized to, in panel pixels.
	/// </summary>
	[Property] public Vector2 MinWindowSize { get; set; } = new( 160f, 60f );

	/// <summary>
	/// The smallest size the window being dragged can be resized to: the app's own minimum for its content, plus the
	/// window's chrome, but never under <see cref="MinWindowSize"/>.
	/// </summary>
	Vector2 MinSizeOf( NaviWindow window ) => new(
		System.MathF.Max( MinWindowSize.x, window.Info.MinSize.x + dragChrome.x ),
		System.MathF.Max( MinWindowSize.y, window.Info.MinSize.y + dragChrome.y ) );

	record Corner( string Name, Vector2 Direction );

	static readonly Corner[] Corners =
	{
		new( "nw", new Vector2( -1, -1 ) ),
		new( "ne", new Vector2( 1, -1 ) ),
		new( "sw", new Vector2( -1, 1 ) ),
		new( "se", new Vector2( 1, 1 ) ),
	};

	static readonly Corner[] Edges =
	{
		new( "n", new Vector2( 0, -1 ) ),
		new( "s", new Vector2( 0, 1 ) ),
		new( "w", new Vector2( -1, 0 ) ),
		new( "e", new Vector2( 1, 0 ) ),
	};

	// The window being moved or resized. The drag lasts while the mouse button is held on dragHandle.
	NaviWindow dragging;
	Panel dragHandle;
	Vector2 dragDirection; // Zero when moving, otherwise the corner being dragged.
	Vector2 dragStartMouse;
	Vector2 dragStartPosition;
	Vector2 dragStartSize;
	Vector2 dragChrome; // Title bar and borders: the window's size less its content's.

	// Windows that were maximized last frame. Their measured size is still the maximized one, so they skip clamping for a frame.
	readonly HashSet<NaviWindow> wasMaximized = new();

	/// <summary>
	/// Id of the app whose taskbar menu is open, or null.
	/// </summary>
	string MenuApp;

	/// <summary>
	/// Id of the app whose tray menu is open, or null.
	/// </summary>
	string TrayMenuApp;

	/// <summary>
	/// How far in front of the screen the secure layer floats, in world units. Less than 1 and the screen can still draw
	/// over it. It is shrunk to match, so it lines up with the screen when the camera is framed on it.
	/// </summary>
	const float SecureLayerOffset = 1f;

	/// <summary>
	/// Create the secure layer that shows permission prompts (<see cref="NaviSecurePrompt"/>): a panel of its own, in front
	/// of this one, so no app panel is above it or can reach it through its ancestors. It isn't saved with the scene.
	/// </summary>
	protected override void OnStart()
	{
		base.OnStart();

		var layer = new GameObject( GameObject, true, "Navi Secure Layer" );
		layer.Flags |= GameObjectFlags.NotSaved;

		// Every client makes its own, for its own desktop. The host's mustn't be sent to them with the computer.
		layer.NetworkMode = NetworkMode.Never;
		layer.WorldRotation = WorldRotation;
		layer.WorldPosition = WorldPosition + WorldRotation.Forward * SecureLayerOffset;

		// Nearer the camera, so smaller by the same perspective to look the same size from where the player views it.
		if ( InputCapture.IsValid() && Scene.Camera is { } camera )
		{
			var distance = Vector3.Dot( InputCapture.ScreenView( camera ).Position - WorldPosition, WorldRotation.Forward );
			if ( distance > SecureLayerOffset * 2f )
				layer.WorldScale = WorldScale * ((distance - SecureLayerOffset) / distance);
		}

		if ( Components.TryGet<WorldPanel>( out var world ) )
		{
			var panel = layer.Components.Create<WorldPanel>( false );
			panel.PanelSize = world.PanelSize;
			panel.HorizontalAlign = world.HorizontalAlign;
			panel.VerticalAlign = world.VerticalAlign;
			panel.LookAtCamera = world.LookAtCamera;
			panel.InteractionRange = world.InteractionRange;
			panel.RenderScale = world.RenderScale;
			panel.Enabled = true;

			worldPanels = [world, panel];
			baseScale = Unscaled( world.RenderScale );
		}
		else if ( Components.TryGet<ScreenPanel>( out var screen ) )
		{
			var panel = layer.Components.Create<ScreenPanel>( false );
			panel.Opacity = screen.Opacity;
			panel.Scale = screen.Scale;
			panel.AutoScreenScale = screen.AutoScreenScale;
			panel.ZIndex = screen.ZIndex + 1000;
			panel.Enabled = true;

			screenPanels = [screen, panel];
			baseScale = Unscaled( screen.Scale );
		}

		securePrompt = layer.Components.Create<NaviSecurePrompt>( false );
		securePrompt.Computer = Computer;
		securePrompt.Enabled = true;
	}

	NaviSecurePrompt securePrompt;

	/// <summary>
	/// Draw neither the desktop nor the secure layer while the computer is out of range of the host's camera
	/// (<see cref="NaviComputer.IsOutOfRange"/>): the stand-in shows instead. Only the drawing stops. The panels keep
	/// running, and the apps in them.
	/// </summary>
	void UpdateDrawing()
	{
		var show = !Computer.IsOutOfRange;
		SetDrawing( this, show );
		SetDrawing( securePrompt, show );
	}

	// The engine skips drawing a fully transparent root panel. Null gives the opacity back to the style sheets. Only
	// world panels: a ScreenPanel sets its root's opacity itself, and a computer drawn on one has no stand-in.
	static void SetDrawing( PanelComponent component, bool show )
	{
		float? opacity = show ? null : 0f;
		if ( component.IsValid()
			&& component.Panel?.FindRootPanel() is Sandbox.UI.WorldPanel root
			&& root.Style.Opacity != opacity )
			root.Style.Opacity = opacity;
	}

	// The desktop's panel and the secure layer's, which are scaled together, and the scale they started with: 100%.
	WorldPanel[] worldPanels = [];
	ScreenPanel[] screenPanels = [];
	float baseScale = 1f;

	/// <summary>
	/// The panel's scale before the display scale was applied to it. On the host it hasn't been yet. A client gets the
	/// computer from the host as it is at that moment, with the host's display scale already in the panel's scale, and the
	/// computer's <see cref="NaviComputer.DisplayScale"/> from the same moment, so that comes back out. Otherwise the
	/// client applies it twice, and its screen holds a different number of panel pixels than the host's.
	/// </summary>
	float Unscaled( float scale ) =>
		Computer.IsAuthority || Computer.DisplayScale <= 0f ? scale : scale / Computer.DisplayScale;

	/// <summary>
	/// Draw the desktop and the secure layer at the computer's <see cref="NaviComputer.DisplayScale"/>. A world panel's
	/// render scale is its layout scale too, so a bigger one fits fewer panel pixels on the same screen.
	/// </summary>
	void ApplyDisplayScale()
	{
		var scale = baseScale * Computer.DisplayScale;

		foreach ( var panel in worldPanels )
		{
			if ( panel.IsValid() && panel.RenderScale != scale )
				panel.RenderScale = scale;
		}

		foreach ( var panel in screenPanels )
		{
			if ( panel.IsValid() && panel.Scale != scale )
				panel.Scale = scale;
		}
	}

	protected override void OnUpdate()
	{
		ApplyDisplayScale();
		UpdateDrawing();
		KeepSeat();
		UpdateSit();

		// The menu's icon goes when its app is uninstalled, or closed without being pinned.
		if ( MenuApp is not null && Computer.TaskbarApps.All( x => x.Id != MenuApp ) )
			MenuApp = null;

		if ( TrayMenuApp is not null && Computer.GetProcess( TrayMenuApp )?.Tray is null )
			TrayMenuApp = null;

		// A taskbar or tray menu opened with the start menu already up. The host closes it when the player stands up or the
		// screen locks.
		if ( StartOpen && Computer.CanUse && (MenuApp is not null || TrayMenuApp is not null) )
			SetStart( false );

		if ( (NotificationsOpen || NotificationMenu != 0) && (!Computer.CanUse || Computer.IsLocked) )
		{
			NotificationsOpen = false;
			NotificationMenu = 0;
		}

		UpdateToasts();

		var screen = Panel?.Children.FirstOrDefault( x => x.HasClass( "screen" ) );
		if ( screen is not null )
			UpdateWindows( screen );

		var taskbar = Panel?.Children.FirstOrDefault( x => x.HasClass( "taskbar" ) );
		if ( taskbar is null )
			return;

		UpdateTaskbarDrag( taskbar );

		// Icons are offset while one is dragged, which would throw the measurements off. Nothing to fit changes meanwhile.
		if ( !taskbarDragMoved )
			CapTaskbar( taskbar );

		ClampTooltips( taskbar );
	}

	/// <summary>
	/// Clicking the icon of an app with a window in front minimizes its windows. Otherwise it opens, restores or focuses the
	/// app. An app that is running without a window gets the click its tray icon would.
	/// </summary>
	void OnTaskbarClick( NaviAppInfo app )
	{
		// Letting go of a dragged icon isn't a click on it.
		if ( taskbarDragMoved || sinceTaskbarDrag < TaskbarDropClickTime )
			return;

		CloseMenus();

		if ( Computer.GetProcess( app.Id ) is { } process && !process.DrawnWindows.Any() )
			OnTrayClick( process, "" );
		else
			Computer.UserTaskbarClick( app.Id );
	}

	/// <summary>
	/// Open an app, restore it, or give it the click of its tray icon if it is running without a window.
	/// </summary>
	void OpenApp( NaviAppInfo app )
	{
		if ( Computer.GetProcess( app.Id ) is { } process && !process.DrawnWindows.Any() )
			OnTrayClick( process, "" );
		else
			Computer.UserLaunch( app.Id );
	}

	void CloseMenus()
	{
		MenuApp = null;
		TrayMenuApp = null;
		SetStart( false );
		NotificationsOpen = false;
		NotificationMenu = 0;
	}

	// Notifications. The computer keeps them; what is open here is this client's own, like the other menus.

	/// <summary>
	/// Whether the notification list is open.
	/// </summary>
	bool NotificationsOpen;

	/// <summary>
	/// Id of the notification whose menu is open, or 0.
	/// </summary>
	int NotificationMenu;

	/// <summary>
	/// How long a new notification's banner stays up, in seconds, and how many banners are up at once.
	/// </summary>
	const float ToastSeconds = 6f;

	const int MaxToasts = 3;

	/// <summary>
	/// The banners up now, oldest first. Worked out every frame in <see cref="UpdateToasts"/>, so they come and go without
	/// anything else changing.
	/// </summary>
	List<NaviNotification> toasts = new();

	int toastsHash;

	/// <summary>
	/// Banners the player closed before their time was up. The notifications stay in the list.
	/// </summary>
	readonly HashSet<int> hiddenToasts = new();

	/// <summary>
	/// The newest notification the list was marked read up to from here, so it is asked once per notification.
	/// </summary>
	int markedRead;

	void ToggleNotifications()
	{
		var open = !NotificationsOpen;
		CloseMenus();
		NotificationsOpen = open;
	}

	void ToggleNotificationMenu( int id )
	{
		var open = NotificationMenu != id;
		MenuApp = null;
		TrayMenuApp = null;
		SetStart( false );
		NotificationMenu = open ? id : 0;
	}

	/// <summary>
	/// The player clicked a notification: its app opens, and it leaves the list.
	/// </summary>
	void OpenNotification( int id )
	{
		CloseMenus();
		Computer.UserOpenNotification( id );
	}

	void HideToast( int id )
	{
		hiddenToasts.Add( id );
		if ( NotificationMenu == id )
			NotificationMenu = 0;
	}

	void ToggleMuted( string appId )
	{
		NotificationMenu = 0;
		Computer.UserSetNotificationsMuted( appId, !Computer.IsNotificationsMuted( appId ) );
	}

	/// <summary>
	/// Banners for notifications that arrived in the last <see cref="ToastSeconds"/>, unless their app is muted, the list
	/// is open, or the player closed them. One whose menu is open stays until the menu closes. While the list is open, what
	/// arrives is marked read.
	/// </summary>
	void UpdateToasts()
	{
		if ( NotificationMenu != 0 && Computer.GetNotification( NotificationMenu ) is null )
			NotificationMenu = 0;

		hiddenToasts.RemoveWhere( x => Computer.GetNotification( x ) is null );

		toasts = NotificationsOpen
			? new()
			: Computer.Notifications
				.Where( x => !hiddenToasts.Contains( x.Id ) && !Computer.IsNotificationsMuted( x.AppId )
					&& (Computer.ArrivedWithin( x.Id, ToastSeconds ) || x.Id == NotificationMenu) )
				.TakeLast( MaxToasts )
				.ToList();

		var hash = new System.HashCode();
		foreach ( var toast in toasts )
			hash.Add( toast.Id );

		toastsHash = hash.ToHashCode();

		if ( NotificationsOpen && Computer.CanUse && Computer.UnreadNotifications > 0 && markedRead != Computer.LastNotificationId )
		{
			markedRead = Computer.LastNotificationId;
			Computer.UserMarkNotificationsRead();
		}
	}

	/// <summary>
	/// Whether the start menu is open. The computer keeps it, so everyone at the screen sees it.
	/// </summary>
	bool StartOpen => Computer.IsStartMenuOpen;

	/// <summary>
	/// Open or close the start menu, for everyone. Only the player in the seat can; it is asked of the host only when it
	/// changes.
	/// </summary>
	void SetStart( bool open )
	{
		if ( Computer.CanUse && StartOpen != open )
			Computer.UserSetStartMenu( open, "" );
	}

	void ToggleStart()
	{
		var open = !StartOpen;
		CloseMenus();
		SetStart( open );
	}

	/// <summary>
	/// The player picked an app in the start menu: open it and close the menu.
	/// </summary>
	void OpenFromStart( NaviAppInfo app )
	{
		CloseMenus();
		OpenApp( app );
	}

	/// <summary>
	/// The player picked Lock in the start menu: close the menu and lock the computer.
	/// </summary>
	void LockFromStart()
	{
		CloseMenus();
		Computer.UserLock();
	}

	void OpenTrayMenu( string id )
	{
		MenuApp = null;
		TrayMenuApp = id;
	}

	/// <summary>
	/// The player clicked a tray icon (<paramref name="item"/> empty) or one of its menu items, or Quit. A shared app hears it
	/// on the host's copy. One that isn't shared runs on every client, so it hears it on this client's own copy.
	/// </summary>
	void OnTrayClick( NaviProcess process, string item )
	{
		CloseMenus();

		if ( !Computer.CanUse )
			return;

		var id = process.App.Id;

		if ( item == NaviComputer.QuitItem )
			Computer.UserClose( id );
		else if ( process.App.Shared )
			Computer.UserTrayClick( id, item );
		else
			Computer.DeliverTrayClick( id, item );
	}

	/// <summary>
	/// What the title bar says: the app's name, then the window's own title. The app's name is always first, so a window
	/// can't pass for another app's. A pre-packaged app is part of the OS and can't be a stranger's, so its window's own title
	/// stands alone (a browser says the page's title), and the app's name is what shows until it has one.
	/// </summary>
	string WindowTitle( NaviWindow window )
	{
		// A local title is this player's own (a web page's, say), so it shows only on the user's client.
		var title = Computer?.IsUser == true && window.LocalTitle is { } local ? local : window.Title;

		return string.IsNullOrEmpty( title ) ? window.App.Name :
			window.App.IsPrepackaged ? title : $"{window.App.Name} {title}";
	}

	/// <summary>The items of an app's taskbar menu.</summary>
	List<NaviMenuItem> TaskbarMenu( NaviAppInfo app, NaviProcess process )
	{
		var items = new List<NaviMenuItem> { new( "open", process is null ? "Open" : "Show", "open_in_new" ) };

		if ( app.Permissions.Count > 0 && !app.IsSystem )
			items.Add( new( "permissions", "Permissions...", "tune" ) );

		items.Add( new( "pin", Computer.IsTaskbarPinned( app.Id ) ? "Unpin from taskbar" : "Pin to taskbar", "push_pin" ) );

		if ( process is not null )
			items.Add( new( "close", "Close", "close" ) );

		return items;
	}

	/// <summary>
	/// The items of a tray menu: the app's own, then Quit, which the desktop always adds and an app can't remove.
	/// </summary>
	List<NaviMenuItem> TrayMenu( NaviProcess process )
	{
		var items = process.Tray.Items.Select( x => new NaviMenuItem( x.Id, x.Label, x.Icon ) ).ToList();
		items.Add( new( NaviComputer.QuitItem, "Quit", "power_settings_new", Danger: true ) );
		return items;
	}

	/// <summary>Run a taskbar menu item and close the menu.</summary>
	void TaskbarMenuChoose( NaviAppInfo app, string id )
	{
		MenuApp = null;

		switch ( id )
		{
			case "open": OpenApp( app ); break;
			case "permissions": Computer.UserReviewPermissions( app.Id ); break;
			case "pin": Computer.UserToggleTaskbarPin( app.Id ); break;
			case "close": Computer.UserClose( app.Id ); break;
		}
	}

	void OnTitleDoubleClick( NaviWindow window, PanelEvent e )
	{
		if ( !IsOnButton( e ) )
			Computer.UserToggleMaximized( window.App.Id, window.Id );
	}

	/// <summary>
	/// True if the event started on a title bar button rather than the title bar itself.
	/// </summary>
	static bool IsOnButton( PanelEvent e ) => IsOn( e, "button" );

	/// <summary>
	/// True if the event started on a panel with this class inside the one handling it, rather than that panel itself.
	/// </summary>
	static bool IsOn( PanelEvent e, string className )
	{
		for ( var panel = e.Target; panel is not null && panel != e.This; panel = panel.Parent )
		{
			if ( panel.HasClass( className ) )
				return true;
		}

		return false;
	}

	// The taskbar icon being dragged to a new place. The drag lasts while the mouse button is held on taskbarDragHandle.
	// It only becomes a drag once the mouse has moved TaskbarDragThreshold; until then it may still be a click.
	Panel taskbarDragHandle;
	List<string> taskbarDragApps; // The apps of the shown icons, in order, when the button went down.
	int taskbarDragFrom;
	List<float> taskbarDragCenters; // Where the icons' centers were when the button went down, along the taskbar.
	float taskbarDragDivider; // The divider's center then, or NaN if there was none.
	float taskbarDragSlot; // From one icon's left edge to the next's, in panel pixels.
	float taskbarDragStartMouse;
	bool taskbarDragMoved;
	RealTimeSince sinceTaskbarDrag = TaskbarDropClickTime;

	/// <summary>
	/// How far the mouse moves, in panel pixels, before pressing an icon becomes dragging it.
	/// </summary>
	const float TaskbarDragThreshold = 6f;

	/// <summary>
	/// For how long after an icon is dropped a click on the taskbar is ignored, in seconds. The release that drops it may
	/// arrive as a click after the drag has ended.
	/// </summary>
	const float TaskbarDropClickTime = 0.2f;

	static List<Panel> ShownTaskbarIcons( Panel taskbar ) =>
		taskbar.Children.Where( x => x.HasClass( "app" ) && x.Style.Display != DisplayMode.None ).ToList();

	/// <summary>
	/// The mouse went down on a taskbar icon. Moving it far enough drags the icon; see <see cref="UpdateTaskbarDrag"/>.
	/// </summary>
	void StartTaskbarDrag( PanelEvent e )
	{
		if ( !Computer.CanUse || e is not MousePanelEvent { MouseButton: MouseButtons.Left } || IsOn( e, "menu" ) )
			return;

		var taskbar = e.This.Parent;
		var icons = ShownTaskbarIcons( taskbar );
		var from = icons.IndexOf( e.This );
		if ( from < 0 || icons.Count < 2 )
			return;

		taskbarDragHandle = e.This;
		taskbarDragApps = Computer.TaskbarApps.Take( icons.Count ).Select( x => x.Id ).ToList();
		taskbarDragFrom = from;
		// The divider is between two of the icons, so the slot is the smallest step from one to the next.
		taskbarDragSlot = Enumerable.Range( 0, icons.Count - 1 )
			.Min( i => icons[i + 1].Box.Rect.Left - icons[i].Box.Rect.Left ) * taskbar.ScaleFromScreen;
		taskbarDragCenters = icons.Select( x => (x.Box.Rect.Left + x.Box.Rect.Right) * 0.5f * taskbar.ScaleFromScreen ).ToList();
		taskbarDragDivider = taskbar.Children.FirstOrDefault( x => x.HasClass( "divider" ) ) is { } divider
			? (divider.Box.Rect.Left + divider.Box.Rect.Right) * 0.5f * taskbar.ScaleFromScreen
			: float.NaN;
		taskbarDragStartMouse = MousePosition( taskbar ).x;
		taskbarDragMoved = false;
	}

	/// <summary>
	/// Move the dragged icon with the mouse, along the taskbar, and the icons it passes out of its way. Letting go drops it
	/// there and tells the host. The drag is called off if the taskbar changes under it.
	/// </summary>
	void UpdateTaskbarDrag( Panel taskbar )
	{
		if ( taskbarDragHandle is null )
			return;

		var icons = ShownTaskbarIcons( taskbar );
		var from = taskbarDragFrom;

		var unchanged = taskbarDragHandle.IsValid && Computer.CanUse
			&& icons.Count == taskbarDragApps.Count && icons[from] == taskbarDragHandle
			&& Computer.TaskbarApps.Take( icons.Count ).Select( x => x.Id ).SequenceEqual( taskbarDragApps );

		if ( !unchanged )
		{
			EndTaskbarDrag( icons, from );
			return;
		}

		var delta = MousePosition( taskbar ).x - taskbarDragStartMouse;
		var released = !taskbarDragHandle.HasActive;

		if ( !taskbarDragMoved )
		{
			if ( released )
			{
				EndTaskbarDrag( icons, from );
				return;
			}

			if ( System.MathF.Abs( delta ) < TaskbarDragThreshold )
				return;

			taskbarDragMoved = true;
			CloseMenus();
		}

		// A pinned icon stays among the pinned ones. The others can go anywhere: in among the pinned ones pins them.
		var pinnedCount = taskbarDragApps.Count( Computer.IsTaskbarPinned );
		var last = from < pinnedCount ? pinnedCount - 1 : icons.Count - 1;

		var slot = taskbarDragSlot;
		var left = -from * slot;

		// The divider makes the way to the first icon longer than the icons before the dragged one. Reach past the first
		// icon's center, so there is a place in front of it.
		if ( from >= pinnedCount && pinnedCount > 0 && !float.IsNaN( taskbarDragDivider ) )
			left = taskbarDragCenters[0] - taskbarDragCenters[from] - slot * 0.5f;

		var offset = Clamp( delta, left, (last - from) * slot );
		var to = slot > 0f ? from + (int)System.MathF.Round( offset / slot ) : from;

		// An icon that isn't pinned becomes pinned when it is dragged to the left of the divider. It goes in front of the
		// pinned icons whose centers it has not passed, so it can also be put after the last one.
		var pin = false;
		if ( from >= pinnedCount && !float.IsNaN( taskbarDragDivider ) )
		{
			var center = taskbarDragCenters[from] + offset;
			pin = center < taskbarDragDivider;
			to = pin ? taskbarDragCenters.Take( pinnedCount ).Count( x => x < center ) : System.Math.Max( to, pinnedCount );
		}

		if ( released )
		{
			EndTaskbarDrag( icons, to, pin );
			return;
		}

		taskbar.SetClass( "reordering", true );

		for ( var i = 0; i < icons.Count; i++ )
		{
			var shift = i == from ? offset
				: i > from && i <= to ? -slot
				: i < from && i >= to ? slot
				: 0f;

			icons[i].Style.Left = Length.Pixels( shift );
			icons[i].SetClass( "dragging", i == from );
		}

		// The divider moves one slot when an icon is dragged in among the pinned ones, where it becomes pinned.
		if ( taskbar.Children.FirstOrDefault( x => x.HasClass( "divider" ) ) is { } divider )
			divider.Style.Left = Length.Pixels( pin ? slot : 0f );
	}

	/// <summary>
	/// Put the icons back in their places and, if the dragged one was dropped somewhere new, ask the host to move it there.
	/// The taskbar is rebuilt in the new order once the host's state comes back.
	/// </summary>
	void EndTaskbarDrag( List<Panel> icons, int to, bool pin = false )
	{
		foreach ( var icon in icons )
		{
			icon.Style.Left = null;
			icon.SetClass( "dragging", false );
		}

		taskbarDragHandle?.Parent?.SetClass( "reordering", false );

		if ( taskbarDragHandle?.Parent?.Children.FirstOrDefault( x => x.HasClass( "divider" ) ) is { } divider )
			divider.Style.Left = null;

		if ( taskbarDragMoved )
			sinceTaskbarDrag = 0;

		if ( taskbarDragMoved && (to != taskbarDragFrom || pin) )
			Computer.UserMoveTaskbarApp( taskbarDragApps[taskbarDragFrom], to, pin );

		taskbarDragHandle = null;
		taskbarDragApps = null;
		taskbarDragMoved = false;
	}

	void StartMove( NaviWindow window, PanelEvent e )
	{
		if ( window.IsMaximized || IsOnButton( e ) )
			return;

		StartDrag( window, e.This, Vector2.Zero );
	}

	void StartResize( NaviWindow window, Vector2 corner, PanelEvent e )
	{
		if ( !window.Info.CanResize || window.IsMaximized )
			return;

		StartDrag( window, e.This, corner );
	}

	void StartDrag( NaviWindow window, Panel handle, Vector2 direction )
	{
		if ( !Computer.CanUse )
			return;

		var panel = handle.Parent;
		var screen = panel?.Parent;
		if ( screen is null )
			return;

		dragging = window;
		dragHandle = handle;
		dragDirection = direction;
		dragStartMouse = MousePosition( screen );
		dragStartPosition = window.Position;
		dragStartSize = window.Size ?? panel.Box.Rect.Size * panel.ScaleFromScreen;
		dragChrome = Chrome( panel ) ?? Vector2.Zero;
	}

	/// <summary>
	/// Apply the current drag, keep every window inside the screen, and set the window positions and sizes.
	/// </summary>
	void UpdateWindows( Panel screen )
	{
		var bounds = screen.Box.Rect.Size * screen.ScaleFromScreen;

		if ( dragging is not null )
		{
			if ( dragHandle is null || !dragHandle.IsValid || !dragHandle.HasActive || dragging.IsMaximized || !Computer.Windows.Contains( dragging ) )
			{
				SendDrag();
				dragging = null;
				dragHandle = null;
			}
			else
			{
				var delta = MousePosition( screen ) - dragStartMouse;

				if ( dragDirection == Vector2.Zero )
				{
					var position = dragStartPosition + delta;
					position.x += SnapOffset( position.x, position.x + dragStartSize.x, SnapLines( screen, true, position.y, position.y + dragStartSize.y ) );
					position.y += SnapOffset( position.y, position.y + dragStartSize.y, SnapLines( screen, false, position.x, position.x + dragStartSize.x ) );
					dragging.Position = position;
				}
				else if ( dragging.Info.AspectRatio > 0f )
				{
					(dragging.Position, var size) = ResizeKeepingRatio( delta, bounds, dragging.Info.AspectRatio );
					dragging.Size = size;
				}
				else
				{
					var snapX = dragDirection.x == 0 ? null : SnapLines( screen, true, dragStartPosition.y, dragStartPosition.y + dragStartSize.y );
					var snapY = dragDirection.y == 0 ? null : SnapLines( screen, false, dragStartPosition.x, dragStartPosition.x + dragStartSize.x );
					var (x, width) = ResizeAxis( dragDirection.x, delta.x, dragStartPosition.x, dragStartSize.x, MinSizeOf( dragging ).x, bounds.x, snapX );
					var (y, height) = ResizeAxis( dragDirection.y, delta.y, dragStartPosition.y, dragStartSize.y, MinSizeOf( dragging ).y, bounds.y, snapY );
					dragging.Position = new Vector2( x, y );
					dragging.Size = new Vector2( width, height );
				}
			}
		}

		foreach ( var panel in screen.Children.Where( x => x.HasClass( "window" ) ) )
		{
			var window = panel.Children.OfType<NaviAppHost>().FirstOrDefault()?.Window;
			if ( window is null )
				continue;

			// A new window stays invisible (opacity 0 in the stylesheet) for its first pass here: it has no position yet,
			// and its size is only known after it has been laid out once. Shown from the second pass on, so it doesn't
			// flash in the middle of the screen first.
			if ( panel.Style.Left is not null )
				panel.Style.Opacity = 1;

			if ( window.IsMaximized )
			{
				panel.Style.Left = Length.Pixels( 0 );
				panel.Style.Top = Length.Pixels( 0 );
				panel.Style.Width = Length.Percent( 100 );
				panel.Style.Height = Length.Percent( 100 );
				wasMaximized.Add( window );
				continue;
			}

			var layoutIsCurrent = !wasMaximized.Remove( window );

			// A window that keeps its shape gets the height that goes with its width, whatever it was given: by a saved
			// layout, the host or a client.
			if ( window.Size is { } size && window.Info.AspectRatio > 0f && Chrome( panel ) is { } chrome )
			{
				window.Size = FitRatio( size.x - chrome.x, window.Info.AspectRatio, chrome, MinWindowSize, bounds );
			}
			else if ( window.Size is { } other )
			{
				window.Size = new Vector2(
					Clamp( other.x, MinWindowSize.x, bounds.x ),
					Clamp( other.y, MinWindowSize.y, bounds.y ) );
			}

			// A window bigger than the screen is pinned to the top left.
			if ( window.Size is not null || layoutIsCurrent )
			{
				var max = bounds - (window.Size ?? panel.Box.Rect.Size * panel.ScaleFromScreen);
				window.Position = new Vector2(
					Clamp( window.Position.x, 0f, max.x ),
					Clamp( window.Position.y, 0f, max.y ) );
			}

			panel.Style.Left = Length.Pixels( window.Position.x );
			panel.Style.Top = Length.Pixels( window.Position.y );
			panel.Style.Width = window.Size is { } w ? Length.Pixels( w.x ) : null;
			panel.Style.Height = window.Size is { } h ? Length.Pixels( h.y ) : null;
		}

		StackWindows( screen );

		if ( dragging is not null && sinceDragSent > DragSendInterval )
			SendDrag();
	}

	/// <summary>
	/// How often a window being dragged is sent to the host, in seconds, so others see it move. The end of the drag is
	/// always sent.
	/// </summary>
	const float DragSendInterval = 0.1f;

	RealTimeSince sinceDragSent;

	/// <summary>
	/// Tell the host where the dragged window is. On the host itself it is already there.
	/// </summary>
	void SendDrag()
	{
		sinceDragSent = 0;

		if ( dragging is null || Computer.IsAuthority )
			return;

		Computer.UserMoveWindow( dragging.App.Id, dragging.Id, dragging.Position, dragging.Size ?? default, dragging.Size is not null );
	}

	/// <summary>
	/// The player presses Use while pointing at the free screen. Apps can raise panel events, but can't press the player's
	/// Use action, so they can't sit the player down. A computer that doesn't <see cref="NaviComputer.RequireSeat"/> takes the
	/// seat as soon as the player points at it.
	/// </summary>
	void UpdateSit()
	{
		if ( !Computer.CanUse || Computer.IsSeated )
			return;

		if ( !Computer.RequireSeat )
		{
			if ( Panel?.HasHovered == true && sinceSitAsked > SitAskInterval )
			{
				sinceSitAsked = 0;
				Computer.UserSit();
			}

			return;
		}

		if ( Input.Pressed( "Use" ) && Panel?.Children.FirstOrDefault( x => x.HasClass( "sit" ) ) is { HasHovered: true } )
			Computer.UserSit();
	}

	/// <summary>
	/// How often a pointed-at computer without a required seat asks for it again while waiting for the host's answer, in seconds.
	/// </summary>
	const float SitAskInterval = 0.5f;

	RealTimeSince sinceSitAsked;

	/// <summary>
	/// How often the user's client tells the host they're still at the screen, in seconds.
	/// </summary>
	const float KeepSeatInterval = 1f;

	RealTimeSince sinceKeptSeat;

	/// <summary>
	/// Keep the seat while the user points at the screen or they are pulled in to the screen, even if they don't click.
	/// </summary>
	void KeepSeat()
	{
		if ( !Networking.IsActive || Computer.UserId == default || !Computer.IsUser || sinceKeptSeat < KeepSeatInterval )
			return;

		if ( Panel?.HasHovered != true && !InputCapture.IsCapturing )
			return;

		sinceKeptSeat = 0;
		Computer.UserKeepSeat();
	}

	/// <summary>
	/// Put the window panels in <see cref="NaviProcess.ZIndex"/> order, so the focused one draws on top and gets the clicks.
	/// The markup is already in that order, but a rebuild can keep existing panels where they were.
	/// </summary>
	static void StackWindows( Panel screen )
	{
		static int Order( Panel panel ) => panel.Children.OfType<NaviAppHost>().FirstOrDefault()?.Window?.ZIndex ?? int.MinValue;

		var last = int.MinValue;
		foreach ( var child in screen.Children )
		{
			var order = Order( child );
			if ( order < last )
			{
				screen.SortChildren( Order );
				return;
			}

			last = order;
		}
	}

	/// <summary>
	/// Resize along one axis. <paramref name="direction"/> is 1 to move the far edge, -1 to move the near edge, 0 to leave both.
	/// The moved edge snaps to <paramref name="snapLines"/> if given, stays inside 0..<paramref name="bound"/> and the size
	/// stays at least <paramref name="min"/>.
	/// </summary>
	(float Position, float Size) ResizeAxis( float direction, float delta, float position, float size, float min, float bound, List<float> snapLines = null )
	{
		if ( direction > 0 )
		{
			var edge = position + size + delta;
			edge += SnapOffset( edge, edge, snapLines );
			return (position, Clamp( edge - position, min, bound - position ));
		}

		if ( direction < 0 )
		{
			var far = position + size;
			var edge = position + delta;
			edge += SnapOffset( edge, edge, snapLines );
			var near = Clamp( edge, 0f, far - min );
			return (near, far - near);
		}

		return (position, size);
	}

	/// <summary>
	/// How close, in panel pixels, a dragged window's edge has to get to an edge to snap to it. The player's choice, see
	/// <see cref="NaviComputer.SnapDistance"/>.
	/// </summary>
	float SnapDistance => Computer.SnapDistance;

	/// <summary>
	/// The positions along one axis that a dragged window's edges snap to: the screen's edges and the edges of the other
	/// windows, as far as the player has those turned on. <paramref name="horizontal"/> picks the x axis. A window only
	/// counts if it is within <see cref="SnapDistance"/> of the dragged one on the other axis, from <paramref name="from"/>
	/// to <paramref name="to"/>.
	/// </summary>
	List<float> SnapLines( Panel screen, bool horizontal, float from, float to )
	{
		var bounds = screen.Box.Rect.Size * screen.ScaleFromScreen;
		var lines = new List<float>();

		if ( Computer.SnapToScreenEdges )
		{
			lines.Add( 0f );
			lines.Add( horizontal ? bounds.x : bounds.y );
		}

		if ( !Computer.SnapToWindows )
			return lines;

		foreach ( var panel in screen.Children.Where( x => x.HasClass( "window" ) ) )
		{
			var other = panel.Children.OfType<NaviAppHost>().FirstOrDefault()?.Window;
			if ( other is null || other == dragging || other.IsMaximized || other.IsMinimized || panel.Style.Left is null )
				continue;

			var position = other.Position;
			var size = other.Size ?? panel.Box.Rect.Size * panel.ScaleFromScreen;
			var (near, far) = horizontal ? (position.x, position.x + size.x) : (position.y, position.y + size.y);
			var (acrossNear, acrossFar) = horizontal ? (position.y, position.y + size.y) : (position.x, position.x + size.x);

			if ( acrossFar + SnapDistance < from || acrossNear - SnapDistance > to )
				continue;

			lines.Add( near );
			lines.Add( far );
		}

		return lines;
	}

	/// <summary>
	/// How far to move a window spanning <paramref name="near"/> to <paramref name="far"/> so that the closest of its edges
	/// lands on one of <paramref name="lines"/>. Zero if none is within <see cref="SnapDistance"/>.
	/// </summary>
	float SnapOffset( float near, float far, List<float> lines )
	{
		if ( lines is null )
			return 0f;

		var best = 0f;
		var bestDistance = SnapDistance;

		foreach ( var line in lines )
		{
			foreach ( var offset in new[] { line - near, line - far } )
			{
				if ( System.MathF.Abs( offset ) >= bestDistance )
					continue;

				best = offset;
				bestDistance = System.MathF.Abs( offset );
			}
		}

		return best;
	}

	/// <summary>
	/// Resize from the dragged corner, keeping the window's content at <paramref name="ratio"/>, width over height. The
	/// content follows whichever edge the mouse pulled further, and the opposite corner stays where it is. The window
	/// stays inside the screen and at least <see cref="MinWindowSize"/>.
	/// </summary>
	(Vector2 Position, Vector2 Size) ResizeKeepingRatio( Vector2 delta, Vector2 bounds, float ratio )
	{
		var content = dragStartSize + delta * dragDirection - dragChrome;
		var width = System.MathF.Max( content.x, content.y * ratio );

		// The room from the corner that stays to the edges of the screen the dragged corner moves towards.
		var far = dragStartPosition + dragStartSize;
		var room = new Vector2(
			dragDirection.x > 0 ? bounds.x - dragStartPosition.x : far.x,
			dragDirection.y > 0 ? bounds.y - dragStartPosition.y : far.y );

		var size = FitRatio( width, ratio, dragChrome, MinWindowSize, room );
		var position = new Vector2(
			dragDirection.x < 0 ? far.x - size.x : dragStartPosition.x,
			dragDirection.y < 0 ? far.y - size.y : dragStartPosition.y );

		return (position, size);
	}

	/// <summary>
	/// The size of a window whose content is <paramref name="width"/> wide and <paramref name="ratio"/> (width over height)
	/// in shape, plus <paramref name="chrome"/>. Grown to at least <paramref name="min"/>, then shrunk to fit in
	/// <paramref name="max"/>, which wins: a window can't keep its shape outside the screen.
	/// </summary>
	static Vector2 FitRatio( float width, float ratio, Vector2 chrome, Vector2 min, Vector2 max )
	{
		width = System.MathF.Max( width, System.MathF.Max( min.x - chrome.x, (min.y - chrome.y) * ratio ) );
		width = System.MathF.Min( width, System.MathF.Min( max.x - chrome.x, (max.y - chrome.y) * ratio ) );
		width = System.MathF.Max( width, 1f );
		return new Vector2( width, width / ratio ) + chrome;
	}

	/// <summary>
	/// The window's title bar and borders, in panel pixels: its size less its content's. Null until it has been laid out.
	/// </summary>
	static Vector2? Chrome( Panel window )
	{
		var body = window.Children.OfType<NaviAppHost>().FirstOrDefault();
		if ( body is null || body.Box.Rect.Width <= 0f )
			return null;

		return (window.Box.Rect.Size - body.Box.Rect.Size) * window.ScaleFromScreen;
	}

	/// <summary>
	/// Clamp that returns <paramref name="min"/> when the range is empty, instead of throwing.
	/// </summary>
	static float Clamp( float value, float min, float max ) => System.MathF.Max( min, System.MathF.Min( value, max ) );

	/// <summary>
	/// Mouse position relative to the panel's top left, in panel pixels.
	/// </summary>
	static Vector2 MousePosition( Panel panel ) => panel.MousePosition * panel.ScaleFromScreen;

	/// <summary>
	/// Hide the icons that don't fit between the start button and the taskbar's right edge.
	/// Measured from the start button and the first icon, so hiding icons doesn't change the result.
	/// </summary>
	void CapTaskbar( Panel taskbar )
	{
		var start = taskbar.Children.FirstOrDefault( x => x.HasClass( "start" ) );
		if ( start is null )
			return;

		var apps = taskbar.Children.Where( x => x.HasClass( "app" ) ).ToList();
		if ( apps.Count == 0 )
			return;

		var first = apps[0].Box.Rect;
		var slotWidth = first.Right - start.Box.Rect.Right;

		// The tray takes the right end, and a gap before it like the one between icons.
		var tray = taskbar.Children.FirstOrDefault( x => x.HasClass( "tray" ) );
		var right = tray is not null && tray.Children.Any() ? tray.Box.Rect.Left - (slotWidth - first.Width) : taskbar.Box.RectInner.Right;
		var available = right - start.Box.Rect.Right;
		var capacity = slotWidth > 0 ? System.Math.Max( 1, (int)(available / slotWidth) ) : apps.Count;

		for ( var i = 0; i < apps.Count; i++ )
		{
			apps[i].Style.Display = i < capacity ? DisplayMode.Flex : DisplayMode.None;
		}
	}

	/// <summary>
	/// Centre each tooltip over its icon, then shift it sideways so it stays inside the screen.
	/// </summary>
	void ClampTooltips( Panel taskbar )
	{
		var bounds = Panel.Box.Rect;

		foreach ( var app in taskbar.Children.Where( x => x.HasClass( "app" ) ) )
		{
			var tooltip = app.Children.FirstOrDefault( x => x.HasClass( "tooltip" ) );
			if ( tooltip is null )
				continue;

			var appRect = app.Box.Rect;
			var width = tooltip.Box.Rect.Width;
			var margin = TooltipEdgeMargin * app.ScaleToScreen;

			var x = appRect.Left + (appRect.Width - width) * 0.5f;
			x = System.MathF.Min( x, bounds.Right - margin - width );
			x = System.MathF.Max( x, bounds.Left + margin );

			tooltip.Style.Left = Length.Pixels( (x - appRect.Left) * app.ScaleFromScreen );
		}
	}

	// InstalledApps can also be edited in the inspector, which doesn't bump Version.
	/// <summary>
	/// What the tray's clock shows. Read in <see cref="BuildHash"/>, so the taskbar redraws when the minute changes.
	/// </summary>
	string clockText = "";

	protected override int BuildHash()
	{
		clockText = NaviClock.Text;

		return System.HashCode.Combine( Computer?.Version, Computer?.InstalledApps?.Count, (MenuApp, TrayMenuApp, StartOpen), Computer?.CanUse, Computer?.UserId,
			Computer?.IsSeated, Computer?.ThemeClasses, (NotificationsOpen, NotificationMenu, toastsHash, clockText, Computer?.IsOnline, Computer?.LocalTitleVersion) );
	}
}
